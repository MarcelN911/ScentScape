---
/*
 * Das eigentliche PDF des Catálogo Digital: Deckblatt und Seiten mit je 4 Fragancias untereinander.
 * Die Auswahl steht im Link (?coleccion=dama&precios=no&para=Ana). "Guardar como PDF" öffnet den Druckdialog.
 */
import CatalogCover from '../../components/catalogo/CatalogCover.astro';
import CatalogSheet from '../../components/catalogo/CatalogSheet.astro';
import CatalogSheetItem from '../../components/catalogo/CatalogSheetItem.astro';
import { CATALOG_COLLECTIONS } from '../../data/catalog.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCatalog } from '../../scripts/catalog/load.js';
import { pdfPageEntryOf } from '../../scripts/catalog/pdf-entry.js';

const entries = (await getCatalog()).map(pdfPageEntryOf);
const first = CATALOG_COLLECTIONS[0];
---

<BaseLayout
  title="Catálogo ScentScape · PDF"
  description="Catálogo ScentScape en PDF, con fotos y precios."
  noindex
  bare
>
  <main class="pdf" data-pdf-page>
    <div class="pdf__bar">
      <a href="/catalogo/">← Catálogo Digital</a>
      <button class="submit-btn" type="button" data-pdf-print>
        Guardar como PDF
      </button>
    </div>
    <div class="pdf__pages" data-pdf-pages>
      <section class="pdf__page">
        <CatalogCover collection={first.title} count={entries.length} />
      </section>
    </div>
    <template data-pdf-sheet>
      <section class="pdf__page">
        <CatalogSheet title={first.sections[0].title} full />
      </section>
    </template>
    <div hidden data-pdf-pool>
      {entries.map((entry) => (
        <CatalogSheetItem entry={entry} />
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  @page {
    size: A4;
    margin: 0;
  }

  .pdf {
    min-height: 100vh;
    padding-bottom: 60px;
    background: var(--navy-deep);
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }

  .pdf__bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px var(--gutter);
    background: rgb(var(--navy-rgb) / 0.92);
    backdrop-filter: blur(10px);
  }

  .pdf__bar a {
    font: 400 11px var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .pdf__bar .submit-btn {
    height: 46px;
    padding: 0 24px;
  }

  .pdf__pages {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding: 28px 16px 0;
  }

  .pdf__page {
    width: min(100%, 640px);
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.45);
  }

  @media print {
    .pdf {
      padding: 0;
      background: none;
    }

    .pdf__bar {
      display: none;
    }

    .pdf__pages {
      display: block;
      padding: 0;
    }

    .pdf__page {
      width: 210mm;
      height: 297mm;
      overflow: hidden;
      box-shadow: none;
      break-after: page;
    }

    .pdf__page:last-child {
      break-after: auto;
    }

    .pdf__page :global(.cover),
    .pdf__page :global(.sheet) {
      height: 100%;
      border-radius: 0;
    }
  }
</style>

<script>
  import { onPage } from '../../scripts/core/lifecycle.js';
  import { initPdfPage } from '../../scripts/features/catalogo/pdf.js';

  onPage(initPdfPage);
</script>
