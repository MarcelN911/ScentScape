---
import PageIntro from '../../components/page/PageIntro.astro';
import SplitPage from '../../components/page/SplitPage.astro';
import { CATALOG_COLLECTIONS, CATALOG_TITLE } from '../../data/catalog.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogForm from '../../sections/catalogo/CatalogForm.astro';
import CatalogStage from '../../sections/catalogo/CatalogStage.astro';
import { getCatalog } from '../../scripts/catalog/load.js';
import { countByCollection, pdfEntryOf } from '../../scripts/catalog/pdf-entry.js';
import { pagesOf } from '../../scripts/features/catalogo/state.js';

const entries = (await getCatalog()).map(pdfEntryOf);
const counts = countByCollection(entries, CATALOG_COLLECTIONS);
const pages = pagesOf(entries.length);
---

<BaseLayout
  title="Catálogo Digital | Tu catálogo en PDF · ScentScape"
  description="Elige la colección y personaliza la portada. Generamos un PDF con fotos y precios, listo para compartir por WhatsApp."
  curtainX="47.619%"
>
  <main data-catalog-page>
    <SplitPage word="Catálogo · Catálogo ·" glow="rgb(83 16 25 / .5)">
      <CatalogStage slot="stage" entries={entries} pages={pages} />
      <PageIntro
        crumb="Catálogo Digital"
        eyebrow="Servicio 03 · Catálogo Digital"
        title={CATALOG_TITLE}
        label="Tu catálogo, en PDF."
        lead="Elige la colección y personaliza la portada. Generamos un PDF con fotos, notas y precios, listo para compartir por WhatsApp."
      />
      <CatalogForm counts={counts} pages={pages} />
    </SplitPage>
    <script type="application/json" data-catalog-data set:html={JSON.stringify(entries)} />
  </main>
</BaseLayout>

<script>
  import { onPage } from '../../scripts/core/lifecycle.js';
  import { initCatalogPage } from '../../scripts/features/catalogo/page.js';

  onPage(initCatalogPage);
</script>
