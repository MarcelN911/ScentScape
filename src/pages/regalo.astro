---
/*
 * Seite "Regalo": hier öffnet die beschenkte Person ihre Gift Card.
 * Die Angaben stehen im Link (siehe data/regalo.js). Ohne Link zeigt die Seite ein Beispiel.
 */
import { REGALO_EXAMPLE } from '../data/regalo.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import RegaloInfo from '../sections/regalo/RegaloInfo.astro';
import RegaloStage from '../sections/regalo/RegaloStage.astro';
---

<BaseLayout
  title="Un regalo para ti · ScentScape"
  description="Alguien te regaló una gift card de ScentScape. Ábrela y elige tu perfume."
  header={false}
  footer={false}
  noindex
>
  <!-- Video-Modus sofort beim Laden setzen, damit der Musik-Player nicht einmal kurz aufblitzt -->
  <script is:inline>
    if (new URLSearchParams(location.search).has('video')) {
      document.documentElement.classList.add('is-video');
    }
  </script>
  <main class="regalo" data-regalo-page>
    <div class="regalo__glow" aria-hidden="true"></div>
    <div class="regalo__word" aria-hidden="true">
      Para ti · Para ti · Para ti ·
    </div>
    <a class="regalo__logo" href="/" aria-label="ScentScape">
      <img src="/assets/img/scentscape-logo.png" alt="ScentScape Parfums" />
    </a>
    <div class="regalo__grid">
      <RegaloStage gift={REGALO_EXAMPLE} />
      <RegaloInfo gift={REGALO_EXAMPLE} />
    </div>
    <button
      class="regalo__replay"
      type="button"
      aria-label="Ver la apertura de nuevo"
      title="Ver la apertura de nuevo"
      data-regalo-replay
    >
      ↺
    </button>
  </main>
</BaseLayout>

<style>
  .regalo {
    --glow: rgb(83 16 25 / 0.6);
    --gift-bg: var(--wine);
    position: relative;
    background: var(--navy);
  }

  .regalo__glow {
    position: fixed;
    top: 50%;
    left: 50%;
    width: 80vw;
    height: 110vh;
    background: radial-gradient(closest-side, var(--glow), transparent);
    opacity: 0.7;
    transform: translate(-50%, -50%);
    transition:
      left 1.6s cubic-bezier(0.65, 0, 0.25, 1),
      opacity 1.6s,
      background 1.2s;
    pointer-events: none;
  }

  .regalo__word {
    position: fixed;
    left: 0;
    bottom: 2vh;
    color: transparent;
    font: italic 400 clamp(140px, 16vw, 300px) / 1 var(--font-serif);
    white-space: nowrap;
    -webkit-text-stroke: 1px rgb(var(--peach-rgb) / 0.1);
    transform: translateX(4vw);
    transition: transform 3s var(--ease);
    pointer-events: none;
  }

  .regalo__logo {
    position: fixed;
    top: 28px;
    left: 50%;
    z-index: 50;
    opacity: 0.9;
    transform: translateX(-50%);
  }

  .regalo__logo img {
    display: block;
    height: 24px;
  }

  .regalo__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    height: 100vh;
    min-height: 100vh;
    overflow: hidden;
  }

  .regalo__replay {
    position: fixed;
    left: 22px;
    bottom: 22px;
    z-index: 80;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(var(--peach-rgb) / 0.3);
    border-radius: 22px;
    background: rgb(var(--navy-deep-rgb) / 0.92);
    backdrop-filter: blur(12px);
    color: var(--sand);
    font: 400 17px var(--font-sans);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.8s 1.2s,
      background-color 0.3s;
  }

  .regalo__replay:hover {
    background: rgb(var(--peach-rgb) / 0.15);
  }

  .regalo:global(.is-in) .regalo__word {
    transform: translateX(-6vw);
  }

  .regalo:global(.is-p3) .regalo__glow {
    opacity: 1;
  }

  .regalo:global(.is-p5) .regalo__word {
    transform: translateX(-24vw);
  }

  .regalo:global(.is-p5) .regalo__grid {
    height: auto;
    overflow: visible;
  }

  .regalo:global(.is-p5) .regalo__replay {
    opacity: 1;
    pointer-events: auto;
  }

  /* Handy und Tablet hochkant: "Nochmal ansehen" oben links neben dem Logo, nicht über dem Text */
  @media (max-width: 899px) {
    .regalo__grid {
      height: 100svh;
      min-height: 100svh;
    }

    .regalo__replay {
      top: max(16px, env(safe-area-inset-top));
      left: 16px;
      bottom: auto;
      width: 40px;
      height: 40px;
    }
  }

  @media (min-width: 900px) {
    .regalo__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .regalo:global(.is-p5) .regalo__glow {
      left: 25%;
    }
  }

  /* Video-Modus (/regalo/?video, scripts/features/regalo/video.js): nichts außer der Animation */
  :global(html.is-video),
  :global(html.is-video *) {
    cursor: none !important;
  }

  :global(html.is-video [data-player]),
  :global(html.is-video [data-regalo-replay]) {
    display: none !important;
  }
</style>

<script>
  import { onPage } from '../scripts/core/lifecycle.js';
  import { initRegaloPage } from '../scripts/features/regalo/page.js';

  onPage(initRegaloPage);
</script>
