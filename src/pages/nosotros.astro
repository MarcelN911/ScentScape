---
import FilmCard from '../components/about/FilmCard.astro';
import PageIntro from '../components/page/PageIntro.astro';
import SplitPage from '../components/page/SplitPage.astro';
import { ABOUT_TITLE } from '../data/about.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutStory from '../sections/about/AboutStory.astro';
---

<BaseLayout
  title="Nosotros | Quiénes somos · ScentScape"
  description="ScentScape nace en Medellín en 2024: perfumes que representan elegancia, carácter y distinción, con una atención cercana y personalizada."
  curtainX="47.619%"
>
  <main data-intro-page>
    <SplitPage word="Medellín · Medellín ·" glow="rgb(83 16 25 / .5)" gap="56px">
      <FilmCard slot="stage" />
      <PageIntro
        crumb="Nosotros"
        eyebrow="ScentScape · Medellín, Colombia"
        title={ABOUT_TITLE}
        label="Quiénes Somos"
        size="clamp(48px, 5.6vw, 100px)"
      />
      <AboutStory />
    </SplitPage>
  </main>
</BaseLayout>

<script>
  import { onPage } from '../scripts/core/lifecycle.js';
  import { initIntroPage } from '../scripts/features/intro-page.js';

  onPage(initIntroPage);
</script>
