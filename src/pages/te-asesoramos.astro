---
import ContactList from '../components/chat/ContactList.astro';
import PhoneMock from '../components/chat/PhoneMock.astro';
import FaqList from '../components/faq/FaqList.astro';
import PageIntro from '../components/page/PageIntro.astro';
import SplitPage from '../components/page/SplitPage.astro';
import WhatsAppIcon from '../components/ui/WhatsAppIcon.astro';
import { FAQ_GREETING, FAQ_QUESTIONS } from '../data/faq.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import { INSTAGRAM_HANDLE, INSTAGRAM_URL, WHATSAPP_NUMBER } from '../scripts/config.js';

const questions = FAQ_QUESTIONS.map(({ question, answer }) => ({ question, answer }));
---

<BaseLayout
  title="Te asesoramos | Preguntas frecuentes · ScentScape"
  description="Envíos, cómo elegir tu perfume y cómo encontrarnos. Si tu pregunta no está aquí, Sara y Brayan te responden por WhatsApp."
>
  <main data-faq-page>
    <SplitPage
      word="Preguntas · Preguntas ·"
      glow="rgb(83 16 25 / .55)"
      ratio="minmax(0, 1.25fr) minmax(0, 1fr)"
      stageGap="22px"
    >
      <div class="faq-stage reveal-late" slot="stage" style="--late:0.5s">
        <div class="faq-stage__aside">
          <p>¿Tu pregunta no está en la lista? Escríbenos directamente.</p>
          <ContactList size="lg" bordered={false} />
        </div>
        <PhoneMock
          greeting={FAQ_GREETING}
          input="field"
          suggestions={FAQ_QUESTIONS.map((item) => item.question)}
        />
      </div>
      <PageIntro
        crumb="Te asesoramos"
        parent={{ label: 'Servicios', href: '/servicios/' }}
        eyebrow="Preguntas frecuentes"
        title={[
          ['Te ', false],
          ['asesoramos', true],
        ]}
        label="Te asesoramos"
        size="clamp(48px, 5.4vw, 92px)"
        lead="Envíos, cómo elegir tu perfume y cómo encontrarnos. Si tu pregunta no está aquí, Sara y Brayan te responden en persona por WhatsApp."
      />
      <FaqList />
      <!-- Nur Handy: unter dem Handy statt der Kontaktliste daneben -->
      <div class="faq-help reveal-late" style="--late:1.3s">
        <p class="faq-help__title">¿Tu pregunta no está en la lista?</p>
        <p class="faq-help__text">Sara y Brayan te responden en persona.</p>
        <a
          class="faq-help__wa"
          href={`https://wa.me/${WHATSAPP_NUMBER}`}
          target="_blank"
          rel="noopener"
        >
          <WhatsAppIcon size={18} color="var(--navy)" />
          Escríbenos por WhatsApp
        </a>
        <a class="faq-help__ig" href={INSTAGRAM_URL} target="_blank" rel="noopener">
          Instagram · {INSTAGRAM_HANDLE}
        </a>
      </div>
    </SplitPage>
    <script type="application/json" data-chat-data set:html={JSON.stringify(questions)} />
  </main>
</BaseLayout>

<style>
  .faq-stage {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    flex-direction: row-reverse;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 3vw, 56px);
    max-width: 100%;
    --phone-height: min(760px, calc(100vh - 100px), 180vw);
    --phone-min: 0px;
  }

  .faq-stage__aside {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 22px;
    order: 1;
    width: clamp(160px, 15vw, 220px);
    min-width: 0;
  }

  .faq-stage__aside p {
    margin: 0;
    padding-bottom: 22px;
    border-bottom: 1px solid rgb(var(--peach-rgb) / 0.22);
    color: rgb(var(--cream-rgb) / 0.75);
    font: 300 14px/1.6 var(--font-sans);
  }

  .faq-help {
    display: none;
  }

  /*
   * Handy: Fragenliste und Handy passen nicht nebeneinander. Das Handy bleibt (kleiner),
   * die Fragen stehen im Chat als Vorschläge über dem Eingabefeld (PhoneMock suggestions).
   * Darunter die Karte zum Schreiben statt der Kontaktliste neben dem Handy.
   */
  @media (max-width: 899px) {
    /*
     * Höhe 82 % des Bildschirms; Verhältnis 9:18,2 statt 9:19 (iPhone), damit es nicht gequetscht wirkt.
     * Breite = Höhe × 9 / 18,2. Die Obergrenze 170vw hält es schmaler als den Bildschirm.
     */
    .faq-stage {
      --phone-height: min(82svh, 170vw);
      --phone-ratio: 9 / 18.2;
    }

    .faq-stage__aside,
    :global([data-faq-page] .faq-label),
    :global([data-faq-page] .faq-list) {
      display: none;
    }

    .faq-help {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 28px 22px;
      border: 1px solid rgb(var(--peach-rgb) / 0.22);
      border-radius: 24px;
      background: rgb(var(--navy-card-rgb) / 0.45);
      text-align: center;
    }

    .faq-help__title {
      margin: 0;
      color: var(--cream);
      font: 400 23px/1.2 var(--font-serif);
    }

    .faq-help__text {
      margin: 0 0 8px;
      color: rgb(var(--cream-rgb) / 0.7);
      font: 300 14px/1.6 var(--font-sans);
    }

    .faq-help__wa {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      height: 52px;
      border-radius: 26px;
      background: var(--whatsapp);
      color: var(--navy);
      font: 500 11px var(--font-sans);
      letter-spacing: 2.5px;
      text-transform: uppercase;
    }

    .faq-help__ig {
      margin-top: 6px;
      color: var(--sand);
      font: 400 12px var(--font-sans);
      letter-spacing: 1px;
    }
  }

  @media (min-width: 1200px) {
    .faq-stage__aside {
      order: 0;
    }

    .faq-stage {
      flex-wrap: nowrap;
      --phone-height: min(900px, calc(100vh - 70px), calc((55vw - 370px) * 2.1));
    }
  }
</style>

<script>
  import { onPage } from '../scripts/core/lifecycle.js';
  import { initFaqPage } from '../scripts/features/faq/index.js';

  onPage(initFaqPage);
</script>
