---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCatalog } from '../../scripts/catalog/load.js';
import FamilyTabs from '../../sections/shop/FamilyTabs.astro';
import ListPreview from '../../sections/shop/ListPreview.astro';
import NoteRibbon from '../../sections/shop/NoteRibbon.astro';
import ShopHero from '../../sections/shop/ShopHero.astro';
import ShopResults from '../../sections/shop/ShopResults.astro';
import ShopToolbar from '../../sections/shop/ShopToolbar.astro';

const catalog = await getCatalog();
---

<BaseLayout
  title="Perfumes originales | ScentScape · Medellín"
  description={`Catálogo de ${catalog.length} fragancias para dama, caballero y unisex. Busca por nombre o nota. Envíos a todo Colombia.`}
>
  <main class="shop" data-shop>
    <ShopHero catalog={catalog} />
    <NoteRibbon />
    <section class="container shop__catalog">
      <FamilyTabs catalog={catalog} />
      <ShopToolbar total={catalog.length} />
      <ShopResults catalog={catalog} />
    </section>
    <ListPreview />
  </main>
</BaseLayout>

<style>
  .shop {
    position: relative;
    min-height: 100vh;
    overflow: clip;
    background:
      radial-gradient(ellipse 60% 40% at 85% 0%, rgb(97 3 27 / 0.55), transparent 70%), var(--navy);
  }

  .shop__catalog {
    padding-top: 28px;
    padding-bottom: 110px;
  }
</style>

<script>
  import { onPage } from '../../scripts/core/lifecycle.js';
  import { initShop } from '../../scripts/features/shop/index.js';

  onPage(initShop);
</script>
