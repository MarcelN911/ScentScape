---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCatalog } from '../../scripts/catalog/load.js';
import { getNoteImages } from '../../scripts/catalog/note-images.js';
import { shopEntryOf } from '../../scripts/catalog/shop-entry.js';
import MobileShopBar from '../../components/shop/MobileShopBar.astro';
import ProfilePanel from '../../sections/shop/ProfilePanel.astro';
import ShopResults from '../../sections/shop/ShopResults.astro';

const catalog = await getCatalog();
const images = await getNoteImages();
const entries = catalog.map(shopEntryOf);
---

<BaseLayout
  title="Perfumes originales | ScentScape · Medellín"
  description={`Catálogo de ${catalog.length} fragancias para dama, caballero y unisex. Busca por familia, nota o nombre. Envíos a todo Colombia.`}
>
  <main class="shop" data-shop>
    <div class="shop__glow" aria-hidden="true"></div>
    <div class="shop__inner">
      <div class="shop__head">
        <div>
          <p class="shop__eyebrow">
            <span></span>Colección 2026
          </p>
          <h1 class="shop__title">
            <span class="shop__mask">
              <span>Nuestros</span>
            </span>
            <span class="shop__mask">
              <span class="shop__accent">Productos</span>
            </span>
          </h1>
        </div>
        <p class="shop__tagline">Distinción sin límites</p>
      </div>
      <ProfilePanel images={images} />
      <MobileShopBar />
      <ShopResults entries={entries} />
    </div>
    <script type="application/json" data-shop-data set:html={JSON.stringify({ entries, images })} />
  </main>
</BaseLayout>

<style>
  .shop {
    --shop-glow: rgb(var(--wine-rgb) / 0.35);
    position: relative;
    min-height: 100vh;
    padding: 112px clamp(16px, 3.6vw, 56px) 14vh;
    overflow-x: clip;
    background: var(--navy);
  }

  .shop__glow {
    position: absolute;
    left: -10%;
    top: 0;
    width: 70vw;
    height: 90vh;
    background: radial-gradient(ellipse at 30% 40%, var(--shop-glow), transparent 65%);
    transition: background 1.2s ease;
    pointer-events: none;
  }

  .shop__inner {
    position: relative;
    max-width: 1560px;
    margin: 0 auto;
  }

  .shop__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 28px;
  }

  .shop__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 12px;
    color: var(--peach);
    font: 400 10px var(--font-sans);
    letter-spacing: 5px;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.9s 0.2s;
  }

  .shop__eyebrow span {
    display: block;
    width: 0;
    height: 1px;
    background: var(--peach);
    transition: width 1s var(--ease) 0.2s;
  }

  .shop__title {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.25em;
    margin: 0;
    font: 400 clamp(40px, 5.2vw, 84px) / 1 var(--font-serif);
  }

  .shop__mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .shop__mask > span {
    display: block;
    transform: translateY(110%);
    transition: transform 1.1s var(--ease) 0.25s;
  }

  .shop__mask + .shop__mask > span {
    transition-delay: 0.38s;
  }

  .shop__accent {
    color: var(--peach);
    font-style: italic;
  }

  .shop__tagline {
    margin: 0;
    color: rgb(var(--cream-rgb) / 0.8);
    font: italic 400 clamp(17px, 1.4vw, 22px) var(--font-serif);
    opacity: 0;
    transition: opacity 0.9s 0.6s;
  }

  .shop.is-in .shop__eyebrow,
  .shop.is-in .shop__tagline {
    opacity: 1;
  }

  .shop.is-in .shop__eyebrow span {
    width: 40px;
  }

  .shop.is-in .shop__mask > span {
    transform: none;
  }
</style>

<script>
  import { onPage } from '../../scripts/core/lifecycle.js';
  import { initShop } from '../../scripts/features/shop/index.js';

  onPage(initShop);
</script>
