---
import PageIntro from '../components/page/PageIntro.astro';
import SplitPage from '../components/page/SplitPage.astro';
import { GIFT_COLORS, GIFT_TITLE } from '../data/gift-card.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import GiftForm from '../sections/gift/GiftForm.astro';
import GiftStage from '../sections/gift/GiftStage.astro';
---

<BaseLayout
  title="Gift Card | Regala un aroma · ScentScape"
  description="Regala un aroma: una gift card con el monto que elijas. Quien la recibe elige su perfume en la tienda."
  curtainX="47.619%"
>
  <main data-gift-page>
    <SplitPage word="Gift Card · Gift Card ·" glow={GIFT_COLORS[0].glow}>
      <GiftStage slot="stage" />
      <PageIntro
        crumb="Gift Card"
        eyebrow="Tarjeta regalo"
        title={GIFT_TITLE}
        label="Regala un aroma."
        lead="Quien la recibe elige su perfume en la tienda, en cualquier fragancia o tamaño. Válida por 12 meses."
      />
      <GiftForm />
    </SplitPage>
  </main>
</BaseLayout>

<script>
  import { onPage } from '../scripts/core/lifecycle.js';
  import { initGiftPage } from '../scripts/features/gift/page.js';

  onPage(initGiftPage);
</script>
