---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCatalog, getReviews } from '../scripts/catalog/load.js';
import { reviewEntryOf, reviewProductOf } from '../scripts/catalog/review-entry.js';
import ReviewsWall from '../sections/reviews/ReviewsWall.astro';
import WriteReview from '../sections/reviews/WriteReview.astro';

const reviews = await getReviews();
const data = {
  reviews: reviews.map(reviewEntryOf),
  products: (await getCatalog()).map(reviewProductOf),
};
---

<BaseLayout
  title="Reseñas | Opiniones de clientes · ScentScape"
  description="Opiniones de clientes de ScentScape en toda Colombia. Cuéntanos tu experiencia y califica tu fragancia."
  curtainX="47.619%"
>
  <main data-reviews-page>
    <ReviewsWall reviews={reviews} />
    <WriteReview />
    <script type="application/json" data-reviews-data set:html={JSON.stringify(data)} />
  </main>
</BaseLayout>

<script>
  import { onPage } from '../scripts/core/lifecycle.js';
  import { initReviewsPage } from '../scripts/features/reviews/index.js';

  onPage(initReviewsPage);
</script>
