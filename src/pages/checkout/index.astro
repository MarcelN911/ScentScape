---
import CheckoutStep from '../../components/checkout/CheckoutStep.astro';
import { CHECKOUT_STEPS } from '../../data/checkout.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CheckoutDone from '../../sections/checkout/CheckoutDone.astro';
import CheckoutForm from '../../sections/checkout/CheckoutForm.astro';
import CheckoutSummary from '../../sections/checkout/CheckoutSummary.astro';
---

<BaseLayout
  title="Finalizar pedido | ScentScape"
  description="Completa tus datos de envío y confirma tu pedido."
  noindex
>
  <main class="container checkout" data-checkout>
    <a class="checkout__back" href="/productos/" data-action="open-cart">
      ← Volver al carrito
    </a>
    <div class="checkout__head">
      <h1 class="checkout__title">
        Finalizar <em>pedido</em>
      </h1>
      <div class="checkout__steps">
        {CHECKOUT_STEPS.map((step, index) => (
          <CheckoutStep step={step} index={index} />
        ))}
      </div>
    </div>
    <div class="checkout__grid" data-checkout-main>
      <CheckoutForm />
      <CheckoutSummary />
    </div>
    <CheckoutDone />
  </main>
</BaseLayout>

<style>
  .checkout {
    max-width: 1240px;
    padding-top: clamp(120px, 12vw, 160px);
    padding-bottom: clamp(80px, 9vw, 120px);
  }

  .checkout__back {
    display: inline-flex;
    margin-bottom: 24px;
    font: 600 13px/1 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.7);
  }

  .checkout__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .checkout__title {
    margin: 0;
    font: 500 clamp(48px, 6vw, 96px) / 0.92 var(--font-serif);
    letter-spacing: -0.015em;
  }

  .checkout__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--peach);
  }

  .checkout__steps {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .checkout__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
</style>

<script>
  import { onPage } from '../../scripts/core/lifecycle.js';
  import { initCheckout } from '../../scripts/checkout/index.js';

  onPage(initCheckout);
</script>
