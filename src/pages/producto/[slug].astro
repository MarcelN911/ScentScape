---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCatalog, getReviews } from '../../scripts/catalog/load.js';
import { getNoteImages } from '../../scripts/catalog/note-images.js';
import { relatedTo } from '../../scripts/catalog/queries.js';
import { reviewsForProduct } from '../../scripts/catalog/reviews.js';
import { labelOf } from '../../scripts/catalog/theme.js';
import { productSchema } from '../../scripts/seo/product-schema.js';
import { imageUrl } from '../../scripts/utils/image.js';
import ProductBar from '../../components/product/ProductBar.astro';
import ProductInfo from '../../sections/product/ProductInfo.astro';
import ProductReviews from '../../sections/product/ProductReviews.astro';
import ProductStage from '../../sections/product/ProductStage.astro';
import RelatedProducts from '../../sections/product/RelatedProducts.astro';
import AdviceSection from '../../sections/shared/AdviceSection.astro';

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return catalog.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const catalog = await getCatalog();
const images = await getNoteImages();
const reviews = reviewsForProduct(await getReviews(), product);
const related = relatedTo(product, catalog);
const summary = product.plainDescription.slice(0, 150) || `${product.name} en ScentScape.`;
---

<BaseLayout
  title={`${product.name} — ${labelOf(product)} | ScentScape Medellín`}
  description={summary}
  image={imageUrl(product.images[0], 1200)}
>
  <script type="application/ld+json" slot="head" set:html={productSchema(product, reviews)} />
  <main class="product" data-product-page>
    <section class="product__top">
      <ProductStage product={product} images={images} />
      <ProductInfo product={product} reviews={reviews} images={images} />
    </section>
    <ProductReviews product={product} reviews={reviews} />
    <RelatedProducts products={related} />
    <AdviceSection />
    <ProductBar product={product} />
  </main>
</BaseLayout>

<style>
  .product {
    background: var(--navy);
  }

  .product__top {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    min-height: 100vh;
  }

  @media (min-width: 900px) {
    .product__top {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }
</style>

<script>
  import { onPage } from '../../scripts/core/lifecycle.js';
  import { initProductPage } from '../../scripts/features/product/index.js';

  onPage(initProductPage);
</script>
