---
import PageIntro from '../components/page/PageIntro.astro';
import SplitPage from '../components/page/SplitPage.astro';
import { ORIGINAL_TITLE } from '../data/original.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import LotForm from '../sections/original/LotForm.astro';
import OriginalStage from '../sections/original/OriginalStage.astro';
---

<BaseLayout
  title="Original garantizado | Verifica tu perfume · ScentScape"
  description="Cada perfume ScentScape llega sellado de fábrica y con su código de lote. Escríbelo y te confirmamos su origen."
>
  <main data-original-page>
    <SplitPage word="Original · Original ·" glow="rgb(38 44 99 / .55)">
      <OriginalStage slot="stage" />
      <PageIntro
        crumb="Original Garantizado"
        eyebrow="Servicio 04 · Autenticidad"
        title={ORIGINAL_TITLE}
        label="Verifica tu perfume."
        lead="Cada perfume ScentScape llega sellado de fábrica, con su código de lote en la caja. Escríbelo y te confirmamos el origen."
      />
      <LotForm />
    </SplitPage>
  </main>
</BaseLayout>

<script>
  import { onPage } from '../scripts/core/lifecycle.js';
  import { initOriginalPage } from '../scripts/features/original/page.js';

  onPage(initOriginalPage);
</script>
