---
import ChannelCard from '../components/contact/ChannelCard.astro';
import ContactPass from '../components/contact/ContactPass.astro';
import PageIntro from '../components/page/PageIntro.astro';
import SplitPage from '../components/page/SplitPage.astro';
import WineCta from '../components/page/WineCta.astro';
import { CONTACT_CHANNELS, CONTACT_TITLE } from '../data/contact.js';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contacto | WhatsApp, Instagram y correo · ScentScape"
  description="Escríbenos por WhatsApp al +57 321 810 1882, en Instagram o por correo. ScentScape, Medellín, con envíos a todo Colombia."
  curtainX="47.619%"
>
  <main data-intro-page>
    <SplitPage word="Contacto · Contacto ·" glow="rgb(83 16 25 / .5)" gap="56px">
      <ContactPass slot="stage" />
      <PageIntro
        crumb="Contacto"
        eyebrow="ScentScape · Medellín, Colombia"
        title={CONTACT_TITLE}
        label="Contáctanos"
        size="clamp(48px, 5.6vw, 100px)"
      />
      <section class="channels reveal-late" style="--late:1.8s">
        <p class="channels__eyebrow">Canales de contacto</p>
        <h2 class="channels__title">Estamos aquí para ti</h2>
        <p class="channels__lead">
          La forma más rápida de comunicarte con nosotros es por WhatsApp. También puedes
          escribirnos al correo.
        </p>
        <div class="channels__grid">
          {CONTACT_CHANNELS.map((channel) => (
            <ChannelCard channel={channel} />
          ))}
        </div>
      </section>
      <WineCta
        title="¿Listo para hacer tu pedido?"
        text="Escríbenos directamente por WhatsApp. Te asesoramos, confirmamos disponibilidad y coordinamos el envío."
        cta="Iniciar pedido"
      />
    </SplitPage>
  </main>
</BaseLayout>

<style>
  .channels {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .channels__eyebrow {
    margin: 0;
    color: var(--peach);
    font: 400 10px var(--font-sans);
    letter-spacing: 5px;
    text-transform: uppercase;
  }

  .channels__title {
    margin: 0;
    font: 400 clamp(30px, 2.8vw, 46px) / 1.1 var(--font-serif);
    text-wrap: balance;
  }

  .channels__lead {
    max-width: 520px;
    margin: 0;
    color: rgb(var(--cream-rgb) / 0.78);
    font: 300 16px/1.7 var(--font-sans);
    text-wrap: pretty;
  }

  .channels__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(max(260px, calc(50% - 6px)), 1fr));
    gap: 12px;
    padding-top: 10px;
  }
</style>

<script>
  import { onPage } from '../scripts/core/lifecycle.js';
  import { initIntroPage } from '../scripts/features/intro-page.js';

  onPage(initIntroPage);
</script>
