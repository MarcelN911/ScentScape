---
import ContactCard from '../components/pages/ContactCard.astro';
import { CONTACT_CHANNELS } from '../data/contact.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import { whatsappUrl } from '../scripts/utils/whatsapp.js';

const orderUrl = whatsappUrl('Hola ScentScape, quiero hacer un pedido.');
---

<BaseLayout
  title="Contacto | ScentScape · Medellín"
  description="Escríbenos por WhatsApp, Instagram o correo. Te asesoramos, confirmamos disponibilidad y coordinamos el envío."
>
  <main class="contact">
    <section class="contact__hero hatch">
      <div class="contact__inner">
        <p class="eyebrow contact__eyebrow">ScentScape · Medellín, Colombia</p>
        <h1 class="display display--xl">
          Contáct<em>anos</em>
        </h1>
        <p class="contact__lead">
          La forma más rápida de comunicarte con nosotros es por WhatsApp. También puedes
          escribirnos al correo.
        </p>
      </div>
    </section>
    <section class="container contact__channels">
      {CONTACT_CHANNELS.map((channel, index) => (
        <ContactCard channel={channel} index={index} />
      ))}
    </section>
    <section class="container contact__cta">
      <div class="contact__cta-box frame hatch">
        <h2 class="display display--sm">
          ¿Listo para hacer <em>tu pedido?</em>
        </h2>
        <p>
          Escríbenos directamente por WhatsApp. Te asesoramos, confirmamos disponibilidad y
          coordinamos el envío.
        </p>
        <a class="contact__whatsapp" href={orderUrl} target="_blank" rel="noopener">
          <span>
            <img src="/assets/img/whatsapp_white.svg" alt="" width="18" height="18" />
          </span>
          Iniciar pedido
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .contact__hero {
    padding: clamp(130px, 13vw, 180px) var(--gutter) clamp(60px, 7vw, 100px);
    border-bottom: 1px solid rgb(var(--peach-rgb) / 0.15);
  }

  .contact__inner {
    max-width: 1500px;
    margin: 0 auto;
  }

  .contact__eyebrow {
    margin-bottom: 20px;
  }

  .contact__lead {
    max-width: 520px;
    margin: 26px 0 0;
    font: 400 18px/1.6 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.78);
  }

  .contact__channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 16px;
    max-width: 1500px;
    padding-block: clamp(60px, 7vw, 100px) 0;
  }

  .contact__cta {
    max-width: 1500px;
    padding-block: clamp(40px, 5vw, 70px) clamp(80px, 9vw, 130px);
  }

  .contact__cta-box {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding: clamp(28px, 5vw, 64px);
    border-radius: 0;
  }

  .contact__cta-box p {
    max-width: 560px;
    margin: 0;
    font: 400 16px/1.6 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.78);
  }

  .contact__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 58px;
    padding: 0 26px 0 8px;
    border-radius: var(--radius-pill);
    background: var(--whatsapp);
    color: var(--white);
    font: 700 15px/1 var(--font-sans);
    box-shadow: 0 14px 34px rgb(37 211 102 / 0.3);
  }

  .contact__whatsapp:hover {
    color: var(--white);
  }

  .contact__whatsapp span {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgb(14 17 36 / 0.25);
  }
</style>
