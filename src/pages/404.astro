---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada | ScentScape"
  description="La página que buscas no existe o fue movida."
  noindex
>
  <main class="lost" data-intro-page>
    <span class="lost__code" aria-hidden="true">
      404
    </span>
    <div class="lost__content">
      <p class="lost__eyebrow">
        <span></span>Página no encontrada
      </p>
      <h1 class="lost__title">
        <span class="lost__mask">
          <span>La fragancia que buscas</span>
        </span>
        <span class="lost__mask">
          <em>no está aquí.</em>
        </span>
      </h1>
      <p class="lost__text">Puede que la página haya sido movida o ya no exista.</p>
      <div class="lost__actions">
        <a class="submit-btn lost__btn" href="/productos/">
          Ver productos <span>→</span>
        </a>
        <a class="outline-btn lost__btn" href="/">
          Volver al inicio
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .lost {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100vh;
    overflow: hidden;
    padding: 140px var(--gutter) 100px;
    background:
      radial-gradient(ellipse 55% 70% at 75% 50%, rgb(var(--wine-rgb) / 0.5), transparent 70%),
      var(--navy);
  }

  .lost__code {
    position: absolute;
    right: -2vw;
    top: 50%;
    color: transparent;
    font: italic 400 clamp(200px, 34vw, 560px) / 0.8 var(--font-serif);
    letter-spacing: -0.04em;
    -webkit-text-stroke: 1px rgb(var(--peach-rgb) / 0.16);
    transform: translateY(-50%) translateX(6vw);
    transition: transform 2.4s var(--ease);
    pointer-events: none;
  }

  .lost:global(.is-in) .lost__code {
    transform: translateY(-50%);
  }

  .lost__content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 760px;
  }

  .lost__eyebrow,
  .lost__text,
  .lost__actions {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.8s 0.9s,
      transform 1s var(--ease) 0.9s;
  }

  .lost:global(.is-in) .lost__eyebrow,
  .lost:global(.is-in) .lost__text,
  .lost:global(.is-in) .lost__actions {
    opacity: 1;
    transform: none;
  }

  .lost__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    color: var(--peach);
    font: 400 10px var(--font-sans);
    letter-spacing: 5px;
    text-transform: uppercase;
  }

  .lost__eyebrow span {
    width: 40px;
    height: 1px;
    background: var(--peach);
  }

  .lost__title {
    margin: 0;
    font: 400 clamp(48px, 6vw, 100px) / 1 var(--font-serif);
  }

  .lost__mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .lost__mask > * {
    display: block;
    transform: translateY(110%);
    transition: transform 1.1s var(--ease) 0.3s;
  }

  .lost__mask em {
    color: var(--peach);
    transition-delay: 0.45s;
  }

  .lost:global(.is-in) .lost__mask > * {
    transform: none;
  }

  .lost__text {
    max-width: 480px;
    margin: 0;
    color: rgb(var(--cream-rgb) / 0.78);
    font: 300 16px/1.7 var(--font-sans);
  }

  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 10px;
  }

  .lost__btn {
    height: 56px;
    padding: 0 28px;
  }
</style>

<script>
  import { onPage } from '../scripts/core/lifecycle.js';
  import { initIntroPage } from '../scripts/features/intro-page.js';

  onPage(initIntroPage);
</script>
