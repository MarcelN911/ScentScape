---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada | ScentScape"
  description="La página que buscas no existe o fue movida."
  noindex
>
  <main class="not-found hatch">
    <p class="not-found__code" aria-hidden="true">
      404
    </p>
    <div class="not-found__content">
      <p class="eyebrow">Página no encontrada</p>
      <h1 class="display display--lg">
        La fragancia que buscas <em>no está aquí.</em>
      </h1>
      <p class="not-found__text">Puede que la página haya sido movida o ya no exista.</p>
      <div class="not-found__actions">
        <a class="btn btn--primary btn--lg" href="/productos/">
          Ver productos
        </a>
        <a class="btn btn--outline btn--lg" href="/">
          Volver al inicio
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100vh;
    overflow: hidden;
    padding: 140px var(--gutter) 100px;
  }

  .not-found__code {
    position: absolute;
    right: -2vw;
    top: 50%;
    margin: 0;
    font: 500 clamp(200px, 34vw, 560px) / 0.8 var(--font-serif);
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px rgb(var(--peach-rgb) / 0.16);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .not-found__content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 760px;
    margin: 0 auto 0 max(0px, calc((100vw - 1500px) / 2));
  }

  .not-found__text {
    margin: 0;
    font: 400 18px/1.6 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.78);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
