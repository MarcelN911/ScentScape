---
import { ClientRouter } from 'astro:transitions';
import CartDrawer from '../components/cart/CartDrawer.astro';
import AdvisorButton from '../components/layout/AdvisorButton.astro';
import Cursor from '../components/layout/Cursor.astro';
import Curtain from '../components/layout/Curtain.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import ScrollProgress from '../components/layout/ScrollProgress.astro';
import Toast from '../components/layout/Toast.astro';
import '../styles/global.css';

/**
 * @typedef {object} Props
 * @property {string} title
 * @property {string} description
 * @property {string} [image]    Vorschaubild für WhatsApp, Facebook usw.
 * @property {boolean} [noindex] Seite nicht bei Google aufnehmen
 * @property {boolean} [bare]    ohne Navigation und Footer (z. B. Druckversion)
 */

const {
  title,
  description,
  image = '/assets/img/og-banner.png',
  noindex = false,
  bare = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/img/scentscape-favicon.png" />
    <link rel="apple-touch-icon" href="/assets/img/scentscape-favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#151932" />
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter fallback="none" />
  </head>
  <body>
    {!bare && (
      <>
        <ScrollProgress />
        <Header />
        <MobileMenu />
      </>
    )}
    <slot />
    {!bare && (
      <>
        <Footer />
        <AdvisorButton />
        <Toast />
        <CartDrawer />
        <Curtain />
        <Cursor />
      </>
    )}
  </body>
</html>

<script>
  import { onPage } from '../scripts/core/lifecycle.js';
  import { initReveal } from '../scripts/effects/reveal.js';

  onPage(initReveal);
</script>
