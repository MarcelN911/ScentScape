---
import { ClientRouter } from 'astro:transitions';
import CartDrawer from '../components/cart/CartDrawer.astro';
import Curtain from '../components/layout/Curtain.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import MusicPlayer from '../components/layout/MusicPlayer.astro';
import ScrollProgress from '../components/layout/ScrollProgress.astro';
import Toast from '../components/layout/Toast.astro';
import '../styles/global.css';

/**
 * @typedef {object} Props
 * @property {string} title
 * @property {string} description
 * @property {string} [image]    Vorschaubild für WhatsApp, Facebook usw.
 * @property {boolean} [noindex] Seite nicht bei Google aufnehmen
 * @property {boolean} [bare]    ohne Navigation und Footer (z. B. Druckversion)
 * @property {string} [curtainX]  Lage der Lichtlinie im Vorhang ab 900px Breite, z. B. '47.619%'
 * @property {'line' | 'row' | 'none'} [curtainMode] senkrechte Linie, waagerechte Linie oder keine
 * @property {boolean} [footer]  Footer anzeigen (Regalo hat keinen)
 */

const {
  title,
  description,
  image = '/assets/img/og-banner.png',
  noindex = false,
  bare = false,
  curtainX = '50%',
  curtainMode = 'line',
  footer = true,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/assets/img/scentscape-favicon.png" />
    <link rel="apple-touch-icon" href="/assets/img/scentscape-favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#161A32" />
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter fallback="none" />
  </head>
  <body data-curtain-x={curtainX} data-curtain-mode={curtainMode}>
    {!bare && (
      <>
        <ScrollProgress />
        <Header />
        <MobileMenu />
      </>
    )}
    <slot />
    {!bare && footer && <Footer />}
    {!bare && (
      <>
        <Toast />
        <CartDrawer />
        <MusicPlayer />
        <Curtain />
      </>
    )}
  </body>
</html>

<script>
  import { onFirstPage, onPage } from '../scripts/core/lifecycle.js';
  import { initParallax } from '../scripts/effects/parallax.js';
  import { initPointerVars } from '../scripts/effects/pointer-vars.js';
  import { initReveal } from '../scripts/effects/reveal.js';
  import '../scripts/features/wishlist.js';

  onFirstPage(initPointerVars);
  onPage(initReveal);
  onPage(initParallax);
</script>
