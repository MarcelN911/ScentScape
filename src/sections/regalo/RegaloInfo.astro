---
/*
 * Rechte Spalte der Seite "Regalo": Nachricht Wort für Wort, Absender, Code mit QR,
 * Saldo und Gültigkeit, dann "Elegir mi perfume" und Dank per WhatsApp.
 * Erscheint erst, wenn die Karte ganz ausgepackt ist (.is-p5).
 */
import CodePanel from '../../components/regalo/CodePanel.astro';
import InfoRow from '../../components/regalo/InfoRow.astro';
import WhatsAppIcon from '../../components/ui/WhatsAppIcon.astro';
import { formatCOP } from '../../scripts/utils/format.js';

/** @typedef {{ gift: object }} Props */
const { gift } = Astro.props;
---

<div class="regalo-info" aria-hidden="true" data-regalo-info>
  <p class="regalo-info__eyebrow">
    <i></i>
    <span data-regalo-eyebrow>Así llega tu regalo</span>
  </p>
  <div class="regalo-info__head">
    <h1 class="regalo-info__message" aria-label={gift.message} data-regalo-message></h1>
    <span class="regalo-info__from">
      <i></i>
      <span data-regalo-from>{gift.from}</span>
    </span>
  </div>
  <div class="regalo-info__late" style="--late:1.5s">
    <CodePanel />
  </div>
  <div class="regalo-info__late" style="--late:1.7s">
    <InfoRow label="Saldo disponible" value={`${formatCOP(gift.amount)} COP`} hook="balance" />
    <InfoRow label="Válida hasta el" hook="until" />
    <InfoRow label="Úsala" value="online o en tienda" />
  </div>
  <div class="regalo-info__late regalo-info__actions" style="--late:1.9s">
    <a class="regalo-info__cta" href="/productos/" data-regalo-cta>
      Elegir mi perfume <span>→</span>
    </a>
    <a class="regalo-info__wa" href="/gift-card/" target="_blank" rel="noopener" data-regalo-wa>
      <WhatsAppIcon size={16} />
      <span data-regalo-wa-label>Agradecer por WhatsApp</span>
    </a>
    <a class="outline-btn regalo-info__give" href="/gift-card/" hidden data-regalo-give>
      Regalar una Gift Card <span>→</span>
    </a>
  </div>
</div>

<style>
  .regalo-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 34px;
    min-width: 0;
    max-width: 640px;
    padding: 0 24px 14vh;
    pointer-events: none;
  }

  .regalo-info__eyebrow,
  .regalo-info__from {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    color: var(--peach);
    font: 400 10px var(--font-sans);
    letter-spacing: 5px;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.8s 0.2s;
  }

  .regalo-info__eyebrow i {
    width: 0;
    height: 1px;
    background: var(--peach);
    transition: width 1.2s var(--ease) 0.2s;
  }

  .regalo-info__head {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .regalo-info__message {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.26em;
    margin: 0;
    color: var(--sand-light);
    font: italic 400 clamp(36px, 3.5vw, 58px) / 1.14 var(--font-serif);
  }

  .regalo-info__message :global(.word) {
    display: inline-block;
    margin: 0 -0.08em;
    padding: 0 0.08em 0.1em;
    overflow: hidden;
  }

  .regalo-info__message :global(.word span) {
    display: inline-block;
    transform: translateY(115%);
    transition: transform 1.2s var(--ease) var(--d);
  }

  .regalo-info__from {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 4px;
    transition-delay: 1.3s;
  }

  .regalo-info__from i {
    width: 22px;
    height: 1px;
    background: var(--peach);
  }

  .regalo-info__late {
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.9s var(--late),
      transform 1.1s var(--ease) var(--late);
  }

  .regalo-info__actions {
    flex-flow: row wrap;
    gap: 12px;
  }

  .regalo-info__cta,
  .regalo-info__wa {
    display: inline-flex;
    align-items: center;
    height: 56px;
    border-radius: 28px;
    font: 500 11px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
    transition:
      background-color 0.3s,
      color 0.3s,
      gap 0.4s;
  }

  .regalo-info__cta {
    gap: 12px;
    padding: 0 30px;
    border: 1px solid var(--peach);
    background: var(--peach);
    color: var(--navy);
  }

  .regalo-info__cta:hover {
    gap: 20px;
    background: var(--sand);
    color: var(--navy);
  }

  .regalo-info__wa {
    gap: 10px;
    padding: 0 24px;
    border: 1px solid rgb(37 211 102 / 0.6);
    color: var(--cream);
  }

  .regalo-info__give {
    height: 56px;
  }

  .regalo-info__wa:hover {
    background: rgb(37 211 102 / 0.14);
    color: var(--cream);
  }

  :global(.is-p5) .regalo-info {
    pointer-events: auto;
  }

  :global(.is-p5) .regalo-info__eyebrow,
  :global(.is-p5) .regalo-info__from,
  :global(.is-p5) .regalo-info__late {
    opacity: 1;
    transform: none;
  }

  :global(.is-p5) .regalo-info__eyebrow i {
    width: 40px;
  }

  :global(.is-p5) .regalo-info__message :global(.word span) {
    transform: none;
  }

  @media (min-width: 900px) {
    .regalo-info {
      padding: 120px clamp(30px, 5vw, 96px) 12vh clamp(8px, 1.5vw, 24px);
    }
  }
</style>
