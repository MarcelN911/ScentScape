---
/*
 * Linke Bühne der Seite "Regalo": Umschlag mit der Gift Card darin.
 * Bis zum Ende der Öffnung steht sie in der Mitte des Bildschirms, danach rückt sie nach links
 * (Desktop) bzw. nach oben, damit der Text darunter Platz hat (Handy, Tablet hochkant).
 */
import Envelope from '../../components/regalo/Envelope.astro';
import GiftCard from '../../components/gift/GiftCard.astro';
import { formatCOP } from '../../scripts/utils/format.js';

/** @typedef {{ gift: object }} Props */
const { gift } = Astro.props;
const nines = formatCOP(gift.amount).replace(/\d/g, '9');
---

<div class="regalo-stage">
  <div class="regalo-stage__inner">
    <div class="regalo-stage__box" data-regalo-float>
      <Envelope to={gift.to} from={gift.from} />
      <div class="regalo-stage__card" data-regalo-card>
        <GiftCard
          color={gift.color}
          front={{ amount: nines, to: gift.to, from: gift.from }}
          back={{ message: gift.message, code: '', valid: '' }}
        />
      </div>
    </div>
    <div class="regalo-stage__controls">
      <span class="regalo-stage__hint">
        <i></i>
        <span class="regalo-stage__click">Haz clic</span>
        <span class="regalo-stage__tap">Toca</span> para abrir<i></i>
      </span>
      <span class="regalo-stage__swipe" aria-hidden="true">
        <i></i>Desliza para girarla<i></i>
      </span>
      <button class="flip-btn regalo-stage__flip" type="button" tabindex="-1" data-regalo-flip>
        <span class="flip-btn__icon">↻</span>
        <span data-regalo-flip-label>Ver frente</span>
      </button>
    </div>
  </div>
</div>

<style>
  .regalo-stage {
    position: relative;
    top: 0;
    height: 86vh;
  }

  .regalo-stage__inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 40px;
    padding: 90px clamp(24px, 4vw, 72px) 40px;
    transform: translateX(var(--shift, 0%));
    transition: transform 1.6s cubic-bezier(0.65, 0, 0.25, 1);
  }

  .regalo-stage__box {
    position: relative;
    width: min(100%, 580px);
    aspect-ratio: 1.586;
    container-type: inline-size;
    opacity: 0;
    transition: opacity 1.2s 0.7s;
  }

  .regalo-stage__card {
    position: absolute;
    inset: 0;
    z-index: 2;
    transform: translateY(0%) scale(0.9);
    transition: transform 1.5s cubic-bezier(0.6, 0, 0.2, 1);
  }

  .regalo-stage__card :global(.gift-card) {
    --odo-speed: 1.6s;

    width: 100%;
  }

  .regalo-stage__controls {
    display: grid;
    place-items: center;
    height: 44px;
    opacity: 0;
    transition: opacity 1s 1.4s;
  }

  .regalo-stage__hint,
  .regalo-stage__swipe,
  .regalo-stage__flip {
    grid-area: 1 / 1;
  }

  /* Hinweis statt Knopf (nur Handy, siehe unten) */
  .regalo-stage__swipe {
    display: none;
  }

  .regalo-stage__hint {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--peach);
    font: 400 10px var(--font-sans);
    letter-spacing: 5px;
    text-transform: uppercase;
    transition: opacity 0.6s;
    pointer-events: none;
  }

  .regalo-stage__hint i {
    width: 28px;
    height: 1px;
    background: var(--peach);
  }

  .regalo-stage__flip {
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.8s 0.9s,
      background-color 0.3s,
      color 0.3s;
  }

  :global(.is-in) .regalo-stage__box,
  :global(.is-in) .regalo-stage__controls {
    opacity: 1;
  }

  :global(.is-p1) .regalo-stage__hint {
    opacity: 0;
  }

  :global(.is-p2) .regalo-stage__card {
    transform: translateY(-52%) scale(0.9);
  }

  :global(.is-p3) .regalo-stage__card {
    transform: none;
  }

  :global(.is-p4) .regalo-stage__card {
    z-index: 8;
  }

  :global(.is-p5) .regalo-stage__card {
    cursor: pointer;
  }

  :global(.is-p5) .regalo-stage__flip {
    opacity: 1;
    pointer-events: auto;
  }

  @media (min-width: 900px) {
    .regalo-stage {
      position: sticky;
      height: 100vh;
    }

    .regalo-stage__inner {
      --shift: 50%;
    }

    :global(.is-p5) .regalo-stage__inner {
      --shift: 0%;
    }
  }

  /* Auf Touch-Geräten "Toca para abrir" statt "Haz clic para abrir" */
  .regalo-stage__tap {
    display: none;
  }

  @media (hover: none) {
    .regalo-stage__click {
      display: none;
    }

    .regalo-stage__tap {
      display: inline;
    }
  }

  /*
   * Handy und Tablet hochkant: Umschlag mittig mit Abstand zum Rand. Ist die Karte ausgepackt (.is-p5),
   * wird die Bühne niedriger: die Karte rückt weich nach oben und der Text gleitet darunter ins Bild.
   */
  @media (max-width: 899px) {
    .regalo-stage {
      --box: min(78vw, 420px);
      height: 100vh;
      height: 100svh;
      transition: height 1.6s cubic-bezier(0.65, 0, 0.25, 1);
    }

    .regalo-stage__inner {
      gap: 36px;
      padding: 64px 24px 24px;
    }

    .regalo-stage__box {
      width: var(--box);
    }

    :global(.is-p5) .regalo-stage {
      height: calc(var(--box) / 1.586 + 200px);
    }

    /* Kein "Ver reverso"-Knopf: die Karte dreht sich per Wischen (oder Antippen) */
    .regalo-stage__flip {
      display: none;
    }

    /* Senkrecht scrollen bleibt möglich; beim Wischen wird kein Text markiert */
    .regalo-stage__card {
      touch-action: pan-y;
      user-select: none;
      -webkit-user-select: none;
    }

    .regalo-stage__swipe {
      display: flex;
      align-items: center;
      gap: 12px;
      color: rgb(var(--peach-rgb) / 0.75);
      font: 400 9px var(--font-sans);
      letter-spacing: 4px;
      text-transform: uppercase;
      opacity: 0;
      transition: opacity 0.8s 0.9s;
      pointer-events: none;
    }

    .regalo-stage__swipe i {
      width: 22px;
      height: 1px;
      background: currentColor;
    }

    :global(.is-p5) .regalo-stage__swipe {
      opacity: 1;
    }
  }
</style>
