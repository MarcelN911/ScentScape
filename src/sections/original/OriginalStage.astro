---
/* Linke Bühne: Schild, eingegebener Code und Status. */
import Shield from '../../components/original/Shield.astro';
---

<div class="original-stage reveal-late" style="--late:0.6s">
  <Shield />
  <span class="original-stage__code" data-original-code>
    ······
  </span>
  <span class="original-stage__status" data-original-status>
    Esperando código
  </span>
</div>

<style>
  .original-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }

  .original-stage__code {
    max-width: 100%;
    overflow-wrap: anywhere;
    color: rgb(var(--cream-rgb) / 0.35);
    font:
      400 clamp(16px, 1.6vw, 20px) ui-monospace,
      Menlo,
      monospace;
    letter-spacing: 5px;
    text-align: center;
    transition: color 0.4s;
  }

  .original-stage__code.is-typed {
    color: var(--cream);
  }

  .original-stage__status {
    color: rgb(var(--cream-rgb) / 0.6);
    font: 400 11px var(--font-sans);
    letter-spacing: 4px;
    text-transform: uppercase;
    transition: color 0.4s;
  }

  :global(.is-received) .original-stage__status {
    color: var(--sand);
  }
</style>
