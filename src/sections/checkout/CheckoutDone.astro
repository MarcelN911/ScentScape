---
import { whatsappUrl } from '../../scripts/utils/whatsapp.js';
---

<div class="done frame hatch" data-checkout-done hidden>
  <span class="done__mark">✓</span>
  <h2 class="done__title">
    ¡Pedido <em>enviado!</em>
  </h2>
  <p class="done__meta" data-done-meta></p>
  <p class="done__text">
    Abrimos WhatsApp con tu pedido. Envía el mensaje y te confirmamos el pago y el envío en persona.
  </p>
  <div class="done__actions">
    <a class="btn btn--primary btn--lg" href="/productos/">
      Seguir comprando
    </a>
    <a
      class="btn btn--outline btn--lg"
      href={whatsappUrl('Hola ScentScape')}
      target="_blank"
      rel="noopener"
      data-done-whatsapp
    >
      <img src="/assets/img/whatsapp_white.svg" alt="" width="16" height="16" />
      Abrir WhatsApp de nuevo
    </a>
  </div>
</div>

<style>
  .done {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(36px, 6vw, 70px) clamp(22px, 4vw, 50px);
    text-align: center;
    animation: fade-in 0.5s ease;
  }

  .done__mark {
    display: grid;
    place-items: center;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    border: 1px solid rgb(var(--peach-rgb) / 0.5);
    outline: 1px solid rgb(var(--peach-rgb) / 0.2);
    outline-offset: -8px;
    font: italic 400 46px/1 var(--font-serif);
    color: var(--sand);
  }

  .done__title {
    margin: 0;
    font: 500 clamp(40px, 5vw, 64px) / 1 var(--font-serif);
  }

  .done__title em {
    font-style: italic;
    font-weight: 400;
    color: var(--peach);
  }

  .done__meta {
    margin: 0;
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--peach);
  }

  .done__text {
    max-width: 460px;
    margin: 0;
    font: 400 16px/1.6 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.78);
  }

  .done__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 6px;
  }
</style>
