---
import CheckoutField from '../../components/checkout/CheckoutField.astro';
import CheckoutModeButton from '../../components/checkout/CheckoutModeButton.astro';
import Icon from '../../components/ui/Icon.astro';
import PaymentLogos from '../../components/ui/PaymentLogos.astro';
import { CHECKOUT_FIELDS } from '../../data/checkout.js';
import { PAY_MODES } from '../../data/payments.js';
---

<form class="checkout-form" data-checkout-form novalidate>
  <fieldset class="checkout-form__box frame frame--soft hatch">
    <legend class="checkout-form__legend">Datos de envío</legend>
    <div class="checkout-form__fields">
      {CHECKOUT_FIELDS.map((field) => (
        <CheckoutField field={field} />
      ))}
    </div>
    <p class="checkout-form__privacy">
      <Icon name="lock" size={16} />
      Tus datos solo se usan para preparar y enviar tu pedido.
    </p>
  </fieldset>
  <fieldset class="checkout-form__box frame frame--soft">
    <legend class="checkout-form__legend">Pago</legend>
    <div class="checkout-form__modes">
      {PAY_MODES.map((mode) => (
        <CheckoutModeButton mode={mode} />
      ))}
    </div>
    <p class="checkout-form__mode-text" data-checkout-mode-text></p>
    <PaymentLogos />
  </fieldset>
  <p class="checkout-form__error" data-checkout-error role="alert" hidden></p>
  <button class="checkout-form__submit" type="submit" data-checkout-submit>
    <Icon name="lock" size={16} />
    <span data-checkout-submit-label>Enviar pedido</span>
  </button>
</form>

<style>
  .checkout-form {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .checkout-form__box {
    min-width: 0;
    margin: 0;
    padding: clamp(22px, 3vw, 34px);
  }

  .checkout-form__legend {
    float: left;
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    margin: 0 0 18px;
    padding: 0;
    font: italic 400 22px/1 var(--font-serif);
    color: var(--peach);
  }

  .checkout-form__legend::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgb(var(--peach-rgb) / 0.35), transparent);
  }

  .checkout-form__fields {
    clear: both;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 12px;
  }

  .checkout-form__privacy {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 16px 0 0;
    font: 500 12px/1.4 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.55);
  }

  .checkout-form__modes {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .checkout-form__mode-text {
    margin: 0 0 14px;
    font: 400 14px/1.6 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.75);
  }

  .checkout-form__error {
    margin: 0;
    padding: 14px 18px;
    border-radius: 14px;
    background: rgb(97 3 27 / 0.55);
    font: 500 14px/1.45 var(--font-sans);
    color: var(--sand);
  }

  .checkout-form__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 64px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--peach);
    color: var(--navy);
    font: 800 16px/1 var(--font-sans);
    transition: opacity 0.3s;
  }

  .checkout-form__submit--addi {
    background: #00b4e6;
    color: var(--white);
  }

  .checkout-form__submit:disabled {
    cursor: wait;
    opacity: 0.7;
  }
</style>
