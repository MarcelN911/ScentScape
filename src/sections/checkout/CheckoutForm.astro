---
/*
 * Linke Spalte von "Finalizar compra": Kontakt, Entrega, Pago, Términos und der Knopf.
 * Ablauf und Prüfung: scripts/features/checkout/page.js
 */
import FieldRow from '../../components/checkout/FieldRow.astro';
import FormStep from '../../components/checkout/FormStep.astro';
import PaymentOption from '../../components/checkout/PaymentOption.astro';
import Icon from '../../components/ui/Icon.astro';
import { CHECKOUT_FIELDS, PAYMENT_METHODS } from '../../data/checkout.js';

/* Felder mit derselben row-Zahl kommen in eine Zeile, die Reihenfolge bleibt wie in den Daten. */
function groupsOf(section) {
  const rows = [];
  CHECKOUT_FIELDS.filter((field) => field.section === section).forEach((field) => {
    const last = rows.at(-1);
    if (field.row && last?.[0].row === field.row) last.push(field);
    else rows.push([field]);
  });
  return rows;
}
const steps = [
  { number: '01', title: 'Contacto', rows: groupsOf('contact') },
  { number: '02', title: 'Entrega', rows: groupsOf('delivery') },
];
const whatsapp = PAYMENT_METHODS.find((method) => method.id === 'whatsapp');
---

<form class="checkout-form" data-checkout-form novalidate>
  {steps.map((step) => (
    <FormStep number={step.number} title={step.title}>
      {step.rows.map((row) => (
        <FieldRow row={row} />
      ))}
    </FormStep>
  ))}

  <FormStep number="03" title="Pago">
    <div class="checkout-form__pay" role="radiogroup" aria-label="Forma de pago">
      {PAYMENT_METHODS.map((method) => (
        <PaymentOption method={method} checked={method.id === 'whatsapp'} />
      ))}
    </div>
    <p class="checkout-form__note" data-pay-note>
      {whatsapp.note}
    </p>
  </FormStep>

  <div class="checkout-form__end reveal-late">
    <label class="checkout-form__terms">
      <input type="checkbox" name="terms" required />
      <span>
        Acepto los{' '}
        <a href="/terminos/" target="_blank">
          términos y condiciones
        </a>{' '}
        y la{' '}
        <a href="/privacidad/" target="_blank">
          política de privacidad
        </a>
        .
      </span>
    </label>
    <p class="checkout-form__error" data-checkout-error role="alert"></p>
    <button class="submit-btn checkout-form__submit" type="submit" data-checkout-submit>
      <span data-submit-label>{whatsapp.button}</span>
      <span class="checkout-form__amount" data-submit-amount></span>
    </button>
    <p class="checkout-form__secure">
      <Icon name="lock" size={13} strokeWidth={1.6} />
      Tus datos solo se usan para tu pedido.
    </p>
  </div>
</form>

<style>
  .checkout-form {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .checkout-form__pay {
    display: grid;
    gap: 12px;
  }

  .checkout-form__note {
    margin: 0;
    color: rgb(var(--cream-rgb) / 0.65);
    font: 300 13px/1.6 var(--font-sans);
  }

  .checkout-form__end {
    display: flex;
    flex-direction: column;
    gap: 16px;
    --late: 2.1s;
  }

  .checkout-form__terms {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: rgb(var(--cream-rgb) / 0.75);
    font: 300 13px/1.6 var(--font-sans);
    cursor: pointer;
  }

  .checkout-form__terms input {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--peach);
  }

  .checkout-form__terms a {
    color: var(--sand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .checkout-form__error {
    min-height: 0;
    margin: 0;
    color: var(--error);
    font: 400 13px/1.5 var(--font-sans);
  }

  .checkout-form__error:empty {
    display: none;
  }

  .checkout-form__submit {
    height: 60px;
    border-radius: 30px;
  }

  .checkout-form__submit.is-busy {
    opacity: 0.7;
    pointer-events: none;
  }

  .checkout-form__amount {
    font: 400 18px var(--font-serif);
    letter-spacing: 0;
    text-transform: none;
  }

  .checkout-form__amount:empty {
    display: none;
  }

  .checkout-form__secure {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 0;
    color: rgb(var(--cream-rgb) / 0.5);
    font: 300 12px var(--font-sans);
  }

  @media (min-width: 560px) {
    .checkout-form__pay {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
