---
/*
 * Formular des Catálogo Digital: Kollektion, Preise, Name für das Deckblatt, WhatsApp-Nummer.
 * Bedienung: scripts/features/catalogo/page.js
 */
import WhatsAppIcon from '../../components/ui/WhatsAppIcon.astro';
import { CATALOG_COLLECTIONS, CATALOG_LIMITS, CATALOG_PRICES } from '../../data/catalog.js';

/** @typedef {{ counts: Record<string, number>, pages: number }} Props */
const { counts, pages } = Astro.props;
const fragrances = (count) => `${count} ${count === 1 ? 'fragancia' : 'fragancias'}`;
---

<form class="form-card reveal-late catalog-form" style="--late:1.9s" data-catalog-form novalidate>
  <div class="field-group">
    <span class="field-label">01 · Colección</span>
    <div class="catalog-form__choices" role="radiogroup" aria-label="Colección">
      {CATALOG_COLLECTIONS.map((item, index) => (
        <button
          class="choice-card"
          type="button"
          role="radio"
          aria-checked={index === 0 ? 'true' : 'false'}
          data-catalog-collection={index}
        >
          <span class="choice-card__title">{item.title}</span>
          <span class="choice-card__sub">{fragrances(counts[item.key])}</span>
        </button>
      ))}
    </div>
  </div>
  <div class="field-group">
    <span class="field-label">02 · Precios</span>
    <div
      class="catalog-form__choices catalog-form__choices--wide"
      role="radiogroup"
      aria-label="Precios"
    >
      {CATALOG_PRICES.map((item, index) => (
        <button
          class="choice-card"
          type="button"
          role="radio"
          aria-checked={index === 0 ? 'true' : 'false'}
          data-catalog-prices={index}
        >
          <span class="choice-card__title">{item.title}</span>
          <span class="choice-card__sub">{item.sub}</span>
        </button>
      ))}
    </div>
  </div>
  <div class="catalog-form__fields">
    <label class="field-group">
      <span class="field-label">03 · Portada</span>
      <input
        class="text-input"
        name="client"
        maxlength={CATALOG_LIMITS.client}
        placeholder="Nombre del cliente o tienda"
        autocomplete="off"
      />
    </label>
    <label class="field-group">
      <span class="field-label">04 · WhatsApp</span>
      <input
        class="text-input"
        name="phone"
        type="tel"
        inputmode="tel"
        maxlength={CATALOG_LIMITS.phone}
        placeholder="300 000 0000 (opcional)"
        autocomplete="tel"
      />
    </label>
  </div>
  <div class="catalog-form__end">
    <button class="submit-btn" type="submit" data-catalog-submit>
      <span data-catalog-submit-label>Generar catálogo · {pages} páginas</span>
      <span>→</span>
    </button>
    <div class="catalog-form__done" data-catalog-done hidden>
      <a
        class="submit-btn"
        href="/catalogo/imprimir/"
        target="_blank"
        rel="noopener"
        data-catalog-pdf
      >
        Abrir PDF <span>→</span>
      </a>
      <a class="catalog-form__wa" href="#" target="_blank" rel="noopener" data-catalog-wa>
        <WhatsAppIcon size={16} color="var(--navy)" />
        Enviar por WhatsApp
      </a>
      <button class="outline-btn catalog-form__edit" type="button" data-catalog-edit>
        Editar catálogo
      </button>
    </div>
    <span class="form-hint" data-catalog-hint></span>
  </div>
</form>

<style>
  .catalog-form__choices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
  }

  .catalog-form__choices--wide,
  .catalog-form__fields,
  .catalog-form__done {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px;
  }

  .catalog-form__fields {
    gap: 14px;
  }

  .catalog-form__end {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .catalog-form__wa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 56px;
    border-radius: 28px;
    background: var(--whatsapp);
    color: var(--navy);
    font: 500 11px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
    transition: filter 0.3s;
  }

  .catalog-form__wa:hover {
    color: var(--navy);
    filter: brightness(1.1);
  }

  .catalog-form__edit {
    grid-column: 1 / -1;
    height: 56px;
    border-radius: 28px;
  }
</style>
