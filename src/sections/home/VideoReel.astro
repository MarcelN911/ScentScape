---
import VideoCard from '../../components/home/VideoCard.astro';
import VideoThumb from '../../components/home/VideoThumb.astro';
import InstagramPill from '../../components/ui/InstagramPill.astro';
import { VIDEOS } from '../../data/home.js';
import { padNumber } from '../../scripts/utils/format.js';
---

<section class="reel" data-reel>
  <div class="reel__pin">
    <div class="reel__grid">
      <div class="reel__intro">
        <h2 class="reel__title">
          <span class="line-mask">
            <span data-reveal="mask">ScentScape</span>
          </span>
          <span class="line-mask">
            <em data-reveal="mask">en video</em>
          </span>
        </h2>
        <div class="reel__now">
          <p class="reel__count">
            <span data-reel-number>01</span>{' '}
            <span class="reel__total">/ {padNumber(VIDEOS.length)}</span>
          </p>
          <p class="reel__current" data-reel-title>
            {VIDEOS[0].title}
          </p>
          <div class="reel__bar">
            <span data-reel-bar></span>
          </div>
        </div>
        <div class="reel__controls">
          <button class="reel__arrow" type="button" data-reel-step="-1" aria-label="Anterior">
            ←
          </button>
          <button class="reel__arrow" type="button" data-reel-step="1" aria-label="Siguiente">
            →
          </button>
          <button class="btn btn--primary btn--lg" type="button" data-reel-open>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
              <path d="M7 4l13 8-13 8z"></path>
            </svg>
            Ver con sonido
          </button>
          <InstagramPill />
        </div>
        <div class="reel__thumbs">
          {VIDEOS.map((video, index) => (
            <VideoThumb video={video} index={index} />
          ))}
        </div>
      </div>
      <div class="reel__stage" data-reel-stage>
        {VIDEOS.map((video, index) => (
          <VideoCard video={video} index={index} />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .reel {
    --video-stage: min(44vh, 560px);
    --video-width: min(70vw, calc(var(--video-stage) * 9 / 16));
    --video-spread: 62%;
    position: relative;
    height: 190vh;
    background: linear-gradient(180deg, var(--navy) 0%, #1b1634 30%, #3a0a24 78%, var(--wine) 100%);
  }

  .reel__pin {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    height: 100vh;
    overflow: hidden;
    padding: clamp(76px, 10vh, 90px) var(--gutter) clamp(16px, 3vh, 40px);
  }

  .reel__grid {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
  }

  .reel__intro {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 3vh, 30px);
    min-width: 0;
  }

  .reel__title {
    margin: 0;
    font: 500 clamp(34px, min(6vw, 8.5vh), 100px) / 0.9 var(--font-serif);
    letter-spacing: -0.015em;
  }

  .reel__title em {
    font: italic 400 1.05em/1 var(--font-serif);
    letter-spacing: 0;
    color: var(--peach);
  }

  .reel__now {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .reel__count {
    margin: 0;
    font: 700 13px/1 var(--font-sans);
    letter-spacing: 2px;
    color: var(--peach);
  }

  .reel__total {
    color: rgb(var(--white-rgb) / 0.45);
  }

  .reel__current {
    min-height: 1.1em;
    margin: 0;
    font: italic 400 clamp(30px, 3vw, 46px) / 1.05 var(--font-serif);
    text-wrap: balance;
  }

  .reel__bar {
    max-width: 360px;
    height: 2px;
    margin-top: 6px;
    overflow: hidden;
    border-radius: 1px;
    background: rgb(var(--white-rgb) / 0.18);
  }

  .reel__bar span {
    display: block;
    height: 100%;
    background: var(--peach);
    transform: scaleX(var(--reel-progress, 0));
    transform-origin: 0 50%;
  }

  .reel__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .reel__arrow {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid rgb(var(--peach-rgb) / 0.45);
    background: none;
    color: var(--peach);
    font: 400 22px/1 var(--font-sans);
  }

  .reel__arrow:hover {
    background: rgb(var(--peach-rgb) / 0.15);
  }

  .reel__thumbs {
    display: none;
    gap: 12px;
    overflow-x: auto;
    padding: 6px 2px;
    scrollbar-width: none;
  }

  .reel__stage {
    position: relative;
    height: var(--video-stage);
    min-width: 0;
    transform: perspective(1400px) rotateX(calc((1 - var(--fan, 1)) * 14deg))
      scale(calc(0.82 + var(--fan, 1) * 0.18));
    transform-origin: 50% 60%;
  }

  @media (min-width: 1000px) {
    .reel {
      --video-stage: clamp(420px, 64vh, 660px);
      --video-width: min(340px, 30vw, calc(var(--video-stage) * 9 / 16));
      --video-spread: 54%;
    }

    .reel__grid {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
      align-items: center;
      gap: clamp(40px, 5vw, 80px);
      max-width: 1500px;
      margin: 0 auto;
    }

    .reel__thumbs {
      display: flex;
    }
  }
</style>
