---
/*
 * Video-Bereich der Startseite: aufgefächertes Karussell.
 * Desktop: Text links, Karten rechts. Hochformat (Handy, Tablet hochkant): alles untereinander
 * und mittig wie die anderen Sections, dazu ein schwebender Instagram-Knopf.
 */
import InstagramFab from '../../components/home/InstagramFab.astro';
import ReelIntro from '../../components/home/ReelIntro.astro';
import VideoCard from '../../components/home/VideoCard.astro';
import { VIDEOS } from '../../data/home.js';
---

<section class="reel" data-reel>
  <div class="reel__pin">
    <div class="reel__grid">
      <ReelIntro />
      <div class="reel__stage" data-reel-stage>
        {VIDEOS.map((video, index) => (
          <VideoCard video={video} index={index} />
        ))}
      </div>
    </div>
  </div>
  <InstagramFab />
</section>

<style>
  .reel {
    --video-stage: min(44vh, 560px);
    --video-width: min(70vw, calc(var(--video-stage) * 9 / 16));
    --video-spread: 62%;
    position: relative;
    height: 190vh;
    background: linear-gradient(
      180deg,
      #161a32 0%,
      #1b1634 30%,
      #3a0a24 72%,
      #531019 90%,
      #11142b 100%
    );
  }

  .reel__pin {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    padding: clamp(76px, 10vh, 90px) var(--gutter) clamp(16px, 3vh, 40px);
  }

  .reel__grid {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
  }

  .reel__stage {
    position: relative;
    height: var(--video-stage);
    min-width: 0;
    transform: perspective(1400px) rotateX(calc((1 - var(--fan, 1)) * 14deg))
      scale(calc(0.82 + var(--fan, 1) * 0.18));
    transform-origin: 50% 60%;
  }

  /*
   * Hochformat: wie das Desktop-Karussell, aber untereinander und mittig
   * (wie die anderen Sections): Überschrift, aufgefächerte Videos, Nummer und Titel, Knöpfe.
   * Die linke Spalte gibt ihre Teile dafür direkt ans Raster weiter (display: contents),
   * so lässt sich die Reihenfolge mit order festlegen.
   */
  @media (max-width: 1079px) and (orientation: portrait), (max-width: 899px) {
    .reel {
      height: 190vh;
      height: 190svh;
      /* Oben wie die Gift Card (--navy), unten weich in die Farbe des Footers (--navy-deep) */
      background: linear-gradient(
        180deg,
        var(--navy) 0%,
        #1b1634 28%,
        #3a0a24 62%,
        #2a0c26 80%,
        var(--navy-deep) 96%
      );
    }

    .reel .reel__pin {
      padding: 84px 16px 84px;
    }

    .reel .reel__grid {
      align-items: center;
      gap: 0;
      text-align: center;
    }

    .reel :global(.reel__intro) {
      display: contents;
    }

    .reel :global(.reel__title) {
      order: 1;
      margin-bottom: 3svh;
      font-size: clamp(42px, min(11vw, 7svh), 96px);
    }

    .reel .reel__stage {
      order: 2;
      width: 100%;
      margin-bottom: 3svh;
      touch-action: pan-y;
    }

    /* Titel steht unter den Karten, deshalb auf der Karte selbst ausgeblendet */
    .reel .reel__stage :global(.video-card__foot) {
      display: none;
    }

    .reel :global(.reel__now) {
      order: 3;
      align-items: center;
      gap: 8px;
    }

    .reel :global(.reel__current) {
      font-size: clamp(24px, 6.5vw, 38px);
    }

    .reel :global(.reel__bar) {
      width: min(220px, 60vw);
      margin-top: 4px;
    }

    .reel :global(.reel__controls) {
      order: 4;
      flex-wrap: nowrap;
      justify-content: center;
      margin-top: 3svh;
    }

    .reel :global(.reel__arrow) {
      flex: none;
      width: 48px;
      height: 48px;
    }

    .reel :global(.reel__sound) {
      height: 48px;
      padding: 0 22px;
    }

    /* Instagram gibt es als schwebenden Knopf (InstagramFab) */
    .reel :global(.instagram-pill) {
      display: none;
    }
  }

  /* Tablet hochkant: größere Karten, damit die Fläche gefüllt ist */
  @media (min-width: 600px) and (max-width: 1079px) and (orientation: portrait) {
    .reel {
      --video-stage: min(52svh, 640px);
      --video-spread: 70%;
    }
  }

  /* Nebeneinander: Desktop und Tablet quer */
  @media (min-width: 1080px), (min-width: 1000px) and (orientation: landscape) {
    .reel {
      --video-stage: clamp(420px, 64vh, 660px);
      --video-width: min(340px, 30vw, calc(var(--video-stage) * 9 / 16));
      --video-spread: 54%;
    }

    .reel__grid {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
      align-items: center;
      gap: clamp(40px, 5vw, 80px);
      max-width: 1500px;
      margin: 0 auto;
    }
  }
</style>
