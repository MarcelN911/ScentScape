---
import StoryCard from '../../components/home/StoryCard.astro';
import StoryPanel from '../../components/home/StoryPanel.astro';
import { STORY_CARD_COLORS } from '../../data/home.js';

const first = STORY_CARD_COLORS[0];
const cardStyle = [
  `--card-bg:${first.background}`,
  `--card-ink:${first.ink}`,
  `--card-accent:${first.accent}`,
  `--card-border:${first.border}`,
  `--card-logo:${first.logo}`,
].join(';');
---

<StoryPanel
  kind="gift"
  eyebrow="Regala ScentScape"
  first="Gift"
  second="Card"
  word="Regalo · Regalo ·"
  text="Regala una experiencia ScentScape. Elige el valor de la tarjeta y envíala a quien quieras."
  cta="Comprar Gift Card"
  href="/gift-card/"
  centered
  background="radial-gradient(ellipse 60% 70% at 72% 45%,rgba(240,190,145,.16),transparent 70%),#11142B"
>
  <div class="story-gift" slot="visual" style={cardStyle} data-story-gift>
    <StoryCard />
    <p class="story-gift__hint" data-card-hint>
      <span class="story-gift__swipe" aria-hidden="true">
        <i></i>
      </span>
      <span class="story-gift__hint-touch">Desliza para ver el reverso</span>
      <span class="story-gift__hint-mouse">Haz clic o desliza para girarla</span>
    </p>
    <div class="story-gift__chips">
      {STORY_CARD_COLORS.map((color, index) => (
        <button
          class:list={['story-gift__chip', { 'is-active': index === 0 }]}
          type="button"
          aria-label={color.name}
          data-card-color={JSON.stringify(color)}
        >
          <span style={`background:${color.swatch}`}></span>
          {color.name}
        </button>
      ))}
    </div>
  </div>
</StoryPanel>

<style>
  .story-gift {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 34px;
    width: 100%;
  }

  .story-gift__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 26px;
  }

  .story-gift__chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--sand);
    font: 500 10px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0.6;
    transition: opacity 0.3s;
  }

  .story-gift__chip:hover,
  .story-gift__chip.is-active {
    opacity: 1;
  }

  .story-gift__chip span {
    --ring: rgb(var(--peach-rgb) / 0.3);
    width: 44px;
    height: 44px;
    border-radius: 22px;
    box-shadow:
      0 0 0 1px var(--ring),
      0 0 0 5px var(--navy-deep),
      0 0 0 6px var(--ring);
    transition: box-shadow 0.3s;
  }

  .story-gift__chip.is-active span {
    --ring: var(--peach);
  }

  /* Hinweis unter der Karte: kleine Wischgeste und Text. Verschwindet, sobald die Karte gedreht wurde. */
  .story-gift__hint {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: -12px 0 0;
    color: rgb(var(--sand-rgb) / 0.75);
    font: 500 10px/1.3 var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: opacity 0.6s;
  }

  .story-gift.is-flipped .story-gift__hint {
    opacity: 0;
  }

  .story-gift__swipe {
    position: relative;
    flex: none;
    width: 30px;
    height: 14px;
    border: 1px solid rgb(var(--peach-rgb) / 0.45);
    border-radius: 7px;
  }

  .story-gift__swipe i {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--peach);
    animation: swipe-hint 2.2s var(--ease-soft) infinite;
  }

  @keyframes swipe-hint {
    0%,
    15% {
      transform: translateX(0);
      opacity: 0;
    }

    30% {
      opacity: 1;
    }

    70% {
      transform: translateX(16px);
      opacity: 1;
    }

    85%,
    100% {
      transform: translateX(16px);
      opacity: 0;
    }
  }

  /* Mit Maus anderer Text als mit Finger */
  .story-gift__hint-mouse {
    display: none;
  }

  @media (hover: hover) {
    .story-gift__hint-touch {
      display: none;
    }

    .story-gift__hint-mouse {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-gift__swipe i {
      animation: none;
    }
  }

  /*
   * Untereinander (Handy, Tablet hochkant): Farbwahl als ruhige Punktreihe. Die Namen sind
   * ausgeblendet, nur der Name der gewählten Farbe steht mittig darunter (aus aria-label).
   */
  @media (max-width: 1079px) and (orientation: portrait), (max-width: 899px) {
    .story-gift {
      gap: 2.6svh;
    }

    .story-gift :global(.story-card) {
      width: min(100%, 440px);
    }

    .story-gift__chips {
      position: relative;
      flex-wrap: nowrap;
      gap: 18px;
      padding-bottom: 26px;
    }

    .story-gift__chip {
      gap: 0;
      font-size: 0;
    }

    .story-gift__chip span {
      width: 30px;
      height: 30px;
    }

    .story-gift__chip.is-active::after {
      content: attr(aria-label);
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      color: var(--sand);
      font: 500 10px/1 var(--font-sans);
      letter-spacing: 3px;
    }
  }

  @media (min-width: 600px) and (max-width: 1079px) and (orientation: portrait) {
    .story-gift :global(.story-card) {
      width: min(100%, 580px);
    }

    .story-gift__chip span {
      width: 38px;
      height: 38px;
    }
  }
</style>
