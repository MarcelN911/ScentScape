---
import StoryPanel from '../../components/home/StoryPanel.astro';
import { STORY_CARD_COLORS } from '../../data/home.js';

const first = STORY_CARD_COLORS[0];
const cardStyle = [
  `--card-bg:${first.background}`,
  `--card-ink:${first.ink}`,
  `--card-accent:${first.accent}`,
  `--card-border:${first.border}`,
  `--card-logo:${first.logo}`,
].join(';');
---

<StoryPanel
  kind="gift"
  eyebrow="Regala ScentScape"
  first="Gift"
  second="Card"
  word="Regalo · Regalo ·"
  text="Regala una experiencia ScentScape. Elige el valor de la tarjeta y envíala a quien quieras."
  cta="Comprar Gift Card"
  href="/gift-card/"
  background="radial-gradient(ellipse 60% 70% at 72% 45%,rgba(240,190,145,.16),transparent 70%),#11142B"
>
  <div class="story-gift" slot="visual" style={cardStyle} data-story-gift>
    <div class="story-card">
      <span class="story-card__light"></span>
      <span class="story-card__rings"></span>
      <span class="story-card__shine"></span>
      <span class="story-card__frame"></span>
      <div class="story-card__content">
        <div class="story-card__top">
          <img src="/assets/img/scentscape-logo.png" alt="ScentScape" />
          <span class="story-card__kind">
            <i></i>Gift Card
          </span>
        </div>
        <div class="story-card__middle">
          <span class="story-card__chip" aria-hidden="true"></span>
          <div class="story-card__amount">
            <span>200.000</span>
            <small>COP</small>
          </div>
        </div>
        <div class="story-card__bottom">
          <span>
            <small>Para</small>
            <em>Alguien especial</em>
          </span>
          <span class="story-card__from">
            <small>De</small>
            <em>Tú</em>
          </span>
        </div>
      </div>
    </div>
    <div class="story-gift__chips">
      {STORY_CARD_COLORS.map((color, index) => (
        <button
          class:list={['story-gift__chip', { 'is-active': index === 0 }]}
          type="button"
          aria-label={color.name}
          data-card-color={JSON.stringify(color)}
        >
          <span style={`background:${color.swatch}`}></span>
          {color.name}
        </button>
      ))}
    </div>
  </div>
</StoryPanel>

<style>
  .story-gift {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 34px;
    width: 100%;
  }

  .story-card {
    position: relative;
    width: min(92%, 560px);
    aspect-ratio: 1.586;
    overflow: hidden;
    border-radius: 22px;
    background: var(--card-bg);
    color: var(--card-ink);
    box-shadow:
      0 50px 100px rgb(0 0 0 / 0.55),
      0 0 0 1px rgb(var(--cream-rgb) / 0.06);
    transform: rotateY(calc(var(--gry, 0) * 1deg)) rotateX(calc(var(--grx, 0) * 1deg))
      translateY(calc(var(--gy, 0) * 1px));
    transition:
      transform 0.25s ease-out,
      color 0.6s;
  }

  .story-card > span {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .story-card__light {
    background:
      radial-gradient(120% 80% at 100% 0%, rgb(var(--cream-rgb) / 0.14), transparent 55%),
      radial-gradient(90% 70% at 0% 100%, rgb(0 0 0 / 0.35), transparent 60%);
  }

  .story-card__rings {
    opacity: 0.5;
    background: repeating-radial-gradient(
      circle at 115% -15%,
      transparent 0 22px,
      var(--card-border) 22px 23px
    );
    mask-image: linear-gradient(200deg, #000, transparent 65%);
  }

  .story-card__shine {
    background: linear-gradient(
      115deg,
      transparent 35%,
      rgb(255 244 228 / 0.28) 50%,
      transparent 65%
    );
    background-size: 250% 100%;
    background-position: calc(var(--shine, 50) * 1%) 0;
  }

  .story-card .story-card__frame {
    inset: 12px;
    border: 1px solid var(--card-border);
    border-radius: 14px;
    transition: border-color 0.6s;
  }

  .story-card__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(22px, 6.5%, 38px);
  }

  .story-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .story-card__top img {
    height: clamp(20px, 2vw, 28px);
    width: auto;
    filter: var(--card-logo);
    transition: filter 0.6s;
  }

  .story-card__kind {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 600 9px var(--font-sans);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .story-card__kind i {
    width: 18px;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  .story-card__middle {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .story-card__chip {
    position: relative;
    width: 44px;
    aspect-ratio: 1.35;
    overflow: hidden;
    border-radius: 7px;
    background: linear-gradient(135deg, var(--sand-light), #c9a06e 45%, #f0d2aa 70%, #b88d58);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
  }

  .story-card__chip::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        transparent 32%,
        rgb(0 0 0 / 0.18) 32% 34%,
        transparent 34% 66%,
        rgb(0 0 0 / 0.18) 66% 68%,
        transparent 68%
      ),
      linear-gradient(0deg, transparent 46%, rgb(0 0 0 / 0.18) 46% 54%, transparent 54%);
  }

  .story-card__amount {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .story-card__amount span {
    color: var(--card-accent);
    font: 400 clamp(32px, 4vw, 60px) / 1 var(--font-serif);
    font-variant-numeric: lining-nums tabular-nums;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.18);
  }

  .story-card__amount small {
    margin-top: 0.5em;
    font: 600 9px var(--font-sans);
    letter-spacing: 3px;
    opacity: 0.8;
  }

  .story-card__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }

  .story-card__bottom > span {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .story-card__from {
    align-items: flex-end;
  }

  .story-card__bottom small {
    font: 600 8px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .story-card__bottom em {
    font: italic 400 clamp(18px, 1.6vw, 24px) / 1.3 var(--font-serif);
  }

  .story-gift__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 26px;
  }

  .story-gift__chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--sand);
    font: 500 10px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0.6;
    transition: opacity 0.3s;
  }

  .story-gift__chip:hover,
  .story-gift__chip.is-active {
    opacity: 1;
  }

  .story-gift__chip span {
    --ring: rgb(var(--peach-rgb) / 0.3);
    width: 44px;
    height: 44px;
    border-radius: 22px;
    box-shadow:
      0 0 0 1px var(--ring),
      0 0 0 5px var(--navy-deep),
      0 0 0 6px var(--ring);
    transition: box-shadow 0.3s;
  }

  .story-gift__chip.is-active span {
    --ring: var(--peach);
  }
</style>
