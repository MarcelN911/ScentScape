---
import { FAMILIES } from '../../data/families.js';
import { imageUrl } from '../../scripts/utils/image.js';
import { padNumber } from '../../scripts/utils/format.js';

const glowOf = (family) => `${family.accent}33`;
---

<section class="families" id="familias" data-families>
  <div class="families__stage" data-families-stage style={`--family-glow:${glowOf(FAMILIES[0])}`}>
    <div class="families__rail">
      <span></span>
    </div>
    <div class="families__grid">
      <div>
        <p class="families__eyebrow">
          Familias olfativas · <span data-families-number>01</span> / {padNumber(FAMILIES.length)}
        </p>
        <div class="families__list">
          {FAMILIES.map((family, index) => (
            <button
              class:list={['families__name', { 'is-active': index === 0 }]}
              type="button"
              data-family-index={index}
              data-family-glow={glowOf(family)}
              data-family-line={family.line}
              data-family-id={family.id}
            >
              {family.id}
            </button>
          ))}
        </div>
      </div>
      <div class="families__showcase">
        <div class="families__top">
          <div class="families__bottles">
            {FAMILIES.map((family, index) => (
              <img
                class:list={[
                  'families__bottle',
                  { 'is-active': index === 0, 'is-after': index > 0 },
                ]}
                src={imageUrl(family.image, 700)}
                alt={family.bottle}
                loading="lazy"
                data-family-bottle
              />
            ))}
          </div>
          <div class="families__descs">
            {FAMILIES.map((family, index) => (
              <div
                class:list={['families__desc', { 'is-active': index === 0, 'is-after': index > 0 }]}
                data-family-desc
              >
                <p class="families__desc-title">
                  <span></span>
                  {family.id}
                </p>
                <p class="families__desc-text">{family.description}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="families__copy">
          <p class="families__line" data-families-line>
            {FAMILIES[0].line}
          </p>
          <a class="families__link" href="/productos/" data-families-link>
            Explorar&nbsp;<span data-families-title>{FAMILIES[0].id}</span>&nbsp;→
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Als Farbe registriert, damit der Lichtschein weich zur nächsten Familie überblendet */
  @property --family-glow {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }

  .families {
    position: relative;
    height: 500vh;
  }

  .families__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 70% at 70% 55%, var(--family-glow), transparent 70%), var(--navy);
    transition: --family-glow 1s ease;
  }

  .families__rail {
    position: absolute;
    left: clamp(16px, 3vw, 40px);
    top: 50%;
    width: 1px;
    height: 40vh;
    background: rgb(var(--peach-rgb) / 0.2);
    transform: translateY(-50%);
  }

  .families__rail span {
    position: absolute;
    inset: 0;
    background: var(--peach);
    transform: scaleY(var(--families-progress, 0));
    transform-origin: 50% 0;
  }

  .families__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    align-items: center;
    gap: 30px;
    max-width: 1440px;
    height: 100%;
    margin: 0 auto;
    padding: 110px clamp(36px, 6vw, 110px) 60px;
  }

  .families__eyebrow {
    margin: 0 0 26px;
    color: var(--peach);
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .families__list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .families__name {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    color: transparent;
    font: 400 clamp(46px, 7.4vw, 118px) / 1 var(--font-serif);
    text-align: left;
    -webkit-text-stroke: 1px rgb(var(--sand-rgb) / 0.4);
    transition: all 0.7s var(--ease-soft);
  }

  .families__name.is-active {
    color: var(--cream);
    font-style: italic;
    -webkit-text-stroke: 0 transparent;
    transform: translateX(18px);
  }

  .families__showcase {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    height: min(62vh, 600px);
  }

  .families__top {
    position: absolute;
    inset: 0 0 120px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(120px, 200px);
    align-items: center;
    gap: clamp(14px, 2.4vw, 32px);
  }

  .families__bottles {
    position: relative;
    height: 100%;
    min-width: 0;
  }

  .families__bottle {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 40px 50px rgb(0 0 0 / 0.5));
    opacity: 0;
    transform: translateY(-60px) rotate(-6deg) scale(0.9);
    transition:
      opacity 0.8s ease,
      transform 1.1s var(--ease-soft);
  }

  .families__bottle.is-after {
    transform: translateY(80px) rotate(6deg) scale(0.9);
  }

  .families__bottle.is-active {
    opacity: 1;
    transform: none;
  }

  .families__descs {
    position: relative;
    min-height: 190px;
  }

  .families__desc {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    opacity: 0;
    transform: translateY(calc(-50% - 24px));
    pointer-events: none;
    transition:
      opacity 0.7s ease,
      transform 0.9s var(--ease-soft);
  }

  .families__desc.is-after {
    transform: translateY(calc(-50% + 24px));
  }

  .families__desc.is-active {
    opacity: 1;
    transform: translateY(-50%);
    pointer-events: auto;
  }

  .families__desc-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    color: var(--peach);
    font: 600 10px/1 var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .families__desc-title span {
    width: 22px;
    height: 1px;
    background: var(--peach);
  }

  .families__desc-text {
    margin: 0;
    color: rgb(var(--cream-rgb) / 0.86);
    font: 400 14px/1.6 var(--font-sans);
    text-wrap: pretty;
  }

  .families__copy {
    position: relative;
    max-width: 380px;
    text-align: center;
  }

  .families__line {
    margin: 0 0 16px;
    color: rgb(var(--cream-rgb) / 0.85);
    font: italic 400 22px/1.4 var(--font-serif);
  }

  .families__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border: 1px solid rgb(var(--peach-rgb) / 0.45);
    border-radius: var(--radius-pill);
    color: var(--sand);
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .families__link:hover {
    background: var(--peach);
    color: var(--navy);
  }
</style>
