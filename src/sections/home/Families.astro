---
import { FAMILIES } from '../../data/families.js';
import { findBySlug } from '../../scripts/catalog/queries.js';
import { imageUrl } from '../../scripts/utils/image.js';
import { padNumber } from '../../scripts/utils/format.js';

/** @typedef {{ catalog: object[] }} Props */
const { catalog } = Astro.props;
const families = FAMILIES.map((family) => ({
  ...family,
  product: findBySlug(catalog, family.featured),
  glow: `${family.glow}33`,
}));
const first = families[0];
---

<section class="families" id="familias" data-families>
  <div class="families__stage" data-families-stage style={`--family-glow:${first.glow}`}>
    <div class="families__rail">
      <span data-families-bar></span>
    </div>
    <div class="families__grid">
      <div>
        <p class="families__eyebrow">
          Familias olfativas · <span data-families-number>01</span> / {padNumber(families.length)}
        </p>
        <div class="families__list">
          {families.map((family, index) => (
            <button
              class:list={['families__name', { 'is-active': index === 0 }]}
              type="button"
              data-family-index={index}
              data-family-glow={family.glow}
            >
              {family.id}
            </button>
          ))}
        </div>
      </div>
      <div class="families__showcase">
        <div class="families__bottles">
          {families.map(
            (family, index) =>
              family.product && (
                <img
                  class:list={[
                    'families__bottle',
                    { 'is-active': index === 0, 'is-after': index > 0 },
                  ]}
                  src={imageUrl(family.product.images[0], 800)}
                  alt={family.product.name}
                  loading="lazy"
                  data-family-bottle
                />
              ),
          )}
        </div>
        <div class="families__copy">
          {families.map((family, index) => (
            <div class="families__detail" data-family-detail hidden={index !== 0}>
              <p class="families__line">{family.line}</p>
              <a
                class="families__link"
                href={`/productos/?familia=${encodeURIComponent(family.id)}`}
              >
                Explorar {family.id} →
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Als Farbe registriert, damit der Lichtschein weich zur nächsten Familie überblendet */
  @property --family-glow {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }

  .families {
    position: relative;
    height: 500vh;
  }

  .families__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 70% at 70% 55%, var(--family-glow), transparent 70%), var(--navy);
    transition: --family-glow 1s ease;
  }

  .families__rail {
    position: absolute;
    left: clamp(16px, 3vw, 40px);
    top: 50%;
    width: 1px;
    height: 40vh;
    background: rgb(212 175 125 / 0.2);
    transform: translateY(-50%);
  }

  .families__rail span {
    position: absolute;
    inset: 0;
    background: var(--gold);
    transform: scaleY(var(--families-progress, 0));
    transform-origin: 50% 0;
  }

  .families__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    align-items: center;
    gap: 30px;
    max-width: 1440px;
    height: 100%;
    margin: 0 auto;
    padding: 110px clamp(36px, 6vw, 110px) 60px;
  }

  .families__eyebrow {
    margin: 0 0 26px;
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold);
  }

  .families__list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .families__name {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    color: transparent;
    font: 300 clamp(46px, 7.4vw, 118px) / 1 var(--font-serif);
    text-align: left;
    -webkit-text-stroke: 1px rgb(var(--sand-rgb) / 0.4);
    transition: all 0.7s var(--ease);
  }

  .families__name.is-active {
    color: var(--white);
    font-style: italic;
    -webkit-text-stroke: 0 transparent;
    transform: translateX(18px);
  }

  .families__showcase {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    height: min(62vh, 600px);
  }

  .families__bottles {
    position: absolute;
    inset: 0 0 120px;
  }

  .families__bottle {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 40px 50px rgb(0 0 0 / 0.5));
    opacity: 0;
    transform: translateY(-60px) rotate(-6deg) scale(0.9);
    transition:
      opacity 0.8s ease,
      transform 1.1s var(--ease);
  }

  .families__bottle.is-after {
    transform: translateY(80px) rotate(6deg) scale(0.9);
  }

  .families__bottle.is-active {
    opacity: 1;
    transform: none;
  }

  .families__copy {
    position: relative;
    max-width: 380px;
    text-align: center;
  }

  .families__detail {
    animation: fade-in 0.6s var(--ease);
  }

  .families__line {
    margin: 0 0 16px;
    font: italic 400 22px/1.4 var(--font-serif);
    color: rgb(var(--white-rgb) / 0.85);
  }

  .families__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(212 175 125 / 0.45);
    color: var(--sand);
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .families__link:hover {
    background: var(--gold);
    color: var(--navy);
  }
</style>
