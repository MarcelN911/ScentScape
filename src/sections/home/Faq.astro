---
import FaqItem from '../../components/home/FaqItem.astro';
import FaqTab from '../../components/home/FaqTab.astro';
import { FAQ_GROUPS } from '../../data/faq.js';
import { whatsappUrl } from '../../scripts/utils/whatsapp.js';

const ROMAN = ['I', 'II', 'III', 'IV', 'V'];
const askUrl = whatsappUrl('Hola ScentScape, tengo una pregunta.');
---

<section class="faq" id="faq" data-faq>
  <div class="faq__grid">
    <div class="faq__intro">
      <p class="faq__eyebrow" data-reveal="up">
        Antes de comprar
      </p>
      <h2 class="faq__title">
        <span class="line-mask">
          <span data-reveal="mask">Preguntas</span>
        </span>
        <em>frecuentes</em>
      </h2>
      <p class="faq__lead" data-reveal="up">
        Lo que más nos preguntan sobre envíos, pagos, originalidad y regalos.
      </p>
      <div class="faq__tabs" role="tablist">
        {FAQ_GROUPS.map((group, index) => (
          <FaqTab
            label={group.label}
            number={ROMAN[index]}
            count={group.items.length}
            index={index}
          />
        ))}
      </div>
    </div>
    <div class="faq__answers">
      {FAQ_GROUPS.map((group, index) => (
        <div
          class="faq__panel"
          role="tabpanel"
          data-faq-panel={index}
          data-accordion
          hidden={index !== 0}
        >
          <p class="faq__group">{group.label}</p>
          {group.items.map((item, position) => (
            <FaqItem item={item} open={position === 0} />
          ))}
        </div>
      ))}
      <a class="faq__ask" href={askUrl} target="_blank" rel="noopener">
        <span class="faq__ask-icon">
          <img src="/assets/img/whatsapp_white.svg" alt="" width="18" height="18" />
        </span>
        <span class="faq__ask-text">
          ¿Tienes otra pregunta? <strong>Escríbenos por WhatsApp</strong>
        </span>
        <span class="faq__ask-arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .faq {
    position: relative;
    padding: clamp(80px, 9vw, 140px) var(--gutter);
    background: var(--navy-deep);
  }

  .faq__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    align-items: start;
    gap: clamp(36px, 6vw, 90px);
    max-width: 1240px;
    margin: 0 auto;
  }

  .faq__intro {
    position: sticky;
    top: 110px;
  }

  .faq__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 22px;
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--peach);
  }

  .faq__eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--peach);
  }

  .faq__title {
    margin: 0 0 24px;
    font: 500 clamp(48px, 6vw, 96px) / 0.92 var(--font-serif);
    letter-spacing: -0.015em;
  }

  .faq__title em {
    display: block;
    font: italic 400 1em/1 var(--font-serif);
    color: var(--peach);
  }

  .faq__lead {
    max-width: 400px;
    margin: 0 0 30px;
    font: 400 16px/1.65 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.72);
    text-wrap: pretty;
  }

  .faq__tabs {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 340px;
  }

  .faq__answers {
    min-width: 0;
  }

  .faq__panel {
    animation: fade-in 0.5s var(--ease);
  }

  .faq__group {
    margin: 0 0 6px;
    padding-bottom: 6px;
    border-bottom: 1px solid;
    border-image: linear-gradient(90deg, rgb(var(--peach-rgb) / 0.45), transparent) 1;
    font: italic 400 clamp(28px, 3vw, 40px) / 1 var(--font-serif);
    color: var(--sand);
  }

  .faq__ask {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 30px;
    padding: 18px 22px;
    border-radius: 20px;
    border: 1px solid rgb(var(--peach-rgb) / 0.25);
    background: rgb(var(--white-rgb) / 0.03);
    color: var(--white);
  }

  .faq__ask:hover {
    border-color: var(--peach);
    color: var(--white);
  }

  .faq__ask-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--whatsapp);
  }

  .faq__ask-text {
    flex: 1;
    font: 400 15px/1.4 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.8);
  }

  .faq__ask-text strong {
    color: var(--sand);
  }

  .faq__ask-arrow {
    color: var(--peach);
  }
</style>
