---
import { existsSync } from 'node:fs';
import { HERO_VIDEO, HERO_VIDEO_PORTRAIT } from '../../data/home.js';

/* Liegt das Hochformat-Video in public/, nehmen Handys (Hochformat) dieses Video */
const hasPortrait = existsSync(`public${HERO_VIDEO_PORTRAIT}`);
---

<section class="hero" data-hero>
  <video class="hero__video" autoplay muted loop playsinline preload="auto" data-hero-video>
    {hasPortrait && (
      <source src={HERO_VIDEO_PORTRAIT} media="(max-width: 759px) and (orientation: portrait)" />
    )}
    <source src={HERO_VIDEO} />
  </video>
  <div class="hero__shade hero__shade--side"></div>
  <div class="hero__shade hero__shade--bottom"></div>
  <div class="hero__content">
    <div class="hero__text" data-hero-text>
      <p class="hero__eyebrow">ScentScape · Medellín</p>
      <h1 class="hero__title">
        Distinción<em>sin límites.</em>
      </h1>
      <div class="hero__actions">
        <a class="hero__cta" href="/productos/">
          Ver la colección →
        </a>
        <a class="hero__discover" href="/test-olfativo/">
          <span class="hero__circle">›</span>
          <span class="hero__discover-text">
            Descubre
            <br />
            tu esencia
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: max(100vh, 560px);
    height: max(100svh, 560px);
    overflow: hidden;
    background: var(--navy-deep);
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transform: scale(1.25);
  }

  .hero__shade {
    position: absolute;
    pointer-events: none;
  }

  .hero__shade--side {
    inset: 0;
    background: linear-gradient(
      90deg,
      rgb(var(--navy-deep-rgb) / 0.85) 0%,
      rgb(var(--navy-deep-rgb) / 0.5) 45%,
      rgb(var(--navy-deep-rgb) / 0.12) 100%
    );
  }

  .hero__shade--bottom {
    left: 0;
    right: 0;
    bottom: 0;
    height: 45%;
    background: linear-gradient(
      180deg,
      rgb(var(--navy-rgb) / 0) 0%,
      rgb(var(--navy-rgb) / 0.7) 60%,
      var(--navy) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 3;
    height: 100%;
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 1.2s var(--ease-soft),
      transform 1.4s var(--ease-soft);
  }

  .hero.is-in .hero__content,
  :global(html:not(.js)) .hero__content {
    opacity: 1;
    transform: none;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 26px;
    height: 100%;
    max-width: 1500px;
    margin: 0 auto;
    padding: 110px clamp(18px, 5vw, 80px) clamp(80px, 12vh, 140px);
  }

  .hero__eyebrow {
    margin: 0;
    color: var(--sand);
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 5px;
    text-transform: uppercase;
  }

  .hero__title {
    margin: 0;
    color: var(--cream);
    font: 400 clamp(56px, 9vw, 160px) / 0.86 var(--font-serif);
    letter-spacing: -0.015em;
  }

  .hero__title em {
    display: block;
    color: var(--peach);
    font: italic 400 1.06em/1 var(--font-serif);
    letter-spacing: -0.01em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    height: 56px;
    padding: 0 26px;
    border-radius: var(--radius-pill);
    background: var(--peach);
    color: var(--navy);
    font: 700 14px/1 var(--font-sans);
    white-space: nowrap;
  }

  .hero__cta:hover {
    background: var(--sand);
    color: var(--navy);
  }

  .hero__discover {
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--cream);
  }

  .hero__discover:hover {
    color: var(--cream);
  }

  .hero__circle {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid rgb(var(--sand-rgb) / 0.6);
    border-radius: 50%;
    color: var(--sand);
    font-size: 20px;
    transition: background-color 0.4s;
  }

  .hero__discover:hover .hero__circle {
    background: rgb(var(--peach-rgb) / 0.18);
  }

  .hero__discover-text {
    font: 600 12px/1.6 var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  /* Hochformat (Handy, Tablet): Text steht unten, also dunkelt vor allem der untere Teil ab */
  @media (max-width: 1079px) and (orientation: portrait) {
    .hero__shade--side {
      background: linear-gradient(
        180deg,
        rgb(var(--navy-deep-rgb) / 0.35) 0%,
        rgb(var(--navy-deep-rgb) / 0.1) 35%,
        rgb(var(--navy-deep-rgb) / 0.55) 75%
      );
    }

    .hero__shade--bottom {
      height: 55%;
    }

    .hero__text {
      padding-bottom: max(96px, 11svh);
    }
  }

  /* Tablet hochkant: größerer Titel, damit die Fläche nicht leer wirkt */
  @media (min-width: 600px) and (max-width: 1079px) and (orientation: portrait) {
    .hero__text {
      gap: 34px;
      padding-inline: 8vw;
    }

    .hero__title {
      font-size: 13vw;
    }
  }
</style>
