---
/**
 * Gemeinsamer Rahmen für Términos und Privacidad: Pfad, Titel mit kursivem Teil, Datum, dann der Text (Slot).
 * @typedef {{ title: string, accent: string, updated: string }} Props
 */
const { title, accent, updated } = Astro.props;
---

<main class="legal" data-intro-page>
  <header class="legal__hero">
    <span class="legal__word" aria-hidden="true">
      Legal · Legal ·
    </span>
    <div class="legal__hero-inner">
      <nav class="legal__crumbs" aria-label="Ruta">
        <a href="/">← Inicio</a>
        <span>/</span>
        <span>
          {title} {accent}
        </span>
      </nav>
      <p class="legal__eyebrow">
        <span></span>ScentScape · Legal
      </p>
      <h1 class="legal__title">
        <span class="legal__mask">
          <span>
            {title} <em>{accent}</em>
          </span>
        </span>
      </h1>
      <p class="legal__updated">{updated}</p>
    </div>
  </header>
  <article class="legal__body">
    <slot />
  </article>
</main>

<style>
  .legal {
    background: var(--navy);
  }

  .legal__hero {
    position: relative;
    overflow: hidden;
    padding: clamp(130px, 13vw, 180px) var(--gutter) clamp(50px, 6vw, 80px);
    border-bottom: 1px solid rgb(var(--peach-rgb) / 0.15);
    background:
      radial-gradient(ellipse 60% 80% at 80% 30%, rgb(var(--wine-rgb) / 0.45), transparent 70%),
      var(--navy-deep);
  }

  .legal__word {
    position: absolute;
    left: 0;
    bottom: -0.25em;
    color: transparent;
    font: italic 400 clamp(140px, 18vw, 320px) / 1 var(--font-serif);
    white-space: nowrap;
    -webkit-text-stroke: 1px rgb(var(--peach-rgb) / 0.1);
    transform: translateX(4vw);
    transition: transform 2.4s var(--ease);
    pointer-events: none;
  }

  .legal:global(.is-in) .legal__word {
    transform: translateX(-12vw);
  }

  .legal__hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 900px;
    margin: 0 auto;
  }

  .legal__crumbs,
  .legal__eyebrow,
  .legal__updated {
    opacity: 0;
    transition: opacity 0.8s 0.6s;
  }

  .legal:global(.is-in) .legal__crumbs,
  .legal:global(.is-in) .legal__eyebrow,
  .legal:global(.is-in) .legal__updated {
    opacity: 1;
  }

  .legal__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font: 400 11px var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .legal__crumbs span {
    color: rgb(var(--cream-rgb) / 0.5);
  }

  .legal__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    color: var(--peach);
    font: 400 10px var(--font-sans);
    letter-spacing: 5px;
    text-transform: uppercase;
  }

  .legal__eyebrow span {
    width: 40px;
    height: 1px;
    background: var(--peach);
  }

  .legal__title {
    margin: 0;
    font: 400 clamp(48px, 6vw, 100px) / 1 var(--font-serif);
  }

  .legal__mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .legal__mask > span {
    display: block;
    transform: translateY(110%);
    transition: transform 1.1s var(--ease) 0.3s;
  }

  .legal:global(.is-in) .legal__mask > span {
    transform: none;
  }

  .legal__title em {
    color: var(--peach);
  }

  .legal__updated {
    margin: 0;
    color: rgb(var(--cream-rgb) / 0.55);
    font: 400 13px/1.5 var(--font-sans);
  }

  .legal__body {
    max-width: calc(900px + var(--gutter) * 2);
    margin: 0 auto;
    padding: clamp(50px, 6vw, 90px) var(--gutter) clamp(80px, 9vw, 130px);
    color: rgb(var(--cream-rgb) / 0.8);
    font: 300 16px/1.75 var(--font-sans);
  }

  .legal__body :global(h2) {
    margin: 48px 0 16px;
    color: var(--cream);
    font: 400 clamp(26px, 2.6vw, 36px) / 1.15 var(--font-serif);
  }

  .legal__body :global(h2:first-child) {
    margin-top: 0;
  }

  .legal__body :global(h3) {
    margin: 26px 0 10px;
    color: var(--peach);
    font: 500 11px/1.4 var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .legal__body :global(p) {
    margin: 0 0 14px;
  }

  .legal__body :global(ul) {
    margin: 0 0 16px;
    padding-left: 22px;
  }

  .legal__body :global(li) {
    margin-bottom: 8px;
  }

  .legal__body :global(li::marker) {
    color: var(--peach);
  }

  .legal__body :global(strong) {
    color: var(--cream);
    font-weight: 500;
  }
</style>
