---
import StarPicker from '../../components/review/StarPicker.astro';
import Icon from '../../components/ui/Icon.astro';
import { REVIEW_MAX_LENGTH } from '../../data/reviews.js';

/** @typedef {{ productNames: string[] }} Props */
const { productNames } = Astro.props;
---

<div class="review-form frame hatch" data-review-box>
  <form class="review-form__form" data-review-form novalidate>
    <div class="review-form__field">
      <p class="review-form__step" id="review-rating-label">
        01 — Calificación
      </p>
      <StarPicker />
    </div>
    <label class="review-form__field">
      <span class="review-form__step">
        02 — Perfume <span class="review-form__optional">(opcional)</span>
      </span>
      <input
        class="review-form__input"
        name="product"
        list="review-products"
        placeholder="Busca tu perfume…"
        autocomplete="off"
      />
      <datalist id="review-products">
        {productNames.map((name) => (
          <option value={name} />
        ))}
      </datalist>
    </label>
    <label class="review-form__field">
      <span class="review-form__step">03 — Tu reseña</span>
      <textarea
        class="review-form__input review-form__text"
        name="text"
        rows="4"
        maxlength={REVIEW_MAX_LENGTH}
        placeholder="¿Cómo huele? ¿Cuánto dura? ¿Para qué ocasión lo usas?"
      ></textarea>
      <span class="review-form__count">
        <span data-review-count>0</span> / {REVIEW_MAX_LENGTH}
      </span>
    </label>
    <div class="review-form__field">
      <p class="review-form__step">04 — Tú</p>
      <div class="review-form__row">
        <input
          class="review-form__input"
          name="name"
          placeholder="Nombre"
          aria-label="Nombre"
          autocomplete="name"
        />
        <input
          class="review-form__input"
          name="phone"
          type="tel"
          inputmode="tel"
          placeholder="WhatsApp / teléfono"
          aria-label="WhatsApp / teléfono"
          autocomplete="tel"
        />
      </div>
    </div>
    <p class="review-form__error" data-review-error role="alert" hidden></p>
    <button class="btn btn--primary btn--lg review-form__submit" type="submit" data-review-submit>
      Enviar reseña →
    </button>
    <p class="review-form__privacy">
      <Icon name="lock" size={14} />
      Tu teléfono solo sirve para verificar tu reseña. Nunca se muestra públicamente.
    </p>
  </form>
  <div class="review-form__thanks" data-review-thanks hidden>
    <h2 class="display display--sm">
      Gracias, <em data-review-thanks-name></em>
    </h2>
    <p>Tu reseña quedó registrada. ¡Gracias por ayudar a otras personas a elegir!</p>
    <button class="btn btn--outline" type="button" data-review-again>
      Escribir otra reseña
    </button>
  </div>
</div>

<style>
  .review-form {
    padding: clamp(24px, 4vw, 48px);
    border-radius: 0;
  }

  .review-form__form {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .review-form__field {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .review-form__step {
    margin: 0;
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--peach);
  }

  .review-form__optional {
    color: rgb(var(--white-rgb) / 0.45);
    text-transform: none;
    letter-spacing: 0;
  }

  .review-form__input {
    height: 54px;
    padding: 0 20px;
    border-radius: 14px;
    border: 1px solid rgb(var(--peach-rgb) / 0.3);
    background: rgb(var(--white-rgb) / 0.04);
    font: 500 15px/1 var(--font-sans);
    outline: none;
  }

  .review-form__input:focus {
    border-color: var(--peach);
  }

  .review-form__text {
    height: auto;
    padding: 16px 20px;
    font: 400 15px/1.5 var(--font-sans);
    resize: vertical;
  }

  .review-form__count {
    align-self: flex-end;
    font: 500 12px/1 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.45);
  }

  .review-form__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 12px;
  }

  .review-form__error {
    margin: 0;
    padding: 14px 18px;
    border-radius: 14px;
    background: rgb(97 3 27 / 0.55);
    font: 500 14px/1.45 var(--font-sans);
    color: var(--sand);
  }

  .review-form__submit {
    align-self: flex-start;
  }

  .review-form__privacy {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font: 500 12px/1.4 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.55);
  }

  .review-form__thanks {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    animation: fade-in 0.5s var(--ease);
  }

  .review-form__thanks p {
    margin: 0;
    font: 400 16px/1.6 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.78);
  }
</style>
