---
/**
 * Gemeinsamer Rahmen für Términos und Privacidad. Der Text kommt als Slot.
 * @typedef {{ title: string, accent: string, updated: string }} Props
 */
const { title, accent, updated } = Astro.props;
---

<main class="legal">
  <header class="legal__hero hatch">
    <div class="legal__hero-inner">
      <p class="eyebrow legal__eyebrow">ScentScape · Legal</p>
      <h1 class="display display--lg">
        {title} <em>{accent}</em>
      </h1>
      <p class="legal__updated">{updated}</p>
    </div>
  </header>
  <article class="legal__body">
    <slot />
  </article>
</main>

<style>
  .legal__hero {
    padding: clamp(130px, 13vw, 180px) var(--gutter) clamp(50px, 6vw, 80px);
    border-bottom: 1px solid rgb(var(--peach-rgb) / 0.15);
  }

  .legal__hero-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .legal__eyebrow {
    margin-bottom: 20px;
  }

  .legal__updated {
    margin: 22px 0 0;
    font: 500 13px/1.5 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.55);
  }

  .legal__body {
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(50px, 6vw, 90px) var(--gutter) clamp(80px, 9vw, 130px);
    font: 400 16px/1.75 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.8);
  }

  .legal__body :global(h2) {
    margin: 48px 0 16px;
    font: 500 clamp(26px, 2.6vw, 34px) / 1.15 var(--font-serif);
    color: var(--white);
  }

  .legal__body :global(h2:first-child) {
    margin-top: 0;
  }

  .legal__body :global(h3) {
    margin: 26px 0 10px;
    font: 600 12px/1.4 var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--peach);
  }

  .legal__body :global(p) {
    margin: 0 0 14px;
  }

  .legal__body :global(ul) {
    margin: 0 0 16px;
    padding-left: 22px;
  }

  .legal__body :global(li) {
    margin-bottom: 8px;
  }

  .legal__body :global(li::marker) {
    color: var(--peach);
  }

  .legal__body :global(strong) {
    color: var(--white);
  }
</style>
