---
/* "Más que una compra": der Satz steigt Wort für Wort aus einer Maske, die letzten Wörter kursiv. */
import { RITUAL_INTRO, RITUAL_INTRO_ITALIC, RITUAL_TRUST } from '../../data/ritual.js';

const all = RITUAL_INTRO.split(' ');
const words = all.map((word, index) => ({
  word,
  italic: index >= all.length - RITUAL_INTRO_ITALIC,
  style: `--d:${150 + index * 55}ms`,
}));
---

<section class="ritual-intro" data-reveal="intro">
  <div class="ritual-intro__inner">
    <p class="ritual-eyebrow">
      <span></span>Más que una compra<span></span>
    </p>
    <p class="ritual-intro__line" aria-label={RITUAL_INTRO}>
      {words.map((item) => (
        <span class="ritual-intro__mask" aria-hidden="true">
          <span class:list={{ 'is-italic': item.italic }} style={item.style}>
            {item.word}
          </span>
        </span>
      ))}
    </p>
    <div class="ritual-intro__trust">
      {RITUAL_TRUST.map((item) => (
        <span>
          <i></i>
          {item}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .ritual-intro {
    padding: clamp(80px, 14vh, 150px) clamp(20px, 6vw, 110px);
    background: var(--navy-ink);
    text-align: center;
  }

  .ritual-intro__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    max-width: 820px;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 0.9s,
      transform 1.1s var(--ease);
  }

  .ritual-intro:global(.is-revealed) .ritual-intro__inner {
    opacity: 1;
    transform: none;
  }

  .ritual-intro__line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.26em;
    margin: 0;
    color: var(--cream);
    font: 400 clamp(28px, 3vw, 44px) / 1.2 var(--font-serif);
  }

  .ritual-intro__mask {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.1em;
  }

  .ritual-intro__mask span {
    display: inline-block;
    transform: translateY(110%);
    transition: transform 1s var(--ease) var(--d);
  }

  .ritual-intro__mask .is-italic {
    color: var(--peach);
    font-style: italic;
  }

  .ritual-intro:global(.is-revealed) .ritual-intro__mask span {
    transform: none;
  }

  .ritual-intro__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 34px;
  }

  .ritual-intro__trust span {
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgb(var(--cream-rgb) / 0.62);
    font: 500 9px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .ritual-intro__trust i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--peach);
  }
</style>
