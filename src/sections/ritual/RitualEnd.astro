---
/* Abschluss in Burdeos: "¿Listo para vivir el ritual?" */
import { WHATSAPP_NUMBER } from '../../scripts/config.js';
---

<section class="ritual-end" data-reveal="end">
  <div class="ritual-end__inner">
    <h2 class="ritual-end__title">
      ¿Listo para vivir el <em>ritual</em>?
    </h2>
    <p>Elige tu fragancia y nosotros nos encargamos del resto.</p>
    <div class="ritual-actions ritual-end__actions">
      <a class="ritual-btn ritual-btn--solid" href="/productos/">
        Elige tu fragancia <span>→</span>
      </a>
      <a
        class="ritual-btn ritual-btn--outline"
        href={`https://wa.me/${WHATSAPP_NUMBER}`}
        target="_blank"
        rel="noopener"
      >
        Escríbenos
      </a>
    </div>
  </div>
</section>

<style>
  .ritual-end {
    padding: clamp(80px, 14vh, 140px) clamp(20px, 6vw, 110px);
    background:
      radial-gradient(ellipse 55% 90% at 35% 30%, #6a1422, transparent 70%),
      linear-gradient(120deg, #58101c, #3a0812 80%, #2a0510);
    text-align: center;
  }

  .ritual-end__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    max-width: 760px;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 0.9s,
      transform 1.1s var(--ease);
  }

  .ritual-end:global(.is-revealed) .ritual-end__inner {
    opacity: 1;
    transform: none;
  }

  .ritual-end__title {
    margin: 0;
    color: var(--cream);
    font: 400 clamp(42px, 4.8vw, 76px) / 1.02 var(--font-serif);
    text-wrap: balance;
    transform: scale(0.9);
    transition: transform 1.6s var(--ease);
  }

  .ritual-end:global(.is-revealed) .ritual-end__title {
    transform: none;
  }

  .ritual-end__title em {
    color: var(--peach);
  }

  .ritual-end p {
    margin: 0;
    color: rgb(var(--cream-rgb) / 0.78);
    font: 300 14px/1.6 var(--font-sans);
  }

  .ritual-end__actions {
    margin-top: 14px;
  }
</style>
