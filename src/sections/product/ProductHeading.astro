---
import NoteChip from '../../components/product/NoteChip.astro';
import NoteMark from '../../components/ui/NoteMark.astro';
import { accentOf, eyebrowOf } from '../../scripts/catalog/theme.js';

/** @typedef {{ product: object }} Props */
const { product } = Astro.props;
const color = accentOf(product) === '#61031b' ? '#f0be91' : accentOf(product);
const chip = product.family ?? product.brand;
const openingNotes = product.notes ? product.notes[0].slice(0, 3) : [];
---

<nav class="crumbs" aria-label="Ruta">
  <a href="/">Inicio</a>
  <span>/</span>
  <a href="/productos/">Productos</a>
  <span>/</span>
  <span class="crumbs__current">{product.name}</span>
</nav>
<div class="chips">
  {chip && (
    <span class="chips__family">
      <NoteMark name={chip} color={color} size={26} />
      {chip}
    </span>
  )}
  <span class="chips__eyebrow">{eyebrowOf(product)}</span>
</div>
<h1 class="product-title">{product.name}</h1>
{openingNotes.length > 0 && (
  <div class="opening">
    <span class="opening__label">Abre con</span>
    {openingNotes.map((note) => (
      <NoteChip note={note} color={color} />
    ))}
  </div>
)}

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
    font: 500 12px/1 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.55);
  }

  .crumbs a {
    color: rgb(var(--white-rgb) / 0.7);
  }

  .crumbs__current {
    color: var(--peach);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .chips__family,
  .chips__eyebrow {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    background: rgb(var(--navy-deep-rgb) / 0.4);
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .chips__family {
    gap: 8px;
    padding-left: 5px;
    border: 1px solid var(--line);
    font-weight: 700;
    color: var(--sand);
  }

  .product-title {
    margin: 0 0 22px;
    font: 500 clamp(48px, 6vw, 96px) / 0.9 var(--font-serif);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .opening {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 30px;
  }

  .opening__label {
    font: italic 400 20px/1 var(--font-serif);
    color: rgb(var(--white-rgb) / 0.8);
  }
</style>
