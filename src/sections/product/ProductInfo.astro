---
/*
 * Rechte Seite: Pfad, Titel mit Buchstaben-Einblendung, Marke, Bewertung, Familien, Kaufbereich, Akkordeon.
 * Handy: Marke über dem Namen, kompakter, dazu Versprechen (ProductTrust) und Noten (ProductNotes).
 */
import AccordionItem from '../../components/product/AccordionItem.astro';
import BuyCard from '../../components/product/BuyCard.astro';
import PaymentLogos from '../../components/product/PaymentLogos.astro';
import ProductKind from '../../components/product/ProductKind.astro';
import ProductNotes from '../../components/product/ProductNotes.astro';
import ProductRating from '../../components/product/ProductRating.astro';
import ProductTrust from '../../components/product/ProductTrust.astro';
import { ORIGINAL_ITEMS, SHIPPING_ITEMS } from '../../data/product.js';
import { labelOf } from '../../scripts/catalog/theme.js';

/** @typedef {{ product: object, reviews: object[], images: Record<string, string> }} Props */
const { product, reviews, images } = Astro.props;
const letters = [...product.name];
const description =
  product.plainDescription || 'Pronto agregaremos la descripción de esta fragancia.';
/* Handy: lange Beschreibungen erst gekürzt, mit "Leer más" (scripts/features/product/more.js) */
const isLong = description.length > 220;
---

<div class="info">
  <nav class="info__crumbs" aria-label="Ruta">
    <a href="/productos/">← Productos</a>
    <span>/</span>
    <span class="info__here">{product.name}</span>
  </nav>
  <div class="info__head">
    <p class="info__eyebrow">
      <span></span>
      {labelOf(product)}
    </p>
    <h1 class="info__title" aria-label={product.name}>
      {letters.map((letter, index) => (
        <span class="info__letter" aria-hidden="true">
          <span style={`--d:${1100 + index * 40}ms`}>{letter}</span>
        </span>
      ))}
    </h1>
    <ProductKind product={product} />
    <div class="info__meta">
      {product.brand && <span class="info__brand">{product.brand}</span>}
      <div class="info__facts">
        <ProductRating reviews={reviews} />
        <div class="info__family">
          <span class="info__family-label">Familia</span>
          <span class="info__chips">
            {product.scentFamilies.map((family) => (
              <span>{family}</span>
            ))}
          </span>
        </div>
      </div>
    </div>
  </div>
  <div class="info__buy">
    <BuyCard product={product} />
  </div>
  <ProductTrust />
  <ProductNotes notes={product.ingredients} images={images} />
  <div class="info__acc" data-accordion>
    <AccordionItem number="01" title="Descripción" open>
      <p class="info__text" data-more-text>
        {description}
      </p>
      {isLong && (
        <button class="info__more" type="button" aria-expanded="false" data-more-toggle>
          Leer más
        </button>
      )}
    </AccordionItem>
    <AccordionItem number="02" title="Envíos y pagos">
      <ul class="info__list">
        {SHIPPING_ITEMS.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <PaymentLogos />
    </AccordionItem>
    <AccordionItem number="03" title="Original garantizado">
      <ul class="info__list">
        {ORIGINAL_ITEMS.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <a class="info__link" href="/original/">
        Verifica tu perfume →
      </a>
    </AccordionItem>
  </div>
</div>

<style>
  .info {
    display: flex;
    flex-direction: column;
    gap: 30px;
    min-width: 0;
    padding: 6vh 24px 10vh;
  }

  .info__crumbs,
  .info__eyebrow,
  .info__meta,
  .info__acc,
  .info > :global(.trust),
  .info > :global(.notes) {
    opacity: 0;
    transition: opacity 0.8s var(--fade-delay, 1.3s);
  }

  /* Versprechen und Noten (nur Handy) erscheinen kurz nach dem Kaufbereich */
  .info > :global(.trust),
  .info > :global(.notes) {
    --fade-delay: 2.1s;
  }

  .info__crumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 400 11px var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .info__crumbs span {
    color: rgb(var(--cream-rgb) / 0.35);
  }

  .info__crumbs .info__here {
    color: rgb(var(--cream-rgb) / 0.7);
  }

  .info__eyebrow {
    --fade-delay: 1.4s;
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 16px;
    color: var(--peach);
    font: 400 10px var(--font-sans);
    letter-spacing: 5px;
    text-transform: uppercase;
  }

  .info__eyebrow span {
    display: block;
    width: 0;
    height: 1px;
    background: var(--peach);
    transition: width 1s var(--ease) 1.4s;
  }

  .info__title {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    font: 400 clamp(44px, 5vw, 88px) / 1 var(--font-serif);
  }

  .info__letter {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .info__letter span {
    display: inline-block;
    white-space: pre;
    transform: translateY(110%);
    transition: transform 1s var(--ease) var(--d);
  }

  .info__meta {
    --fade-delay: 1.7s;
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 20px;
  }

  .info__brand {
    color: var(--sand);
    font: italic 400 clamp(30px, calc(1.8vw + 8px), 36px) / 1.1 var(--font-serif);
  }

  .info__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 14px 0;
    padding: 14px 0;
    border-top: 1px solid rgb(var(--peach-rgb) / 0.16);
    border-bottom: 1px solid rgb(var(--peach-rgb) / 0.16);
  }

  .info__family {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .info__family-label {
    color: rgb(var(--cream-rgb) / 0.55);
    font: 500 9px var(--font-sans);
    letter-spacing: 3.5px;
    text-transform: uppercase;
  }

  .info__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .info__chips span {
    padding: 6px 12px;
    border: 1px solid rgb(var(--peach-rgb) / 0.3);
    border-radius: 14px;
    color: var(--peach);
    font: 500 9px var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .info__buy {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.9s 1.9s,
      transform 1.1s var(--ease) 1.9s;
  }

  .info__acc {
    --fade-delay: 2.2s;
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgb(var(--peach-rgb) / 0.22);
  }

  .info__text {
    margin: 0;
    color: rgb(var(--cream-rgb) / 0.82);
    font: 300 15px/1.8 var(--font-sans);
    white-space: pre-line;
  }

  /* "Leer más" gibt es nur auf dem Handy, auf dem Desktop steht die ganze Beschreibung */
  .info__more {
    display: none;
  }

  .info__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .info__list li {
    display: flex;
    gap: 12px;
    color: rgb(var(--cream-rgb) / 0.82);
    font: 300 15px/1.6 var(--font-sans);
  }

  .info__list li::before {
    content: '—';
    color: var(--peach);
  }

  .info__link {
    align-self: flex-start;
    padding-bottom: 3px;
    border-bottom: 1px solid rgb(var(--peach-rgb) / 0.5);
    color: var(--peach);
    font: 500 11px var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  :global(.is-in) .info__crumbs,
  :global(.is-in) .info__eyebrow,
  :global(.is-in) .info__meta,
  :global(.is-in) .info__acc,
  :global(.is-in) .info > :global(.trust),
  :global(.is-in) .info > :global(.notes),
  :global(.is-in) .info__buy {
    opacity: 1;
    transform: none;
  }

  :global(.is-in) .info__eyebrow span {
    width: 40px;
  }

  :global(.is-in) .info__letter span {
    transform: none;
  }

  @media (min-width: 900px) {
    .info {
      padding: 130px clamp(30px, 4.5vw, 80px) 12vh;
    }
  }

  /*
   * Handy: alles Wichtige kompakt untereinander.
   * Reihenfolge im Kopf: Marke, Name, "Perfume para …", Bewertung und Familien.
   */
  @media (max-width: 899px) {
    .info {
      gap: 22px;
      padding: 18px 16px 8vh;
    }

    .info__head {
      display: flex;
      flex-direction: column;
    }

    .info__meta {
      display: contents;
    }

    .info__brand {
      order: -1;
      margin-bottom: 8px;
      color: var(--peach);
      font: 500 11px/1.3 var(--font-sans);
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    .info__title {
      font-size: 38px;
    }

    /* Statt Eyebrow und Familien-Zeile: "Perfume [Oriental] para Dama" (ProductKind) */
    .info__eyebrow,
    .info__family {
      display: none;
    }

    /* Bewertung (nur wenn vorhanden) darunter */
    .info__facts {
      order: 2;
      margin-top: 14px;
      padding: 0;
      border: 0;
    }

    .info__facts:not(:has(a)) {
      display: none;
    }

    /* Beschreibung: erst 4 Zeilen, unten weich ausgeblendet; "Leer más" zeigt alles */
    .info__text:not(.is-open):has(+ .info__more) {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 4;
      mask-image: linear-gradient(180deg, #000 55%, transparent);
    }

    .info__more {
      display: block;
      align-self: flex-start;
      margin-top: 10px;
      padding: 0 0 3px;
      border: 0;
      border-bottom: 1px solid rgb(var(--peach-rgb) / 0.5);
      background: none;
      color: var(--peach);
      font: 500 11px var(--font-sans);
      letter-spacing: 2px;
      text-transform: uppercase;
    }
  }

  /* Handy und Tablet hochkant: kein Pfad ("← Inicio / …"), zurück geht über Browser oder Wischen */
  @media (max-width: 1079px) and (orientation: portrait), (max-width: 899px) {
    .info__crumbs {
      display: none;
    }
  }
</style>
