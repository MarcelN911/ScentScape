---
import SizeOption from '../../components/product/SizeOption.astro';
import { ADDI_ENABLED } from '../../scripts/config.js';
import { cartItemJson } from '../../scripts/cart/cart-item.js';
import { effectivePrice } from '../../scripts/catalog/sizes.js';
import { formatCOP } from '../../scripts/utils/format.js';
import { whatsappUrl } from '../../scripts/utils/whatsapp.js';

/** @typedef {{ product: object }} Props */
const { product } = Astro.props;
const first = product.sizes[0];
const askMessage = `Hola ScentScape, me interesa ${product.name} (${first.label}).`;
---

<div class="buy" data-buy data-product-name={product.name}>
  <p class="buy__label">Elige tu tamaño</p>
  <div class="buy__sizes">
    {product.sizes.map((size, index) => (
      <SizeOption product={product} size={size} index={index} />
    ))}
  </div>
  <div class="buy__price-row">
    <span class="buy__price" data-buy-price>
      {formatCOP(effectivePrice(first))} <small>COP</small>
    </span>
    <div class="buy__qty">
      <button type="button" data-qty-change="-1" aria-label="Reducir cantidad">
        −
      </button>
      <span data-buy-qty>1</span>
      <button type="button" data-qty-change="1" aria-label="Aumentar cantidad">
        +
      </button>
    </div>
  </div>
  <div class="buy__actions" data-buy-row>
    <button
      class="buy__add"
      type="button"
      data-action="add-to-cart"
      data-buy-add
      data-cart-item={cartItemJson(product, first)}
    >
      <span class="buy__shine" aria-hidden="true"></span>
      <span class="buy__add-label" data-buy-add-label>
        Añadir al carrito
      </span>
    </button>
    <a
      class="buy__whatsapp"
      href={whatsappUrl(askMessage)}
      target="_blank"
      rel="noopener"
      aria-label="Preguntar por WhatsApp"
      data-buy-whatsapp
    >
      <img src="/assets/img/whatsapp_white.svg" alt="" width="24" height="24" />
    </a>
  </div>
  {ADDI_ENABLED && (
    <p class="buy__addi">
      <span>Addi</span>Llévalo en 4 cuotas con Addi · <b data-buy-addi /> c/u
    </p>
  )}
</div>

<style>
  .buy__label {
    margin: 0 0 12px;
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .buy__sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 26px;
  }

  .buy__price-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 18px;
  }

  .buy__price {
    display: inline-block;
    font: 500 clamp(34px, 3.4vw, 48px) / 1 var(--font-serif);
    letter-spacing: -0.015em;
    color: var(--sand);
  }

  .buy__price.is-updated {
    animation: fade-in 0.7s var(--ease);
  }

  .buy__price small {
    font: 600 14px/1 var(--font-sans);
    letter-spacing: 1px;
    color: rgb(var(--white-rgb) / 0.55);
  }

  .buy__qty {
    display: flex;
    align-items: center;
    height: 52px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(var(--white-rgb) / 0.14);
    background: rgb(var(--navy-deep-rgb) / 0.35);
  }

  .buy__qty button {
    width: 52px;
    height: 100%;
    border: 0;
    background: none;
    color: var(--white);
    font-size: 20px;
  }

  .buy__qty span {
    min-width: 30px;
    text-align: center;
    font: 700 16px/1 var(--font-sans);
  }

  .buy__actions {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    margin-bottom: 16px;
  }

  .buy__add {
    position: relative;
    height: 64px;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--peach);
    color: var(--navy);
    font: 800 17px/1 var(--font-sans);
    transition:
      background 0.4s,
      transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1.5);
  }

  .buy__add.is-added {
    background: var(--sand);
    transform: scale(0.97) rotate(-1deg);
  }

  .buy__shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      110deg,
      transparent 35%,
      rgb(255 255 255 / 0.5) 50%,
      transparent 65%
    );
    animation: shine 3.6s ease-in-out infinite;
    pointer-events: none;
  }

  .buy__add-label {
    position: relative;
  }

  .buy__whatsapp {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--whatsapp);
  }

  .buy__addi {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 0 0 16px;
    font: 500 14px/1.3 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.85);
  }

  .buy__addi span {
    padding: 6px 11px;
    border-radius: var(--radius-pill);
    background: var(--sand);
    color: var(--navy);
    font: 800 11px/1 var(--font-sans);
  }
</style>
