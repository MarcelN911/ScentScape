---
import PyramidTier from '../../components/product/PyramidTier.astro';
import { NOTE_TIERS } from '../../data/families.js';
import { accentOf } from '../../scripts/catalog/theme.js';

/** @typedef {{ product: object }} Props */
const { product } = Astro.props;
const color = accentOf(product);
---

<section class="container pyramid" data-pyramid style={`--accent:${color}`}>
  <h2 class="pyramid__title">
    <span class="line-mask">
      <span data-reveal="mask">Pirámide</span>
    </span>
    <span class="line-mask">
      <em data-reveal="mask">olfativa</em>
    </span>
  </h2>
  <div class="pyramid__tiers">
    {product.notes.map((notes, index) => (
      <PyramidTier tier={NOTE_TIERS[index]} notes={notes} index={index} color={color} />
    ))}
  </div>
</section>

<style>
  .pyramid {
    padding-top: 40px;
    padding-bottom: 90px;
  }

  .pyramid__title {
    margin: 0 0 26px;
    font: 500 clamp(40px, 5vw, 80px) / 0.92 var(--font-serif);
    letter-spacing: -0.015em;
  }

  .pyramid__title span,
  .pyramid__title em {
    display: inline-block;
  }

  .pyramid__title .line-mask {
    display: block;
  }

  .pyramid__title em {
    font: italic 400 1.05em/1 var(--font-serif);
    letter-spacing: 0;
    color: var(--peach);
  }

  .pyramid__tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 16px;
  }
</style>
