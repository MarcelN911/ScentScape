---
import GallerySlide from '../../components/product/GallerySlide.astro';
import GalleryThumb from '../../components/product/GalleryThumb.astro';
import { GALLERY_SLIDES } from '../../data/product.js';
import { accentOf, themeOf, topNotesOf } from '../../scripts/catalog/theme.js';
import { imageUrl } from '../../scripts/utils/image.js';

/** @typedef {{ product: object }} Props */
const { product } = Astro.props;
const image = imageUrl(product.images[0], 1400);
const thumbImage = imageUrl(product.images[0], 300);
const notes = topNotesOf(product, 6);
const color = accentOf(product) === '#61031b' ? '#f0be91' : accentOf(product);
const slideProps = { image, alt: product.name, cover: product.hasCoverPhoto, notes, color };
---

<div class="gallery" data-gallery style={`--accent:${accentOf(product)}`}>
  <div class="gallery__stage" data-gallery-stage data-cursor="Ampliar">
    {!product.hasCoverPhoto && (
      <div
        class:list={['gallery__scene', `gallery__scene--${themeOf(product)}`]}
        aria-hidden="true"
      />
    )}
    {GALLERY_SLIDES.map((slide, index) => (
      <GallerySlide slide={slide} index={index} {...slideProps} />
    ))}
    <div class="gallery__top">
      <div class="gallery__progress">
        {GALLERY_SLIDES.map(() => (
          <span class="gallery__segment">
            <span data-gallery-segment></span>
          </span>
        ))}
      </div>
      <div class="gallery__row">
        <a class="gallery__pill gallery__back" href="/productos/">
          ← Colección
        </a>
        <span class="gallery__pill" data-gallery-hint>
          Clic para ampliar
        </span>
      </div>
    </div>
    <div class="gallery__controls">
      <button class="icon-btn gallery__arrow" type="button" data-gallery-prev aria-label="Anterior">
        ←
      </button>
      <button
        class="icon-btn gallery__arrow"
        type="button"
        data-gallery-next
        aria-label="Siguiente"
      >
        →
      </button>
      <span class="gallery__label" data-gallery-label>
        {GALLERY_SLIDES[0].label}
      </span>
    </div>
  </div>
  <div class="gallery__thumbs">
    {GALLERY_SLIDES.map((slide, index) => (
      <GalleryThumb
        slide={slide}
        index={index}
        image={thumbImage}
        firstNote={notes[0] ?? product.name}
        color={color}
      />
    ))}
  </div>
</div>

<style>
  .gallery {
    position: sticky;
    top: 92px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .gallery__stage {
    position: relative;
    height: min(74vh, 720px);
    min-height: 420px;
    overflow: hidden;
    border-radius: 36px;
    border: 1px solid rgb(var(--white-rgb) / 0.08);
    background: rgb(var(--navy-deep-rgb) / 0.3);
    cursor: grab;
    user-select: none;
    touch-action: pan-y;
  }

  [data-zoomed] .gallery__stage {
    cursor: zoom-out;
  }

  .gallery__scene {
    position: absolute;
    inset: 0;
    background: var(--scene-wall);
  }

  .gallery__scene::before {
    content: '';
    position: absolute;
    inset: -10%;
    background: var(--scene-beam);
    mix-blend-mode: screen;
    filter: blur(6px);
    opacity: 0.75;
  }

  .gallery__scene::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: var(--scene-floor);
    box-shadow: 0 -1px 0 rgb(255 255 255 / 0.18);
  }

  .gallery__scene--oro {
    --scene-wall: radial-gradient(
      ellipse 90% 70% at 72% 8%,
      #fbe7c2 0%,
      #d9ad72 30%,
      #8c6236 70%,
      #3e2914 100%
    );
    --scene-beam: linear-gradient(
      118deg,
      transparent 30%,
      rgb(255 236 200 / 0.55) 44%,
      rgb(255 236 200 / 0.1) 54%,
      transparent 64%
    );
    --scene-floor: linear-gradient(180deg, #c49863 0%, #e9cb9a 18%, #a77a49 60%, #5d3f22 100%);
  }

  .gallery__scene--rosa {
    --scene-wall: radial-gradient(
      ellipse 90% 70% at 30% 10%,
      #fde6d8 0%,
      #efc0a6 34%,
      #c48a74 72%,
      #6e4438 100%
    );
    --scene-beam: linear-gradient(
      62deg,
      transparent 32%,
      rgb(255 240 228 / 0.6) 46%,
      transparent 62%
    );
    --scene-floor: linear-gradient(180deg, #e7b9a0 0%, #f5d8c6 20%, #cf9c84 100%);
  }

  .gallery__scene--vino {
    --scene-wall: radial-gradient(
      ellipse 90% 70% at 70% 10%,
      #b44a5a 0%,
      #7a1428 35%,
      #4a0814 70%,
      #1e040a 100%
    );
    --scene-beam: linear-gradient(
      115deg,
      transparent 32%,
      rgb(240 190 145 / 0.38) 46%,
      transparent 62%
    );
    --scene-floor: linear-gradient(180deg, #5c0d1d 0%, #8a2a3a 18%, #3a0610 100%);
  }

  .gallery__top {
    position: absolute;
    top: 18px;
    left: 18px;
    right: 18px;
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .gallery__progress {
    display: flex;
    gap: 6px;
  }

  .gallery__segment {
    flex: 1;
    height: 3px;
    overflow: hidden;
    border-radius: 2px;
    background: rgb(var(--white-rgb) / 0.2);
  }

  .gallery__segment span {
    display: block;
    width: var(--fill, 0%);
    height: 100%;
    border-radius: 2px;
    background: var(--peach);
  }

  .gallery__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  .gallery__pill {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 16px;
    border-radius: var(--radius-pill);
    background: rgb(var(--navy-deep-rgb) / 0.5);
    backdrop-filter: blur(10px);
    font: 600 11px/1 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.8);
  }

  .gallery__back {
    font-size: 12px;
    color: var(--white);
  }

  .gallery__controls {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .gallery__arrow {
    --icon-btn-size: 50px;
    border: 1px solid rgb(var(--white-rgb) / 0.3);
    background: rgb(var(--navy-deep-rgb) / 0.45);
    backdrop-filter: blur(10px);
    color: var(--white);
    font-size: 18px;
  }

  .gallery__arrow:hover {
    background: var(--peach);
    color: var(--navy);
  }

  .gallery__label {
    margin-left: 6px;
    font: italic 400 20px/1 var(--font-serif);
  }

  .gallery__thumbs {
    display: flex;
    gap: 10px;
  }

  @media (max-width: 960px) {
    .gallery {
      position: relative;
      top: 0;
    }
  }
</style>

<script>
  import { onPage } from '../../scripts/core/lifecycle.js';
  import { initGallery } from '../../scripts/features/product/gallery.js';

  onPage(initGallery);
</script>
