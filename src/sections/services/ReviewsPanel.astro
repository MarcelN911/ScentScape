---
/*
 * Erster Bildschirm von "Servicios": Titel "Reseñas" links, rechts ein Karussell echter Bewertungen.
 * Pfeile gedrückt halten dreht schneller, Punkte springen zu einer Karte. Bedienung: scripts/features/services/panel.js
 */
import PanelCard from '../../components/services/PanelCard.astro';

/** @typedef {{ reviews: object[] }} Props */
const { reviews } = Astro.props;
const cards = reviews.slice(0, 8);
---

<section class="panel">
  <div class="panel__word" aria-hidden="true">
    Reseñas · Reseñas ·
  </div>
  <div class="panel__grid">
    <div class="panel__text">
      <p class="panel__eyebrow">
        <span></span>Tu opinión
      </p>
      <h1 class="panel__title">
        <span class="panel__mask">
          <span>Reseñas</span>
        </span>
      </h1>
      <p class="panel__lead">
        Cuéntanos tu experiencia y califica tu fragancia. Tu opinión ayuda a otros clientes a
        elegir.
      </p>
      <div class="panel__actions">
        <a class="panel__cta" href="/resenas/#escribir">
          Escribir reseña <span>→</span>
        </a>
        <a class="panel__all" href="/resenas/">
          Ver todas
        </a>
      </div>
    </div>
    {cards.length > 0 && (
      <div class="panel__visual" data-panel>
        <div class="panel__cards" data-panel-cards>
          {cards.map((review) => (
            <PanelCard review={review} />
          ))}
        </div>
        <div class="panel__controls">
          <button
            class="panel__arrow"
            type="button"
            aria-label="Hacia la izquierda"
            data-panel-hold="-1"
          >
            ←
          </button>
          <div class="panel__dots">
            {cards.map((_, index) => (
              <button
                type="button"
                aria-label={`Reseña ${index + 1}`}
                data-panel-dot={index}
              ></button>
            ))}
          </div>
          <button
            class="panel__arrow is-on"
            type="button"
            aria-label="Hacia la derecha"
            data-panel-hold="1"
          >
            →
          </button>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .panel {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(ellipse 55% 70% at 72% 50%, rgb(var(--peach-rgb) / 0.14), transparent 70%),
      var(--navy);
  }

  .panel__word {
    position: absolute;
    left: 0;
    bottom: -3vh;
    color: transparent;
    font: italic 400 clamp(140px, 24vw, 400px) / 1 var(--font-serif);
    white-space: nowrap;
    -webkit-text-stroke: 1px rgb(var(--peach-rgb) / 0.16);
    transform: translateX(6vw);
    transition: transform 1.4s var(--ease) 0.15s;
    pointer-events: none;
  }

  :global(.is-in) .panel__word {
    transform: translateX(-14vw);
  }

  .panel__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3vw;
    align-items: center;
    min-height: 100vh;
    max-width: 1800px;
    margin: 0 auto;
    padding: 12vh 24px 4vh;
  }

  .panel__text {
    position: relative;
    z-index: 2;
    order: 2;
  }

  .panel__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 22px;
    color: var(--peach);
    font: 400 10px var(--font-sans);
    letter-spacing: 5px;
    text-transform: uppercase;
  }

  .panel__eyebrow span {
    width: 20px;
    height: 1px;
    background: var(--peach);
    transition: width 1.1s var(--ease) 0.15s;
  }

  :global(.is-in) .panel__eyebrow span {
    width: 60px;
  }

  .panel__title {
    margin: 0;
    font: 400 clamp(36px, min(8vw, 15vh), 170px) / 0.95 var(--font-serif);
  }

  .panel__mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .panel__mask span {
    display: block;
    color: var(--peach);
    font-style: italic;
    transform: translateY(110%);
    transition: transform 1s var(--ease) 0.4s;
  }

  :global(.is-in) .panel__mask span {
    transform: none;
  }

  .panel__lead,
  .panel__actions {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.8s 0.7s,
      transform 1s var(--ease) 0.6s;
  }

  :global(.is-in) .panel__lead,
  :global(.is-in) .panel__actions {
    opacity: 1;
    transform: none;
  }

  .panel__lead {
    max-width: 520px;
    margin: min(30px, 3.4vh) 0 0;
    color: rgb(var(--cream-rgb) / 0.82);
    font: 300 clamp(15px, 1.1vw, 19px) / 1.7 var(--font-sans);
    text-wrap: pretty;
  }

  .panel__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin-top: min(34px, 4vh);
  }

  .panel__cta {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    height: 56px;
    padding: 0 30px;
    background: var(--peach);
    color: var(--navy);
    font: 500 11px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
    transition:
      background-color 0.3s,
      gap 0.4s;
  }

  .panel__cta:hover {
    gap: 22px;
    background: var(--sand);
    color: var(--navy);
  }

  .panel__all {
    padding-bottom: 5px;
    border-bottom: 1px solid rgb(var(--peach-rgb) / 0.6);
    font: 500 11px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .panel__visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    width: 100%;
    opacity: 0;
    transform: translateY(80px);
    transition:
      opacity 1s 0.3s,
      transform 1.2s var(--ease) 0.15s;
  }

  :global(.is-in) .panel__visual {
    opacity: 1;
    transform: none;
  }

  .panel__cards {
    --card-w: min(300px, 72vw);
    position: relative;
    width: 100%;
    height: 330px;
    perspective: 1400px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 16%, #000 84%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 16%, #000 84%, transparent);
  }

  .panel__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 24px;
  }

  .panel__arrow {
    width: 52px;
    height: 52px;
    border: 1px solid rgb(var(--sand-rgb) / 0.4);
    border-radius: 26px;
    background: transparent;
    color: var(--sand);
    font-size: 18px;
    touch-action: none;
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .panel__arrow.is-on {
    background: rgb(var(--sand-rgb) / 0.16);
  }

  .panel__arrow:hover {
    background: var(--sand);
    color: var(--navy);
  }

  .panel__dots {
    display: flex;
    gap: 8px;
  }

  .panel__dots button {
    width: 12px;
    height: 3px;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: rgb(var(--sand-rgb) / 0.25);
    transition:
      width 0.5s var(--ease),
      background-color 0.4s;
  }

  .panel__dots button.is-active {
    width: 36px;
    background: var(--sand);
  }

  @media (min-width: 760px) {
    .panel__grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
      padding: 12vh clamp(80px, 7vw, 150px) 7vh clamp(20px, 6vw, 110px);
    }

    .panel__text {
      order: 0;
    }

    .panel__cards {
      --card-w: min(380px, 27vw);
      height: 420px;
    }
  }
</style>
