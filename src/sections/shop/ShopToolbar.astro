---
import GenderTab from '../../components/shop/GenderTab.astro';
import Icon from '../../components/ui/Icon.astro';
import { GENDER_FILTERS, SORT_OPTIONS } from '../../data/shop.js';

/** @typedef {{ total: number }} Props */
const { total } = Astro.props;
---

<div class="toolbar">
  <label class="toolbar__search">
    <Icon name="search" size={18} strokeWidth={1.6} />
    <input
      type="search"
      placeholder="Busca por nombre o nota…"
      aria-label="Buscar perfumes"
      data-shop-search
    />
    <button
      type="button"
      class="toolbar__clear-search"
      data-shop-search-clear
      aria-label="Borrar"
      hidden
    >
      ×
    </button>
  </label>
  <div class="toolbar__genders">
    {GENDER_FILTERS.map((label, index) => (
      <GenderTab label={label} active={index === 0} />
    ))}
  </div>
  <span class="toolbar__divider" aria-hidden="true"></span>
  <select class="toolbar__sort" aria-label="Ordenar" data-shop-sort>
    {SORT_OPTIONS.map((option) => (
      <option value={option.value}>{option.label}</option>
    ))}
  </select>
  <div class="toolbar__views">
    <button
      class="toolbar__view is-active"
      type="button"
      data-shop-view="grid"
      aria-label="Galería"
      title="Galería"
    >
      <Icon name="grid" size={16} />
    </button>
    <button
      class="toolbar__view"
      type="button"
      data-shop-view="list"
      aria-label="Lista"
      title="Lista"
    >
      <Icon name="list" size={16} />
    </button>
  </div>
  <span class="toolbar__count">
    <b data-shop-count>{total}</b> / {total}
  </span>
</div>

<style>
  .toolbar {
    position: sticky;
    top: 76px;
    z-index: var(--z-sticky);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(14px, 2.4vw, 34px);
    margin: 14px 0 30px;
    padding: 12px 0;
    background: linear-gradient(180deg, rgb(var(--navy-rgb) / 0.97), rgb(var(--navy-rgb) / 0.9));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-block: 1px solid rgb(var(--peach-rgb) / 0.2);
  }

  .toolbar__search {
    display: flex;
    flex: 1 1 260px;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--peach);
  }

  .toolbar__search input {
    flex: 1;
    min-width: 0;
    height: 44px;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--white);
    font: italic 400 22px/1 var(--font-serif);
  }

  .toolbar__search input::-webkit-search-cancel-button {
    display: none;
  }

  .toolbar__clear-search {
    border: 0;
    background: none;
    color: var(--text-muted);
    font-size: 20px;
  }

  .toolbar__genders {
    display: flex;
    gap: 22px;
    align-items: center;
  }

  .toolbar__divider {
    width: 1px;
    height: 24px;
    background: var(--line);
  }

  .toolbar__sort {
    height: 44px;
    padding: 0 4px;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--white);
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    cursor: pointer;
  }

  .toolbar__sort option {
    color: var(--navy);
  }

  .toolbar__views {
    display: flex;
    gap: 4px;
  }

  .toolbar__view {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--white);
    transition: all 0.3s;
  }

  .toolbar__view.is-active {
    border-color: var(--peach);
    background: var(--peach);
    color: var(--navy);
  }

  .toolbar__count {
    font: 600 13px/1 var(--font-sans);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .toolbar__count b {
    font-weight: 800;
    color: var(--peach);
  }
</style>
