---
import IndexPreview from '../../components/shop/IndexPreview.astro';
import IndexRow from '../../components/shop/IndexRow.astro';
import ShopCard from '../../components/shop/ShopCard.astro';

/** @typedef {{ entries: object[] }} Props */
const { entries } = Astro.props;
const LETTERS = ['', ...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'];
---

<div class="results" data-results data-mode="grid">
  <div class="results__empty" data-shop-empty hidden>
    <p>Ninguna fragancia con esta combinación</p>
    <button type="button" data-shop-clear>
      Limpiar filtros
    </button>
  </div>
  <div class="results__index" data-mode-panel="index">
    <div class="letters">
      <span class="letters__label">Índice</span>
      {LETTERS.map((letter) => (
        <button
          class="letters__btn"
          type="button"
          aria-pressed={letter ? 'false' : 'true'}
          data-letter={letter}
        >
          {letter || 'Todas'}
        </button>
      ))}
    </div>
    <div class="results__index-grid">
      <div class="results__rows" data-rows>
        {entries.map((entry) => (
          <IndexRow entry={entry} />
        ))}
      </div>
      <IndexPreview />
    </div>
  </div>
  <div class="results__grid" data-mode-panel="grid" data-cards>
    {entries.map((entry) => (
      <ShopCard entry={entry} />
    ))}
  </div>
  <div class="results__more" data-more hidden>
    <span class="results__shown" data-more-text></span>
    <span class="results__track">
      <span data-more-bar></span>
    </span>
    <button type="button" data-more-button>
      Ver más fragancias
    </button>
  </div>
</div>

<style>
  .results {
    min-width: 0;
  }

  [data-mode='grid'] .results__index,
  [data-mode='index'] .results__grid {
    display: none;
  }

  .results__empty {
    padding: 12vh 20px;
    text-align: center;
  }

  .results__empty p {
    margin: 0;
    color: var(--sand);
    font: italic 400 clamp(26px, 2.6vw, 40px) var(--font-serif);
  }

  .results__empty button {
    height: 48px;
    margin-top: 24px;
    padding: 0 26px;
    border: 1px solid var(--peach);
    border-radius: 24px;
    background: none;
    color: var(--peach);
    font: 500 11px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .letters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    margin-bottom: 28px;
  }

  .letters__label {
    margin-right: 12px;
    color: var(--peach);
    font: 400 10px var(--font-sans);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .letters__btn {
    min-width: 32px;
    height: 32px;
    padding: 0 8px;
    border: 0;
    border-radius: 16px;
    background: transparent;
    color: var(--cream);
    font: 400 15px var(--font-serif);
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .letters__btn:hover {
    color: var(--sand);
  }

  .letters__btn:disabled {
    opacity: 0.25;
    cursor: default;
  }

  .letters__btn[aria-pressed='true'] {
    background: var(--peach);
    color: var(--navy);
  }

  .results__index-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.85fr);
    align-items: start;
    gap: clamp(20px, 2.4vw, 36px);
  }

  /*
   * position + isolation: ausblendende Karten (motion.js) werden hier drin absolut platziert
   * und liegen mit z-index -1 hinter den anderen, aber nicht hinter dem Seitenhintergrund.
   */
  .results__rows,
  .results__grid {
    position: relative;
    isolation: isolate;
  }

  .results__rows {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .results__grid {
    --cols: 3;
    --gap: 24px;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: calc(var(--gap) * 1.6) var(--gap);
  }

  .results__more {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-top: 10vh;
  }

  .results__shown {
    color: rgb(var(--cream-rgb) / 0.6);
    font: 400 10px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .results__track {
    width: 200px;
    height: 2px;
    overflow: hidden;
    border-radius: 1px;
    background: rgb(var(--peach-rgb) / 0.2);
  }

  .results__track span {
    display: block;
    width: var(--shown, 0%);
    height: 100%;
    background: var(--peach);
  }

  .results__more button {
    height: 56px;
    margin-top: 8px;
    padding: 0 34px;
    border: 1px solid var(--peach);
    border-radius: 28px;
    background: none;
    color: var(--peach);
    font: 500 11px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .results__more button:hover {
    background: var(--peach);
    color: var(--navy);
  }

  @media (min-width: 1080px) {
    [data-density='4'] .results__grid {
      --cols: 4;
    }
  }

  @media (max-width: 639px) {
    .results__grid {
      --cols: 2;
      --gap: 14px;
    }
  }
</style>
