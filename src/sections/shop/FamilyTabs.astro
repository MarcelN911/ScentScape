---
import FamilyTab from '../../components/shop/FamilyTab.astro';
import { countByFamily, familiesWithProducts } from '../../scripts/catalog/queries.js';

/** @typedef {{ catalog: object[] }} Props */
const { catalog } = Astro.props;
const families = familiesWithProducts(catalog);
---

<div class="family-tabs">
  {families.length > 0 && (
    <div class="family-tabs__list">
      <FamilyTab label="Todas" value="" count={catalog.length} color="#f0be91" active />
      {families.map((family) => (
        <FamilyTab
          label={family.id}
          value={family.id}
          count={countByFamily(catalog, family.id)}
          color={family.dot}
        />
      ))}
    </div>
  )}
  <button class="family-tabs__clear" type="button" data-shop-clear hidden>
    Limpiar filtros ×
  </button>
</div>

<style>
  .family-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .family-tabs__list {
    display: flex;
    flex: 1 1 auto;
    gap: 4px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid rgb(var(--peach-rgb) / 0.2);
  }

  .family-tabs__clear {
    margin-left: auto;
    padding: 0;
    border: 0;
    background: none;
    font: 600 13px/1 var(--font-sans);
    color: var(--peach);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
