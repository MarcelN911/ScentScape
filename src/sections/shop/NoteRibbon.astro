---
import RibbonNote from '../../components/shop/RibbonNote.astro';
import { RIBBON_NOTES } from '../../data/shop.js';
---

<div class="note-ribbon marquee marquee--pausable">
  <div class="marquee__track note-ribbon__track">
    <div class="marquee__group">
      {RIBBON_NOTES.map((note) => (
        <RibbonNote note={note} />
      ))}
    </div>
    <div class="marquee__group" aria-hidden="true">
      {RIBBON_NOTES.map((note) => (
        <RibbonNote note={note} />
      ))}
    </div>
  </div>
</div>

<style>
  .note-ribbon {
    --marquee-gap: 10px;
    --marquee-duration: 46s;
    position: relative;
    padding: 14px 0 14px 10px;
    border-block: 1px solid rgb(var(--peach-rgb) / 0.14);
  }
</style>
