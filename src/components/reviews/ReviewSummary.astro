---
/* Durchschnitt, Sterne, Anzahl und Verteilung 5…1 ★. Ein Klick auf eine Zeile filtert nach diesen Sternen. */
import { averageRating } from '../../scripts/catalog/reviews.js';

/** @typedef {{ reviews: object[] }} Props */
const { reviews } = Astro.props;
const total = reviews.length;
const average = total ? averageRating(reviews).toFixed(1) : '—';
const rows = [5, 4, 3, 2, 1].map((stars) => {
  const count = reviews.filter((review) => Math.round(review.rating) === stars).length;
  return { stars, count, width: total ? Math.round((count / total) * 100) : 0 };
});
const rowAttrs = (row) => ({
  'aria-pressed': 'false',
  'aria-label': `${row.stars} estrellas: ${row.count}`,
  'data-review-stars': row.stars,
});
---

<div class="summary">
  <div class="summary__score">
    <span class="summary__average">{average}</span>
    <span class="summary__stars" aria-hidden="true">
      ★★★★★
    </span>
    <span class="summary__count">
      {total} {total === 1 ? 'reseña' : 'reseñas'}
    </span>
  </div>
  <div class="summary__rows">
    {rows.map((row) => (
      <button class="summary__row" type="button" {...rowAttrs(row)}>
        <span class="summary__label">{row.stars} ★</span>
        <span class="summary__bar">
          <span style={`width:${row.width}%`}></span>
        </span>
        <span class="summary__number">{row.count}</span>
      </button>
    ))}
  </div>
</div>

<style>
  .summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(18px, 2.4vw, 32px);
    padding: clamp(20px, 2vw, 28px) clamp(20px, 2.4vw, 32px);
    border: 1px solid rgb(var(--peach-rgb) / 0.2);
    border-radius: 24px;
    background: var(--panel);
  }

  .summary__score {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding-right: clamp(18px, 2.4vw, 32px);
    border-right: 1px solid rgb(var(--peach-rgb) / 0.2);
  }

  .summary__average {
    color: #f6e3c6;
    font: italic 400 clamp(56px, 5vw, 84px) / 1 var(--font-serif);
  }

  .summary__stars {
    color: var(--peach);
    font-size: 14px;
    letter-spacing: 3px;
  }

  .summary__count {
    color: rgb(var(--cream-rgb) / 0.65);
    font: 400 11px var(--font-sans);
    letter-spacing: 2px;
  }

  .summary__rows {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 6px;
  }

  .summary__row {
    display: grid;
    flex: 1;
    grid-template-columns: 32px minmax(0, 1fr) 26px;
    align-items: center;
    gap: 10px;
    padding: 8px 6px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    transition: background-color 0.3s;
  }

  .summary__row:hover {
    background: rgb(var(--peach-rgb) / 0.1);
  }

  .summary__row[aria-pressed='true'] {
    background: rgb(var(--peach-rgb) / 0.16);
  }

  .summary__label {
    color: var(--sand);
    font: 500 12px var(--font-sans);
    text-align: left;
  }

  .summary__bar {
    display: block;
    height: 4px;
    overflow: hidden;
    border-radius: 2px;
    background: rgb(var(--sand-rgb) / 0.12);
  }

  .summary__bar span {
    display: block;
    height: 100%;
    background: var(--peach);
  }

  .summary__number {
    color: rgb(var(--cream-rgb) / 0.6);
    font: 400 12px var(--font-sans);
    text-align: right;
  }
</style>
