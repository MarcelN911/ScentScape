---
/* Vorlage einer Karte im Karussell. scripts/features/reviews/wall.js füllt sie für jede Bewertung. */
---

<template data-review-slide>
  <figure class="slide">
    <div class="slide__top">
      <span class="slide__stars">
        <span data-slide-on></span>
        <span class="slide__off" data-slide-off></span>
      </span>
      <span class="slide__tag" data-slide-date></span>
    </div>
    <blockquote data-slide-text></blockquote>
    <a class="slide__product" href="/productos/" data-slide-product></a>
    <figcaption>
      <span class="slide__ini" data-slide-ini></span>
      <span class="slide__who">
        <strong data-slide-name></strong>
        <span data-slide-city></span>
      </span>
    </figcaption>
    <span class="slide__dim" aria-hidden="true"></span>
  </figure>
</template>

<style>
  .slide {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: var(--card-w);
    margin: 0;
    padding: 28px;
    border-radius: 24px;
    background: var(--bg);
    box-shadow: 0 40px 80px rgb(0 0 0 / 0.45);
    color: var(--navy-card);
    opacity: 0;
    transform: translate(-50%, -50%);
    backface-visibility: hidden;
    will-change: transform, opacity;
  }

  .slide__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .slide__stars {
    color: var(--wine);
    font-size: 16px;
    letter-spacing: 3px;
  }

  .slide__off {
    color: rgb(var(--wine-rgb) / 0.2);
  }

  .slide__tag {
    color: rgb(var(--navy-card-rgb) / 0.55);
    font: 600 8px var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .slide blockquote {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font: 400 21px/1.4 var(--font-serif);
    text-wrap: pretty;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
  }

  .slide__product {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    height: 30px;
    padding: 0 14px;
    border-radius: 15px;
    background: rgb(var(--navy-card-rgb) / 0.08);
    color: var(--wine);
    font: 500 10px var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .slide__product:hover {
    background: rgb(var(--navy-card-rgb) / 0.14);
    color: var(--wine);
  }

  .slide figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid rgb(var(--navy-card-rgb) / 0.12);
  }

  .slide__ini {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: var(--navy-card);
    color: var(--sand);
    font: italic 400 17px var(--font-serif);
  }

  .slide__who {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .slide__who strong {
    font: 600 14px var(--font-sans);
  }

  .slide__who span {
    color: rgb(var(--navy-card-rgb) / 0.6);
    font: 500 10px var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .slide__dim {
    position: absolute;
    inset: 0;
    border-radius: 24px;
    background: var(--navy-ink);
    opacity: var(--dim, 0);
    pointer-events: none;
  }
</style>
