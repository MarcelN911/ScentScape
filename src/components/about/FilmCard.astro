---
/* Linke Bühne von "Nosotros": Video im Rahmen mit Logo, "Desde 2024" und Leitsatz. */
---

<div class="film reveal-late" style="--late:0.6s">
  <video src="/assets/video/vintage.mp4" autoplay muted loop playsinline aria-hidden="true"></video>
  <span class="film__shade"></span>
  <span class="film__frame"></span>
  <div class="film__top">
    <img src="/assets/img/scentscape-logo.png" alt="ScentScape" />
    <span>Medellín</span>
  </div>
  <div class="film__bottom">
    <span class="film__since">Desde</span>
    <span class="film__year">2024</span>
    <span class="film__claim">Elegancia, carácter y distinción.</span>
  </div>
</div>

<style>
  .film {
    position: relative;
    width: min(100%, 680px);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 22px;
    box-shadow:
      0 50px 100px rgb(0 0 0 / 0.6),
      0 0 0 1px rgb(var(--sand-rgb) / 0.12);
  }

  .film video,
  .film__shade,
  .film__frame {
    position: absolute;
    inset: 0;
  }

  .film video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .film__shade {
    background: linear-gradient(
      180deg,
      rgb(var(--navy-rgb) / 0.45),
      rgb(var(--navy-rgb) / 0) 30%,
      rgb(var(--navy-rgb) / 0) 50%,
      rgb(var(--navy-rgb) / 0.9)
    );
  }

  .film__frame {
    inset: 12px;
    border: 1px solid rgb(var(--sand-rgb) / 0.35);
    border-radius: 14px;
    pointer-events: none;
  }

  .film__top,
  .film__bottom {
    position: absolute;
    left: 28px;
    right: 28px;
  }

  .film__top {
    top: 26px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .film__top img {
    display: block;
    height: 20px;
  }

  .film__top span,
  .film__since {
    font: 600 9px var(--font-sans);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .film__top span {
    color: var(--sand);
  }

  .film__bottom {
    bottom: 30px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .film__since {
    color: var(--peach);
  }

  .film__year {
    color: var(--sand-light);
    font: italic 400 clamp(64px, 7vw, 96px) / 0.9 var(--font-serif);
  }

  .film__claim {
    color: rgb(var(--cream-rgb) / 0.85);
    font: 300 14px/1.6 var(--font-sans);
  }
</style>
