---
import { MENU_LINKS } from '../../data/navigation.js';
import { padNumber } from '../../scripts/utils/format.js';
---

<div class="menu" data-menu aria-hidden="true" transition:persist="mobile-menu">
  <nav class="menu__links" aria-label="Menú">
    {MENU_LINKS.map((link, index) => (
      <a class="menu__link" href={link.href} style={`--delay:${250 + index * 70}ms`} tabindex="-1">
        <span class="menu__number">{padNumber(index + 1)}</span>
        <span class="menu__label">{link.label}</span>
      </a>
    ))}
  </nav>
  <button
    class="menu__close"
    type="button"
    data-action="close-menu"
    aria-label="Cerrar menú"
    tabindex="-1"
  >
    ✕&nbsp;&nbsp;Cerrar
  </button>
</div>

<style>
  .menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow-y: auto;
    padding: 100px clamp(24px, 7vw, 110px) 60px;
    background: var(--navy-deep);
    clip-path: inset(0% 0% 100% 0%);
    transition: clip-path 0.9s var(--ease-curtain);
  }

  .menu.is-open {
    clip-path: inset(0% 0% 0% 0%);
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 22px;
    overflow: hidden;
    color: var(--cream);
    font: 400 clamp(30px, 4.6vw, 64px) / 1.12 var(--font-serif);
  }

  .menu__link:hover {
    color: var(--sand);
  }

  .menu__number {
    color: var(--peach);
    font: 400 11px var(--font-sans);
    letter-spacing: 3px;
  }

  .menu__label {
    display: inline-block;
    transform: translateY(110%);
    transition: transform 0.9s var(--ease) var(--delay);
  }

  .menu.is-open .menu__label {
    transform: translateY(0%);
  }

  .menu__close {
    position: absolute;
    top: 24px;
    left: clamp(18px, 4vw, 56px);
    padding: 10px 0;
    border: 0;
    background: none;
    color: var(--cream);
    font: 400 11px var(--font-sans);
    letter-spacing: 4px;
    text-transform: uppercase;
  }
</style>

<script>
  import { registerAction } from '../../scripts/core/actions.js';

  const menu = document.querySelector('[data-menu]');

  function setMenuOpen(open) {
    menu.classList.toggle('is-open', open);
    menu.setAttribute('aria-hidden', String(!open));
    menu.querySelectorAll('a, button').forEach((el) => (el.tabIndex = open ? 0 : -1));
    document.documentElement.classList.toggle('is-locked', open);
  }

  menu.addEventListener('click', (event) => event.target.closest('a') && setMenuOpen(false));
  document.addEventListener('keydown', (event) => event.key === 'Escape' && setMenuOpen(false));
  registerAction('open-menu', () => setMenuOpen(true));
  registerAction('close-menu', () => setMenuOpen(false));
  document.addEventListener('astro:before-preparation', () => setMenuOpen(false));
</script>
