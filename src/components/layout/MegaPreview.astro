---
/**
 * @typedef {object} Props
 * @property {object} item       Eintrag aus MEGA_GROUPS
 * @property {string} group      Name der Gruppe ("Comprar", …)
 * @property {string} [image]    Flaschenbild bei preview: 'product'
 * @property {boolean} [active]
 */
const { item, group, image, active = false } = Astro.props;
const Tag = item.action ? 'button' : 'a';
const cta = item.cta ?? (item.section ? 'Ir a la sección ↓' : 'Abrir →');
const background = `radial-gradient(circle at 50% 28%, color-mix(in oklch, ${item.accent} 50%, #151932) 0%, #151932 72%)`;
---

<Tag
  class:list={['mega-preview', 'hatch', { 'is-active': active }]}
  href={item.href}
  type={item.action ? 'button' : undefined}
  data-action={item.action}
  data-mega-preview={item.key}
  style={`background-color:#151932;background:${background}`}
  tabindex="-1"
>
  <span class="mega-preview__frame" aria-hidden="true"></span>
  {image && <img class="mega-preview__bottle" src={image} alt="" loading="lazy" />}
  {item.preview === 'logo' && (
    <img class="mega-preview__logo" src="/assets/img/scentscape-fulllogo.png" alt="" />
  )}
  {item.preview === 'seal' && (
    <span class="mega-preview__seal" aria-hidden="true">
      ✓
    </span>
  )}
  <span class="mega-preview__body">
    <span class="eyebrow mega-preview__group">{group}</span>
    <span class="mega-preview__title">{item.title}</span>
    <span class="mega-preview__text">{item.text}</span>
    <span class="btn btn--primary mega-preview__cta">{cta}</span>
  </span>
</Tag>

<style>
  .mega-preview {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    border: 0;
    border-radius: 18px;
    overflow: hidden;
    text-align: left;
    color: var(--white);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s ease,
      visibility 0s 0.4s;
  }

  .mega-preview.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.4s ease;
  }

  .mega-preview:hover {
    color: var(--white);
  }

  .mega-preview__frame {
    position: absolute;
    inset: 10px;
    border: 1px solid rgb(var(--peach-rgb) / 0.22);
    border-radius: 12px;
    pointer-events: none;
  }

  .mega-preview__bottle {
    position: absolute;
    left: 50%;
    top: 22px;
    height: 58%;
    max-width: 70%;
    transform: translateX(-50%);
    object-fit: contain;
    filter: drop-shadow(0 26px 30px rgb(0 0 0 / 0.55));
  }

  .mega-preview__logo {
    position: absolute;
    left: 50%;
    top: 48px;
    width: 64%;
    transform: translateX(-50%);
  }

  .mega-preview__seal {
    position: absolute;
    left: 50%;
    top: 44px;
    display: grid;
    place-items: center;
    width: 130px;
    height: 130px;
    margin-left: -65px;
    border-radius: 50%;
    border: 1px solid rgb(var(--peach-rgb) / 0.5);
    outline: 1px solid rgb(var(--peach-rgb) / 0.2);
    outline-offset: -8px;
    font: italic 400 52px/1 var(--font-serif);
    color: var(--sand);
  }

  .mega-preview.is-active :is(.mega-preview__bottle, .mega-preview__logo, .mega-preview__seal) {
    animation: fade-in 0.5s var(--ease);
  }

  .mega-preview__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mega-preview__group {
    font-size: 10px;
  }

  .mega-preview__title {
    font: 500 30px/1 var(--font-serif);
    letter-spacing: -0.01em;
  }

  .mega-preview__text {
    font: 400 13px/1.5 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.72);
  }

  .mega-preview__cta {
    --btn-height: 38px;
    align-self: flex-start;
    margin-top: 6px;
    padding-inline: 16px;
    font-size: 12px;
  }
</style>
