---
import { SERVICE_LINKS } from '../../data/navigation.js';
import { padNumber } from '../../scripts/utils/format.js';

/** @typedef {{ link: { key: string, label: string, href: string } }} Props */
const { link } = Astro.props;
---

<div class="dropdown" data-dropdown>
  <a class="dropdown__toggle" href={link.href} data-nav-link={link.key} aria-haspopup="true">
    {link.label}
    <svg
      width="10"
      height="10"
      viewBox="0 0 10 10"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      aria-hidden="true"
    >
      <path d="M2 3.5l3 3 3-3"></path>
    </svg>
  </a>
  <div class="dropdown__panel" role="menu">
    {SERVICE_LINKS.map((item, index) => (
      <a class="dropdown__item" href={item.href} role="menuitem">
        <span class="dropdown__number">{padNumber(index + 1)}</span>
        <span class="dropdown__text">
          <span class="dropdown__title">{item.title}</span>
          <span class="dropdown__sub">{item.text}</span>
        </span>
      </a>
    ))}
  </div>
</div>

<style>
  .dropdown {
    position: relative;
  }

  .dropdown__toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px 15px;
    border-radius: 20px;
    color: var(--cream);
    font: 400 11px var(--font-sans);
    letter-spacing: 2.5px;
    text-transform: uppercase;
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .dropdown__toggle svg {
    color: var(--peach);
    transition: transform 0.4s;
  }

  .dropdown__toggle:hover {
    background: rgb(var(--peach-rgb) / 0.1);
    color: var(--sand);
  }

  .dropdown__toggle.is-active {
    background: var(--peach);
    color: var(--navy);
  }

  .dropdown__toggle.is-active svg {
    color: var(--navy);
  }

  .dropdown.is-open .dropdown__toggle svg {
    transform: rotate(180deg);
  }

  .dropdown__panel {
    position: absolute;
    top: calc(100% + 16px);
    left: 50%;
    display: flex;
    flex-direction: column;
    width: 320px;
    padding: 8px;
    border: 1px solid rgb(var(--peach-rgb) / 0.25);
    border-radius: 22px;
    background: rgb(var(--navy-deep-rgb) / 0.96);
    backdrop-filter: blur(16px);
    box-shadow: 0 40px 80px rgb(0 0 0 / 0.5);
    opacity: 0;
    transform: translate(-50%, 10px);
    pointer-events: none;
    transition:
      opacity 0.35s,
      transform 0.45s var(--ease);
  }

  .dropdown.is-open .dropdown__panel {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  .dropdown__item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    border-radius: 14px;
    color: var(--cream);
    transition: background-color 0.3s;
  }

  .dropdown__item:hover {
    background: rgb(var(--peach-rgb) / 0.1);
    color: var(--cream);
  }

  .dropdown__number {
    color: var(--peach);
    font: 400 10px var(--font-sans);
    letter-spacing: 2px;
  }

  .dropdown__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .dropdown__title {
    font: 400 18px var(--font-serif);
  }

  .dropdown__sub {
    color: rgb(var(--cream-rgb) / 0.65);
    font: 300 12px var(--font-sans);
  }
</style>
