---
import { FOOTER_COLUMNS } from '../../data/navigation.js';
import { INSTAGRAM_URL, PHONE_DISPLAY, WHATSAPP_NUMBER } from '../../scripts/config.js';
import PaymentLogos from '../ui/PaymentLogos.astro';
import FooterChat from './FooterChat.astro';
import FooterColumn from './FooterColumn.astro';

const year = new Date().getFullYear();
---

<footer class="footer" transition:persist="site-footer">
  <div class="footer__inner">
    <FooterChat />
    <div class="footer__main">
      <div class="footer__brand">
        <img src="/assets/img/scentscape-logo.png" alt="ScentScape Parfums" class="footer__logo" />
        <p class="footer__claim">Distinción sin límites</p>
        <div class="footer__social">
          <a
            class="footer__social-link"
            href={INSTAGRAM_URL}
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
          >
            <img src="/assets/img/instagram_white.svg" alt="" />
          </a>
          <a
            class="footer__social-link"
            href={`https://wa.me/${WHATSAPP_NUMBER}`}
            target="_blank"
            rel="noopener"
            aria-label="WhatsApp"
          >
            <img src="/assets/img/whatsapp_white.svg" alt="" />
          </a>
        </div>
      </div>
      <div class="footer__columns">
        {FOOTER_COLUMNS.map((column) => (
          <FooterColumn column={column} />
        ))}
      </div>
    </div>
    <div class="footer__payments">
      <span class="footer__payments-label">Medios de pago</span>
      <PaymentLogos />
    </div>
    <div class="footer__legal">
      <span>{PHONE_DISPLAY} · Medellín, Colombia</span>
      <span>© {year} ScentScape. Todos los derechos reservados.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    overflow: hidden;
    padding: clamp(80px, 9vw, 130px) var(--gutter) 110px;
    background: var(--navy-deep);
  }

  .footer__inner {
    max-width: var(--container);
    margin: 0 auto;
  }

  .footer__main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 40px;
    margin-top: 70px;
    padding-top: 40px;
    border-top: 1px solid var(--line-faint);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 320px;
  }

  .footer__logo {
    width: 220px;
    height: auto;
  }

  .footer__claim {
    margin: 0;
    font: italic 400 22px/1.3 var(--font-serif);
    color: var(--sand);
  }

  .footer__social {
    display: flex;
    gap: 10px;
  }

  .footer__social-link {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgb(var(--peach-rgb) / 0.12);
    transition: background-color 0.3s ease;
  }

  .footer__social-link:hover {
    background: rgb(var(--peach-rgb) / 0.3);
  }

  .footer__social-link img {
    width: 18px;
    height: 18px;
  }

  .footer__columns {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(40px, 7vw, 110px);
  }

  .footer__payments {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 18px;
    margin-top: 50px;
    padding-top: 30px;
    border-top: 1px solid var(--line-faint);
  }

  .footer__payments-label {
    font: 700 12px/1 var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--peach);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    margin-top: 30px;
    font: 500 12px/1.4 var(--font-sans);
    color: var(--text-faint);
  }
</style>
