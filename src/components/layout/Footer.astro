---
import { FOOTER_COLUMNS } from '../../data/navigation.js';
import {
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  PHONE_DISPLAY,
  WHATSAPP_NUMBER,
} from '../../scripts/config.js';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import FooterColumn from './FooterColumn.astro';
import FooterMini from './FooterMini.astro';

const year = new Date().getFullYear();
const contact = {
  title: 'Contacto',
  links: [
    { label: PHONE_DISPLAY, href: `https://wa.me/${WHATSAPP_NUMBER}` },
    { label: INSTAGRAM_HANDLE, href: INSTAGRAM_URL },
    { label: 'Medellín, Colombia' },
    { label: 'Envíos a todo Colombia' },
  ],
};
const columns = [...FOOTER_COLUMNS, contact];
---

<footer class="footer" transition:persist="site-footer">
  <div class="footer__glow" aria-hidden="true"></div>
  <div class="footer__grid">
    <div class="footer__brand">
      <h2 class="footer__title">
        Distinción
        <br />
        <span>sin límites</span>
      </h2>
      <p class="footer__text">
        Perfumes que representan elegancia, carácter y distinción. Desde Medellín, con envíos a todo
        Colombia.
      </p>
      <div class="footer__buttons">
        <a class="footer__btn footer__btn--primary" href="/test-olfativo/">
          Test Olfativo <span>→</span>
        </a>
        <a class="footer__btn footer__btn--whatsapp" href={`https://wa.me/${WHATSAPP_NUMBER}`}>
          <WhatsAppIcon size={16} />
          WhatsApp
        </a>
      </div>
    </div>
    <FooterMini />
    <div class="footer__columns">
      {columns.map((column) => (
        <FooterColumn column={column} />
      ))}
    </div>
  </div>
  <div class="footer__mark" data-footer-mark aria-hidden="true">
    {'SCENTSCAPE'.split('').map((letter, index) => (
      <span style={`--delay:${index * 55}ms`}>{letter}</span>
    ))}
  </div>
  <div class="footer__bottom">
    <p>
      © {year} ScentScape<span class="footer__rights">. Todos los derechos reservados.</span>
      <span class="footer__legal">
        · <a href="/terminos/">Términos</a> · <a href="/privacidad/">Privacidad</a>
      </span>
    </p>
    <button class="footer__top" type="button" data-action="scroll-top" aria-label="Volver arriba">
      <span class="footer__top-label">Volver arriba</span> ↑
    </button>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    padding: 16vh clamp(20px, 6vw, 96px) 28px;
    border-top: 1px solid rgb(var(--peach-rgb) / 0.15);
    background: var(--navy-deep);
  }

  .footer__glow {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 60vw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(var(--wine-rgb) / 0.45), transparent 65%);
    pointer-events: none;
  }

  .footer__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(48px, 6vw, 100px);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 26px;
  }

  .footer__title {
    margin: 0;
    font: 400 clamp(40px, 4.6vw, 76px) / 1 var(--font-serif);
  }

  .footer__title span {
    font-style: italic;
    color: var(--peach);
  }

  .footer__text {
    max-width: 380px;
    margin: 0;
    color: rgb(var(--cream-rgb) / 0.75);
    font: 300 15px/1.75 var(--font-sans);
  }

  .footer__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .footer__btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 52px;
    padding: 0 26px;
    border-radius: 26px;
    font: 500 11px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
    transition:
      background-color 0.3s,
      gap 0.4s;
  }

  .footer__btn--primary {
    background: var(--peach);
    color: var(--navy);
  }

  .footer__btn--primary:hover {
    gap: 18px;
    background: var(--sand);
    color: var(--navy);
  }

  .footer__btn--whatsapp {
    gap: 10px;
    padding: 0 24px;
    border: 1px solid rgb(37 211 102 / 0.6);
    color: var(--cream);
  }

  .footer__btn--whatsapp:hover {
    background: rgb(37 211 102 / 0.14);
    color: var(--cream);
  }

  .footer__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 44px 28px;
  }

  .footer__mark {
    position: relative;
    display: flex;
    justify-content: space-between;
    margin-top: 14vh;
    overflow: hidden;
    color: var(--peach);
    font: 400 13.4vw/0.9 var(--font-serif);
    letter-spacing: -0.02em;
  }

  .footer__mark span {
    display: inline-block;
    transition: transform 1.1s var(--ease) var(--delay);
  }

  :global(.js) .footer__mark:not(.is-revealed, .is-scroll) span {
    transform: translateY(105%);
  }

  .footer__mark.is-scroll span {
    transform: translateY(calc(var(--y, 105) * 1%));
    transition: transform 0.25s linear;
  }

  .footer__bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid rgb(var(--peach-rgb) / 0.18);
  }

  .footer__bottom p {
    margin: 0;
    color: rgb(var(--cream-rgb) / 0.55);
    font: 300 12px var(--font-sans);
  }

  .footer__top {
    height: 44px;
    padding: 0 20px;
    border: 1px solid rgb(var(--peach-rgb) / 0.4);
    border-radius: 22px;
    background: none;
    color: var(--peach);
    font: 500 10px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .footer__top:hover {
    background: var(--peach);
    color: var(--navy);
  }

  .footer__legal {
    display: none;
  }

  .footer__legal a {
    color: inherit;
  }

  /*
   * Handy und Tablet hochkant: kurzer Footer. Ohne Begleittext und ohne die vier Link-Spalten,
   * stattdessen FooterMini (wichtigste Links, Instagram, WhatsApp). Weniger Abstände.
   */
  @media (max-width: 1079px) and (orientation: portrait), (max-width: 899px) {
    .footer {
      /* Unten Platz für den Musik-Player, damit er nichts verdeckt */
      padding: 64px 20px 80px;
    }

    .footer__brand {
      gap: 22px;
    }

    .footer__title {
      font-size: clamp(36px, 9vw, 56px);
    }

    .footer__text,
    .footer__columns,
    .footer__rights {
      display: none;
    }

    .footer__legal {
      display: inline;
    }

    .footer__buttons {
      width: 100%;
    }

    .footer__btn {
      flex: 1;
      justify-content: center;
      height: 48px;
      padding: 0 16px;
      letter-spacing: 2px;
    }

    .footer__mark {
      margin-top: 44px;
    }

    .footer__bottom {
      margin-top: 18px;
      padding-top: 16px;
    }

    /* Nur der Pfeil, als kleiner runder Knopf neben dem Copyright */
    .footer__bottom {
      flex-wrap: nowrap;
    }

    .footer__top {
      flex: none;
      width: 36px;
      height: 36px;
      padding: 0;
      letter-spacing: 0;
      font-size: 13px;
    }

    .footer__top-label {
      display: none;
    }
  }

  @media (min-width: 640px) {
    .footer__columns {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .footer__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr);
    }
  }
</style>

<script>
  import { registerAction } from '../../scripts/core/actions.js';
  import { onPage } from '../../scripts/core/lifecycle.js';
  import { initWordmark } from '../../scripts/layout/wordmark.js';

  onPage(initWordmark);
  registerAction('scroll-top', () => scrollTo({ top: 0, behavior: 'smooth' }));
</script>
