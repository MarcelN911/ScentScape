---
import { NAV_LINKS } from '../../data/navigation.js';
import Icon from '../ui/Icon.astro';
import NavLink from './NavLink.astro';
import ServicesDropdown from './ServicesDropdown.astro';
---

<header class="site-header" data-header transition:persist="site-header">
  <a class="site-header__logo" href="/" aria-label="ScentScape — inicio">
    <img src="/assets/img/scentscape-logo.png" alt="ScentScape Parfums" />
  </a>
  <nav class="site-header__nav" aria-label="Principal">
    {NAV_LINKS.map((link) =>
      link.dropdown ? <ServicesDropdown link={link} /> : <NavLink link={link} />,
    )}
  </nav>
  <div class="site-header__actions">
    <a class="site-header__icon" href="/productos/" aria-label="Buscar">
      <Icon name="search" size={18} strokeWidth={1.5} />
    </a>
    <a class="site-header__fav" href="/productos/" aria-label="Favoritos">
      <Icon name="heart" size={18} strokeWidth={1.5} />
      <span data-wish-count></span>
    </a>
    <button
      class="site-header__bag"
      type="button"
      data-action="open-cart"
      data-cart-target
      aria-label="Abrir bolsa"
    >
      <Icon name="bag" size={16} strokeWidth={1.6} />
      Bolsa{' '}
      <span class="site-header__count" data-cart-count>
        0
      </span>
    </button>
    <button
      class="site-header__burger"
      type="button"
      data-action="open-menu"
      aria-label="Abrir menú"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 14px;
    left: clamp(10px, 2vw, 28px);
    right: clamp(10px, 2vw, 28px);
    z-index: var(--z-header);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 64px;
    padding: 0 10px 0 22px;
    border: 1px solid rgb(var(--peach-rgb) / 0);
    border-radius: 32px;
    transition:
      transform 0.6s var(--ease),
      background-color 0.5s,
      border-color 0.5s,
      box-shadow 0.5s;
  }

  .site-header.is-solid {
    background: rgb(var(--navy-deep-rgb) / 0.78);
    border-color: rgb(var(--peach-rgb) / 0.22);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.35);
  }

  .site-header.is-hidden {
    transform: translateY(-140%);
  }

  .site-header__logo {
    flex: none;
  }

  .site-header__logo img {
    height: 28px;
    width: auto;
  }

  .site-header__nav {
    display: none;
    align-items: center;
    gap: 2px;
  }

  .site-header__actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: 6px;
  }

  .site-header__icon,
  .site-header__fav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 44px;
    border-radius: 22px;
    color: var(--cream);
    font: 400 11px var(--font-sans);
    transition: background-color 0.3s;
  }

  .site-header__icon {
    width: 44px;
  }

  .site-header__fav {
    padding: 0 12px;
  }

  .site-header__fav span {
    color: var(--sand);
  }

  .site-header__icon:hover,
  .site-header__fav:hover {
    background: rgb(var(--peach-rgb) / 0.12);
    color: var(--cream);
  }

  .site-header__bag {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: 22px;
    background: var(--peach);
    color: var(--navy);
    font: 500 11px var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: background-color 0.3s;
  }

  .site-header__bag:hover {
    background: var(--sand);
  }

  .site-header__count {
    display: grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    border-radius: 10px;
    background: var(--navy);
    color: var(--sand);
    font: 600 10px var(--font-sans);
    letter-spacing: 0;
  }

  .site-header__burger {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(var(--peach-rgb) / 0.35);
    border-radius: 22px;
    background: none;
  }

  .site-header__burger span {
    width: 18px;
    height: 1px;
    background: var(--cream);
  }

  .site-header__burger span + span {
    width: 12px;
    background: var(--peach);
  }

  @media (max-width: 479px) {
    .site-header {
      padding-left: 16px;
    }

    .site-header__icon,
    .site-header__fav {
      display: none;
    }
  }

  @media (min-width: 1080px) {
    .site-header__nav {
      display: flex;
    }

    .site-header__burger {
      display: none;
    }
  }
</style>

<script>
  import { onFirstPage, onPage } from '../../scripts/core/lifecycle.js';
  import { initHeader, markActiveLinks } from '../../scripts/layout/header.js';
  import { initDropdown } from '../../scripts/layout/dropdown.js';

  onFirstPage(initHeader);
  onFirstPage(initDropdown);
  onPage(markActiveLinks);
</script>
