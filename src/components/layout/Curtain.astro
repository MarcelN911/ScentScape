<div class="curtain" data-curtain aria-hidden="true" transition:persist="curtain">
  <span class="curtain__line" data-curtain-line></span>
</div>

<style>
  .curtain {
    position: fixed;
    inset: 0;
    z-index: var(--z-curtain);
    display: none;
    background: var(--navy);
    clip-path: inset(0% 0% 0% 0%);
    pointer-events: none;
  }

  :global(.js) .curtain {
    display: block;
  }

  .curtain__line {
    position: absolute;
    left: var(--curtain-x, 50%);
    top: 50%;
    width: 1px;
    height: 0;
    background: linear-gradient(180deg, transparent, var(--sand), transparent);
    box-shadow: 0 0 24px 2px rgb(var(--sand-rgb) / 0.6);
    transform: translate(-50%, -50%);
  }

  .curtain[data-mode='row'] .curtain__line {
    left: 50%;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--sand), transparent);
  }

  .curtain[data-mode='none'] .curtain__line {
    display: none;
  }
</style>

<script>
  import { initCurtain } from '../../scripts/layout/curtain.js';
  import { onFirstPage } from '../../scripts/core/lifecycle.js';

  onFirstPage(initCurtain);
</script>
