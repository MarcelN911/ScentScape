<div class="curtain" data-curtain aria-hidden="true" transition:persist="curtain">
  <img class="curtain__logo" src="/assets/img/scentscape-logo.png" alt="" />
  <span class="curtain__rim" data-curtain-rim></span>
</div>

<style>
  .curtain {
    position: fixed;
    inset: 0;
    z-index: var(--z-curtain);
    display: none;
    background: var(--navy);
    clip-path: inset(0% 0% 0% 0%);
    pointer-events: none;
  }

  :global(.js) .curtain {
    display: block;
  }

  /* Logo in der Mitte: liegt im Vorhang, der Kreis deckt es mit auf und nimmt es wieder mit */
  .curtain__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(260px, 45vw, 640px);
    max-width: none;
    transform: translate(-50%, -50%);
  }

  /* Leuchtender Rand: ein Kreis genau so groß wie die Blende, das Leuchten liegt innen */
  .curtain__rim {
    position: absolute;
    width: 0;
    aspect-ratio: 1;
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 1px var(--sand),
      inset 0 0 24px 2px rgb(var(--sand-rgb) / 0.6);
    opacity: 0;
    transform: translate(-50%, -50%);
  }

  .curtain[data-mode='none'] .curtain__rim {
    display: none;
  }

  /* Auf dem Weg zur Startseite bleibt der Vorhang leer: dort ist das Intro der einzige Ladescreen */
  .curtain[data-target='home'] .curtain__logo {
    display: none;
  }
</style>

<script>
  import { initCurtain } from '../../scripts/layout/curtain.js';
  import { onFirstPage } from '../../scripts/core/lifecycle.js';

  onFirstPage(initCurtain);
</script>
