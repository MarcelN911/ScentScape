---
import { MEGA_GROUPS } from '../../data/navigation.js';
import { ADVISOR_MESSAGE } from '../../data/chat.js';
import { whatsappUrl } from '../../scripts/utils/whatsapp.js';
import MegaGroup from './MegaGroup.astro';
import MegaPreview from './MegaPreview.astro';

/** @typedef {{ images: Record<string, string> }} Props */
const { images } = Astro.props;
const previews = MEGA_GROUPS.flatMap((group) =>
  group.items.map((item) => ({ item, group: group.label, image: images[item.slug] })),
);
---

<div class="mega" data-mega-panel>
  <div class="mega__panel anim-fade-in">
    <div class="mega__preview">
      {previews.map((entry, index) => (
        <MegaPreview {...entry} active={index === 0} />
      ))}
    </div>
    <div class="mega__side">
      <div class="mega__groups">
        {MEGA_GROUPS.map((group) => (
          <MegaGroup group={group} />
        ))}
      </div>
      <div class="mega__footer">
        <a class="mega__advisor" href={whatsappUrl(ADVISOR_MESSAGE)} target="_blank" rel="noopener">
          <span class="mega__wa">
            <img src="/assets/img/whatsapp_white.svg" alt="" />
          </span>
          ¿No sabes cuál elegir? Te asesoramos
        </a>
        <span class="mega__note">Sara y Brayan responden en persona</span>
      </div>
    </div>
  </div>
</div>

<style>
  .mega {
    position: absolute;
    top: 100%;
    left: 0;
    display: none;
    width: min(1000px, calc(100vw - 24px));
    padding-top: 12px;
  }

  :global([data-mega-open]) .mega {
    display: block;
  }

  .mega__panel {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 14px;
    padding: 12px;
    border-radius: 26px;
    background: rgb(var(--navy-deep-rgb) / 0.94);
    border: 1px solid rgb(var(--peach-rgb) / 0.2);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 40px 90px rgb(0 0 0 / 0.55);
  }

  .mega__preview {
    position: relative;
    min-height: 360px;
  }

  .mega__side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    min-width: 0;
    padding: 16px 12px 4px;
  }

  .mega__groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .mega__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    padding-top: 14px;
    border-top: 1px solid rgb(var(--peach-rgb) / 0.16);
  }

  .mega__advisor {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 600 13px/1 var(--font-sans);
    color: var(--white);
  }

  .mega__advisor:hover {
    color: var(--peach);
  }

  .mega__wa {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--whatsapp);
  }

  .mega__wa img {
    width: 14px;
    height: 14px;
  }

  .mega__note {
    font: italic 400 15px/1 var(--font-serif);
    color: var(--sand);
  }
</style>
