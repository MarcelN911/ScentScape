---
/** @typedef {{ item: { key: string, title: string, href?: string, action?: string } }} Props */
const { item } = Astro.props;
const Tag = item.action ? 'button' : 'a';
---

<Tag
  class="mega-link"
  href={item.href}
  type={item.action ? 'button' : undefined}
  data-action={item.action}
  data-mega-item={item.key}
>
  <span class="mega-link__line" aria-hidden="true"></span>
  <span>{item.title}</span>
</Tag>

<style>
  .mega-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 0;
    border: 0;
    background: none;
    text-align: left;
    font: 500 20px/1.15 var(--font-serif);
    color: var(--white);
    transition:
      color 0.3s ease,
      gap 0.35s var(--ease);
  }

  .mega-link__line {
    flex: none;
    width: 0;
    height: 1px;
    margin-right: -10px;
    background: var(--peach);
    transition:
      width 0.35s var(--ease),
      margin 0.35s var(--ease);
  }

  .mega-link.is-active {
    color: var(--peach);
  }

  .mega-link.is-active .mega-link__line {
    width: 18px;
    margin-right: 0;
  }
</style>
