---
import { ADVISOR_MESSAGE } from '../../data/chat.js';
import { whatsappUrl } from '../../scripts/utils/whatsapp.js';
---

<a
  class="advisor"
  href={whatsappUrl(ADVISOR_MESSAGE)}
  target="_blank"
  rel="noopener"
  aria-label="¿No sabes cuál elegir? Te asesoramos por WhatsApp"
  transition:persist="advisor"
>
  <span class="advisor__icon">
    <span class="pulse-ring"></span>
    <img src="/assets/img/whatsapp_white.svg" alt="" />
  </span>
  <span class="advisor__text">
    <span class="advisor__title">¿No sabes cuál elegir? Te asesoramos</span>
    <span class="advisor__note">Sara y Brayan responden en persona</span>
  </span>
</a>

<style>
  .advisor {
    position: fixed;
    right: clamp(12px, 2vw, 24px);
    bottom: clamp(12px, 2vw, 24px);
    z-index: var(--z-whatsapp);
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 5px;
    border-radius: var(--radius-pill);
    background: var(--navy-deep);
    border: 1px solid rgb(var(--peach-rgb) / 0.35);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.45);
    color: var(--white);
  }

  .advisor:hover {
    border-color: var(--peach);
    color: var(--white);
  }

  .advisor__icon {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--whatsapp);
    color: var(--whatsapp);
  }

  .advisor__icon img {
    width: 24px;
    height: 24px;
  }

  .advisor__text {
    display: none;
    flex-direction: column;
    gap: 6px;
    padding-right: 20px;
  }

  .advisor__title {
    font: 700 14px/1 var(--font-sans);
  }

  .advisor__note {
    font: italic 400 14px/1 var(--font-serif);
    color: var(--peach);
  }

  @media (min-width: 1180px) {
    .advisor__text {
      display: flex;
    }

    :global(.has-sticky-buy) .advisor__text {
      display: none;
    }
  }
</style>
