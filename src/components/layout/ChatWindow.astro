---
import { ADVISOR_MESSAGE, CHAT_CHIPS } from '../../data/chat.js';
import { whatsappUrl } from '../../scripts/utils/whatsapp.js';
import Icon from '../ui/Icon.astro';
import ChatChip from './ChatChip.astro';
---

<div class="chat" data-reveal="up" style="--reveal-delay:200ms">
  <div class="chat__head">
    <div class="chat__avatars" aria-hidden="true">
      <span class="chat__avatar">S</span>
      <span class="chat__avatar chat__avatar--wine">B</span>
    </div>
    <div class="chat__who">
      <p class="chat__name">Sara y Brayan</p>
      <p class="chat__status" data-chat-status>
        en línea
      </p>
    </div>
    <img src="/assets/img/whatsapp_white.svg" alt="" class="chat__wa" />
  </div>
  <div class="chat__messages" data-chat-messages aria-live="off">
    <div class="chat__typing" data-chat-typing hidden>
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
  <div class="chat__bottom">
    <div class="chat__chips">
      {CHAT_CHIPS.map((question) => (
        <ChatChip question={question} />
      ))}
    </div>
    <a class="chat__input" href={whatsappUrl(ADVISOR_MESSAGE)} target="_blank" rel="noopener">
      <span>Escribe tu mensaje…</span>
      <span class="chat__send">
        <Icon name="send" size={16} />
      </span>
    </a>
  </div>
  <template data-chat-bubble>
    <p class="chat__bubble"></p>
  </template>
</div>

<style>
  .chat {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 460px;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--navy-deep);
    border: 1px solid rgb(var(--peach-rgb) / 0.25);
    box-shadow: var(--shadow-float);
  }

  .chat__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    background: rgb(var(--white-rgb) / 0.04);
    border-bottom: 1px solid var(--line-faint);
  }

  .chat__avatars {
    display: flex;
  }

  .chat__avatar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--navy-deep);
    background: var(--peach);
    color: var(--navy);
    font: italic 500 18px/1 var(--font-serif);
  }

  .chat__avatar--wine {
    margin-left: -12px;
    background: var(--wine);
    color: var(--sand);
  }

  .chat__who {
    flex: 1;
    min-width: 0;
  }

  .chat__name {
    margin: 0 0 4px;
    font: 700 15px/1.1 var(--font-sans);
  }

  .chat__status {
    margin: 0;
    font: 500 12px/1 var(--font-sans);
    color: var(--whatsapp);
  }

  .chat__wa {
    width: 20px;
    height: 20px;
    opacity: 0.6;
  }

  .chat__messages {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    height: 330px;
    padding: 18px;
    overflow: hidden;
    background-image: radial-gradient(rgb(var(--peach-rgb) / 0.06) 1px, transparent 1px);
    background-size: 16px 16px;
  }

  .chat__bubble {
    align-self: flex-start;
    max-width: 82%;
    margin: 0;
    padding: 10px 14px;
    border-radius: 18px 18px 18px 4px;
    background: rgb(var(--white-rgb) / 0.08);
    border: 1px solid rgb(var(--peach-rgb) / 0.18);
    font: 500 14px/1.45 var(--font-sans);
    transform-origin: 0 100%;
    animation: bubble-in 0.45s var(--ease) both;
  }

  .chat__bubble.is-customer {
    align-self: flex-end;
    border: 0;
    border-radius: 18px 18px 4px 18px;
    background: var(--peach);
    color: var(--navy);
    transform-origin: 100% 100%;
  }

  .chat__typing {
    display: flex;
    align-self: flex-start;
    gap: 5px;
    padding: 14px 16px;
    border-radius: 18px 18px 18px 4px;
    background: rgb(var(--white-rgb) / 0.08);
    border: 1px solid rgb(var(--peach-rgb) / 0.18);
    animation: bubble-in 0.3s ease both;
  }

  .chat__typing span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sand);
    animation: typing-dot 1.1s ease-in-out infinite;
  }

  .chat__typing span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .chat__typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  .chat__bottom {
    padding: 14px 16px 16px;
    border-top: 1px solid var(--line-faint);
  }

  .chat__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
  }

  .chat__input {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 6px 0 18px;
    border-radius: var(--radius-pill);
    background: rgb(var(--white-rgb) / 0.06);
    color: rgb(var(--white-rgb) / 0.5);
    font: 500 14px/1 var(--font-sans);
  }

  .chat__input:hover {
    background: rgb(var(--white-rgb) / 0.1);
    color: rgb(var(--white-rgb) / 0.7);
  }

  .chat__input span:first-child {
    flex: 1;
  }

  .chat__send {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--whatsapp);
    color: var(--white);
  }
</style>
