---
import { TRACKS } from '../../data/tracks.js';
import Icon from '../ui/Icon.astro';
import TrackItem from './TrackItem.astro';
---

<div
  class="player"
  role="region"
  aria-label="ScentScape Sessions"
  data-player
  transition:persist="music-player"
>
  <div class="player__card" data-player-list>
    <div class="player__head">
      <p class="player__label">ScentScape Sessions</p>
      <button class="player__next" type="button" data-player-next>
        Siguiente ›
      </button>
    </div>
    <div class="player__tracks">
      {TRACKS.map((track, index) => (
        <TrackItem track={track} index={index} />
      ))}
    </div>
    <label class="player__volume">
      <span>VOL</span>
      <input type="range" min="0" max="100" value="60" data-player-volume aria-label="Volumen" />
    </label>
  </div>
  <div class="player__pill">
    <button
      class="player__disc"
      type="button"
      data-player-list-toggle
      aria-label="Playlist"
      title="Playlist"
    >
      <span class="player__vinyl">
        <span></span>
      </span>
    </button>
    <button class="player__info" type="button" data-player-list-toggle>
      <span class="player__title" data-player-title>
        {TRACKS[0].title}
      </span>
      <span class="player__time" data-player-time>
        0:00 · en pausa
      </span>
    </button>
    <button class="player__play" type="button" data-player-play aria-label="Reproducir">
      <Icon name="play" size={12} class="player__when-paused" />
      <Icon name="pause" size={12} class="player__when-playing" />
    </button>
    <button class="player__mute" type="button" data-player-mute aria-label="Silenciar">
      <Icon name="volume" size={16} class="player__when-sound" />
      <Icon name="mute" size={16} class="player__when-muted" />
    </button>
  </div>
</div>

<style>
  .player {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: var(--z-player);
    color: var(--cream);
  }

  .player__pill {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 48px;
    padding: 0 4px;
    border: 1px solid rgb(var(--peach-rgb) / 0.22);
    border-radius: var(--radius-pill);
    background: rgb(var(--navy-rgb) / 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 20px 40px rgb(0 0 0 / 0.35);
  }

  .player button {
    flex: none;
    padding: 0;
    border: 0;
  }

  .player__disc {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: none;
  }

  .player__vinyl {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      var(--peach),
      var(--wine) 25%,
      var(--navy) 50%,
      var(--sand) 75%,
      var(--peach)
    );
    box-shadow:
      inset 0 0 0 6px var(--navy),
      inset 0 0 0 7px rgb(var(--peach-rgb) / 0.4);
    animation: spin 3.5s linear infinite paused;
  }

  .player[data-playing]:not([data-muted]) .player__vinyl {
    animation-play-state: running;
  }

  .player__vinyl span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 10px;
    margin: -5px;
    border: 2px solid var(--navy);
    border-radius: 50%;
    background: var(--peach);
  }

  .player__info {
    display: none;
    width: 150px;
    padding: 0 6px !important;
    background: none;
    color: var(--cream);
    text-align: left;
  }

  .player__title {
    display: block;
    overflow: hidden;
    font: 700 12px/1.15 var(--font-sans);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .player__time {
    display: block;
    color: rgb(var(--cream-rgb) / 0.6);
    font: 500 10px/1.4 var(--font-sans);
  }

  .player__play,
  .player__mute {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
  }

  .player__play {
    background: var(--peach);
    color: var(--navy);
  }

  .player[data-waiting] .player__play {
    animation: wait-pulse 1.6s ease-out infinite;
  }

  .player__mute {
    background: none;
    color: var(--cream);
  }

  .player:not([data-playing]) :global(.player__when-playing),
  .player[data-playing] :global(.player__when-paused),
  .player:not([data-muted]) :global(.player__when-muted),
  .player[data-muted] :global(.player__when-sound) {
    display: none;
  }

  .player__card {
    position: absolute;
    right: 0;
    bottom: 60px;
    display: none;
    width: min(330px, calc(100vw - 24px));
    padding: 18px;
    border-radius: 26px;
    background: var(--peach);
    color: var(--navy);
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.45);
    animation: card-in 0.35s var(--ease-soft);
  }

  .player[data-list-open] .player__card {
    display: block;
  }

  .player__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .player__label {
    margin: 0;
    font: 700 11px/1 var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .player__next {
    height: 30px;
    padding: 0 12px !important;
    border: 1px solid var(--navy) !important;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--navy);
    font: 700 11px/1 var(--font-sans);
  }

  .player__tracks {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 14px;
  }

  .player__volume {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 700 11px/1 var(--font-sans);
  }

  .player__volume input {
    flex: 1;
  }

  @keyframes wait-pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(var(--peach-rgb) / 0.55);
    }
    100% {
      box-shadow: 0 0 0 14px rgb(var(--peach-rgb) / 0);
    }
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 640px) {
    .player__info {
      display: block;
    }
  }

  /* Handy: näher an die Ecke, damit er weniger vom Inhalt verdeckt */
  @media (max-width: 639px) {
    .player {
      right: 12px;
      bottom: max(12px, env(safe-area-inset-bottom));
    }
  }

  /* Liegt unten eine feste Leiste (z. B. Gift Card), rückt der Player darüber */
  @media (max-width: 899px) {
    .player {
      transition: bottom 0.5s var(--ease);
    }

    :global(html.has-bottom-bar) .player {
      bottom: calc(92px + env(safe-area-inset-bottom));
    }
  }

  /* Bei offenem Menü ausblenden, damit nichts über den Links liegt */
  .player {
    transition:
      bottom 0.5s var(--ease),
      opacity 0.4s;
  }

  :global(html.is-menu-open) .player {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  import { initMusicPlayer } from '../../scripts/features/music/player.js';
  import { onFirstPage } from '../../scripts/core/lifecycle.js';

  onFirstPage(initMusicPlayer);
</script>
