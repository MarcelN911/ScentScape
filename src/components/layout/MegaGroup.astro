---
import MegaLink from './MegaLink.astro';

/** @typedef {{ group: { label: string, items: object[] } }} Props */
const { group } = Astro.props;
---

<div class="mega-group">
  <p class="mega-group__label">
    {group.label}
    <span aria-hidden="true"></span>
  </p>
  {group.items.map((item) => (
    <MegaLink item={item} />
  ))}
</div>

<style>
  .mega-group {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .mega-group__label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 10px;
    font: italic 400 17px/1 var(--font-serif);
    color: var(--peach);
  }

  .mega-group__label span {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgb(var(--peach-rgb) / 0.35), transparent);
  }
</style>
