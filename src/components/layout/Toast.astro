<div class="toast" role="status" aria-live="polite" data-toast transition:persist="toast">
  <span data-toast-text></span>
  <span class="toast__bag" data-toast-bag hidden>
    Bolsa (<span data-cart-count>0</span>)
  </span>
</div>

<style>
  .toast {
    position: fixed;
    left: 50%;
    bottom: 26px;
    z-index: var(--z-toast);
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 24px;
    border-radius: 28px;
    background: var(--sand);
    color: var(--navy);
    font: 400 13px var(--font-sans);
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, 30px);
    transition:
      transform 0.6s var(--ease),
      opacity 0.4s;
    pointer-events: none;
  }

  .toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .toast__bag {
    font-weight: 600;
  }
</style>

<script>
  import { EVENTS, listen } from '../../scripts/core/events.js';

  const toast = document.querySelector('[data-toast]');
  let timer = 0;

  function show({ message, cart = false }) {
    toast.querySelector('[data-toast-text]').textContent = message;
    toast.querySelector('[data-toast-bag]').hidden = !cart;
    toast.classList.add('is-visible');
    clearTimeout(timer);
    timer = setTimeout(() => toast.classList.remove('is-visible'), 2600);
  }

  listen(EVENTS.toast, show);
</script>
