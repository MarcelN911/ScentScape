---
/* Linke Bühne von "Contacto": Karte in Azul noche mit WhatsApp groß, darunter Instagram, Correo, Ubicación. */
import { EMAIL, INSTAGRAM_HANDLE, PHONE_DISPLAY, WHATSAPP_NUMBER } from '../../scripts/config.js';

const details = [
  ['Instagram', INSTAGRAM_HANDLE],
  ['Correo', EMAIL],
  ['Ubicación', 'Medellín, CO'],
];
---

<div class="pass reveal-late" style="--late:0.6s">
  <span class="pass__light"></span>
  <span class="pass__rings"></span>
  <span class="pass__frame"></span>
  <div class="pass__content">
    <div class="pass__top">
      <img src="/assets/img/scentscape-logo.png" alt="ScentScape" />
      <span>
        <i></i>Envíos a todo el país
      </span>
    </div>
    <div class="pass__main">
      <span class="pass__live">
        <i></i>WhatsApp · Canal principal
      </span>
      <a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener">
        {PHONE_DISPLAY}
      </a>
    </div>
    <div class="pass__details">
      {details.map(([label, value]) => (
        <span>
          <small>{label}</small>
          <span>{value}</span>
        </span>
      ))}
    </div>
  </div>
</div>

<style>
  .pass {
    position: relative;
    width: min(100%, 600px);
    aspect-ratio: 1.586;
    overflow: hidden;
    container-type: inline-size;
    border-radius: 22px;
    background: linear-gradient(150deg, #262c63, var(--navy-card) 60%, #12152b);
    box-shadow:
      0 50px 100px rgb(0 0 0 / 0.55),
      0 0 0 1px rgb(var(--cream-rgb) / 0.06);
    color: var(--sand);
  }

  .pass__light,
  .pass__rings,
  .pass__frame {
    position: absolute;
    inset: 0;
  }

  .pass__light {
    background: radial-gradient(120% 80% at 100% 0%, rgb(var(--cream-rgb) / 0.12), transparent 55%);
  }

  .pass__rings {
    opacity: 0.5;
    background: repeating-radial-gradient(
      circle at 115% -15%,
      transparent 0 22px,
      rgb(240 210 170 / 0.4) 22px 23px
    );
    mask-image: linear-gradient(200deg, #000, transparent 65%);
  }

  .pass__frame {
    inset: 12px;
    border: 1px solid rgb(var(--sand-rgb) / 0.4);
    border-radius: 14px;
  }

  .pass__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(22px, 6.5%, 38px);
  }

  .pass__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .pass__top img {
    display: block;
    height: clamp(18px, 5cqw, 28px);
  }

  .pass__top span {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 600 9px var(--font-sans);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .pass__top i {
    width: 18px;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  .pass__main {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pass__live {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 600 8px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .pass__live i {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background: var(--whatsapp);
    box-shadow: 0 0 8px var(--whatsapp);
  }

  .pass__main a {
    color: var(--sand-light);
    font: 400 clamp(24px, 8.4cqw, 46px) / 1 var(--font-serif);
    font-variant-numeric: lining-nums;
  }

  .pass__main a:hover {
    color: var(--cream);
  }

  .pass__details {
    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr;
    gap: 4cqw;
    padding-top: 3.4cqw;
    border-top: 1px solid rgb(var(--sand-rgb) / 0.25);
  }

  .pass__details > span {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .pass__details small {
    font: 600 7px var(--font-sans);
    letter-spacing: 2.5px;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .pass__details span span {
    overflow: hidden;
    color: var(--sand-light);
    font: 400 clamp(10px, 2.5cqw, 14px) / 1.3 var(--font-sans);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
</style>
