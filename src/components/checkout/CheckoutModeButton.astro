---
/** @typedef {{ mode: { key: string, title: string } }} Props */
const { mode } = Astro.props;
---

<button class="mode" type="button" data-checkout-mode={mode.key} aria-pressed="false">
  {mode.title}
</button>

<style>
  .mode {
    height: 42px;
    padding: 0 18px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(var(--peach-rgb) / 0.35);
    background: transparent;
    font: 600 13px/1 var(--font-sans);
    transition: all 0.3s var(--ease);
  }

  .mode[aria-pressed='true'] {
    border-color: var(--peach);
    background: var(--peach);
    color: var(--navy);
  }
</style>
