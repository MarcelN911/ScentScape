---
/** @typedef {{ step: { number: string, label: string }, index: number }} Props */
const { step, index } = Astro.props;
---

<span class="step" data-checkout-step={index}>
  <span class="step__number">{step.number}</span>
  {step.label}
</span>

<style>
  .step {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(var(--peach-rgb) / 0.25);
    font: 600 12px/1 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.45);
    transition: all 0.4s var(--ease);
  }

  .step.is-done,
  .step.is-current {
    border-color: var(--peach);
    color: var(--sand);
  }

  .step.is-current {
    background: rgb(var(--peach-rgb) / 0.14);
  }

  .step__number {
    font: italic 400 15px/1 var(--font-serif);
  }
</style>
