---
/** @typedef {{ field: { name: string, label: string, placeholder: string, type: string, autocomplete: string, wide?: boolean, required?: boolean } }} Props */
const { field } = Astro.props;
---

<label class:list={['field', { 'field--wide': field.wide }]}>
  {field.label}
  <input
    class="field__input"
    name={field.name}
    type={field.type}
    placeholder={field.placeholder}
    autocomplete={field.autocomplete}
    required={field.required}
    inputmode={field.type === 'tel' ? 'tel' : undefined}
  />
</label>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgb(var(--white-rgb) / 0.6);
  }

  .field--wide {
    grid-column: 1 / -1;
  }

  .field__input {
    height: 52px;
    padding: 0 18px;
    border-radius: 14px;
    border: 1px solid rgb(var(--peach-rgb) / 0.3);
    background: rgb(var(--white-rgb) / 0.04);
    font: 500 15px/1 var(--font-sans);
    letter-spacing: 0;
    text-transform: none;
    outline: none;
    transition: border-color 0.3s;
  }

  .field__input:focus {
    border-color: var(--peach);
  }
</style>
