---
/* Bewertungskarte im Karussell von "Servicios". Die aktive Karte (.is-active) lässt ihre Sterne aufleuchten. */
import { initialOf } from '../../scripts/utils/text.js';

/** @typedef {{ review: object }} Props */
const { review } = Astro.props;
const stars = [0, 1, 2, 3, 4].map((index) => ({
  filled: index < review.rating,
  style: `--i:${index}`,
}));
---

<article class="panel-card" data-panel-card>
  <span class="panel-card__stars" aria-label={`${review.rating} de 5`}>
    {stars.map((star) => (
      <span class:list={{ 'is-filled': star.filled }} style={star.style}>
        ★
      </span>
    ))}
  </span>
  <blockquote>“{review.text}”</blockquote>
  <footer>
    <span class="panel-card__ini">{initialOf(review.name)}</span>
    <span class="panel-card__who">
      <strong>{review.name}</strong>
      <span>{review.city}</span>
    </span>
  </footer>
</article>

<style>
  .panel-card {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    flex-direction: column;
    gap: 22px;
    width: var(--card-w);
    margin-left: calc(var(--card-w) / -2);
    padding: clamp(24px, 3vw, 40px);
    border-radius: 22px;
    background: linear-gradient(160deg, #f7eee2, #ebd7ba);
    box-shadow: 0 40px 80px rgb(0 0 0 / 0.45);
    color: var(--navy-card);
    opacity: 0;
    transform: translateY(-50%);
    cursor: pointer;
    will-change: transform, opacity;
  }

  .panel-card__stars {
    display: flex;
    gap: 5px;
  }

  .panel-card__stars span {
    display: inline-block;
    color: rgb(var(--wine-rgb) / 0.18);
    font-size: 18px;
    line-height: 1;
    transform: scale(0.6);
    transition:
      color 0.4s,
      transform 0.5s cubic-bezier(0.3, 1.7, 0.5, 1);
    transition-delay: calc(0.15s + var(--i) * 0.08s);
  }

  .panel-card:global(.is-active) .panel-card__stars span.is-filled {
    color: var(--wine);
    transform: none;
  }

  .panel-card blockquote {
    margin: 0;
    font: italic 400 clamp(20px, 1.8vw, 28px) / 1.3 var(--font-serif);
    text-wrap: pretty;
  }

  .panel-card footer {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid rgb(var(--navy-card-rgb) / 0.12);
  }

  .panel-card__ini {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: var(--navy-card);
    color: var(--sand);
    font: italic 400 19px var(--font-serif);
  }

  .panel-card__who {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .panel-card__who strong {
    font: 500 15px var(--font-sans);
  }

  .panel-card__who span {
    color: rgb(var(--navy-card-rgb) / 0.6);
    font: 500 10px var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
  }
</style>
