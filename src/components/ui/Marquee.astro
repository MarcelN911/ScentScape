---
/**
 * Laufband: die Einträge stehen zweimal hintereinander, damit die Schleife nahtlos ist.
 * @typedef {object} Props
 * @property {string[]} items
 * @property {string} separator
 * @property {boolean} [reverse]
 * @property {string} [class]
 */
const { items, separator, reverse = false, class: className } = Astro.props;
---

<div class:list={['marquee', { 'marquee--reverse': reverse }, className]}>
  <span class="marquee__track">
    {[0, 1].map((copy) => (
      <span class="marquee__group" aria-hidden={copy === 1 ? 'true' : undefined}>
        {items.map((item) => (
          <>
            <span>{item}</span>
            <span aria-hidden="true">{separator}</span>
          </>
        ))}
      </span>
    ))}
  </span>
</div>
