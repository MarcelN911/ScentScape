---
import { ADDI_ENABLED } from '../../scripts/config.js';
import Icon from './Icon.astro';
import PaymentTile from './PaymentTile.astro';
---

<div class="payments">
  <PaymentTile label="Nequi" background="#200647">
    <span class="payments__nequi">Nequi</span>
  </PaymentTile>
  <PaymentTile label="Daviplata" background="#e1251b">
    <span class="payments__davi">
      Davi<span>Plata</span>
    </span>
  </PaymentTile>
  <PaymentTile label="Bancolombia · PSE" variant="dark">
    <span class="payments__row">
      <span class="payments__pse">PSE</span>
      <Icon name="bank" size={18} strokeWidth={1.6} />
    </span>
  </PaymentTile>
  <PaymentTile label="Crédito / débito" variant="dark">
    <span class="payments__row">
      <Icon name="card" size={24} strokeWidth={1.6} />
      <span class="payments__mc">
        <span></span>
        <span></span>
      </span>
    </span>
  </PaymentTile>
  <PaymentTile label="Wompi" background="#b0f2ae">
    <span class="payments__wompi">wompi</span>
  </PaymentTile>
  <PaymentTile label="Contraentrega" variant="dark">
    <Icon name="cash" size={24} strokeWidth={1.6} />
  </PaymentTile>
  {ADDI_ENABLED ? (
    <PaymentTile label="4 cuotas" background="#00b4e6">
      <span class="payments__addi">addi</span>
    </PaymentTile>
  ) : (
    <PaymentTile label="Próximamente" variant="outline">
      <span class="payments__addi">addi</span>
    </PaymentTile>
  )}
</div>

<style>
  .payments {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .payments__nequi {
    color: #da0081;
  }

  .payments__davi {
    font-size: 13px;
    color: var(--white);
  }

  .payments__davi span {
    font-weight: 400;
  }

  .payments__row {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .payments__pse {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #1d4f91;
    color: var(--white);
    font: 800 8px/1 var(--font-sans);
  }

  .payments__mc {
    display: flex;
  }

  .payments__mc span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #eb001b;
  }

  .payments__mc span + span {
    margin-left: -5px;
    background: #f79e1b;
    opacity: 0.9;
  }

  .payments__wompi {
    color: #1c1c1c;
  }

  .payments__addi {
    font-size: 16px;
    color: var(--white);
  }
</style>
