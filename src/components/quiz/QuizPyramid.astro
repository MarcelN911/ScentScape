---
/* Pyramide links: füllt sich, sobald Familien gewählt sind. Texte setzt scripts/features/quiz/view.js. */
import { QUIZ_TIERS } from '../../data/quiz.js';
---

<div class="qp" data-quiz-pyramid>
  <div class="qp__shapes">
    {QUIZ_TIERS.map((tier, index) => (
      <div
        class="qp__shape"
        style={`width:${tier.width}%;clip-path:${tier.clip};--fill:${tier.fill}`}
        data-tier-shape={index}
      ></div>
    ))}
  </div>
  <div class="qp__table">
    {QUIZ_TIERS.map((tier, index) => (
      <div class="qp__row">
        <span class="qp__label">{tier.label}</span>
        <span class="qp__notes" data-tier-notes={index}>
          —
        </span>
      </div>
    ))}
  </div>
  <span class="qp__count">
    <span data-quiz-done>0</span> / 4 respondidas
  </span>
</div>

<style>
  .qp {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    width: min(100%, 460px);
  }

  .qp__shapes {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 100%;
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 1s 0.6s,
      transform 1.4s var(--ease) 0.6s;
  }

  .qp__shape {
    height: clamp(60px, 12vh, 120px);
    background: rgb(var(--sand-rgb) / 0.08);
    transition: background 0.8s;
  }

  .qp__shape.is-filled {
    background: var(--fill);
  }

  .qp__table,
  .qp__count {
    opacity: 0;
    transition: opacity 0.8s 1.4s;
  }

  .qp__table {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .qp__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid rgb(var(--peach-rgb) / 0.15);
  }

  .qp__label {
    color: var(--peach);
    font: 400 10px var(--font-sans);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .qp__notes {
    color: rgb(var(--cream-rgb) / 0.35);
    font: italic 400 18px/1.3 var(--font-serif);
    text-align: right;
    transition: color 0.6s;
  }

  .qp__notes.is-filled {
    color: var(--sand);
  }

  .qp__count {
    color: rgb(var(--cream-rgb) / 0.6);
    font: 400 10px var(--font-sans);
    letter-spacing: 4px;
    text-transform: uppercase;
    transition-delay: 1.6s;
  }

  :global(.is-in) .qp__shapes,
  :global(.is-in) .qp__table,
  :global(.is-in) .qp__count {
    opacity: 1;
    transform: none;
  }
</style>
