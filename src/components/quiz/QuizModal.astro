---
import { QUIZ_STEPS } from '../../data/quiz.js';
import QuizResult from './QuizResult.astro';
import QuizStep from './QuizStep.astro';

const ROMAN = ['I', 'II', 'III'];
---

<div class="quiz" data-quiz hidden transition:persist="quiz">
  <div class="quiz__backdrop" data-quiz-close></div>
  <div
    class="quiz__dialog frame hatch"
    role="dialog"
    aria-modal="true"
    aria-labelledby="quiz-title"
  >
    <button class="quiz__close" type="button" data-quiz-close aria-label="Cerrar">
      ×
    </button>
    <div>
      <p class="quiz__progress">
        Descubre tu esencia · <span data-quiz-done>0</span> / 3
      </p>
      <h2 class="quiz__title" id="quiz-title">
        Tu aroma en <em>tres toques.</em>
      </h2>
      <div class="quiz__steps">
        {QUIZ_STEPS.map((step, index) => (
          <QuizStep step={step} number={ROMAN[index]} />
        ))}
      </div>
    </div>
    <QuizResult />
  </div>
</div>

<style>
  .quiz {
    position: fixed;
    inset: 0;
    z-index: var(--z-quiz);
  }

  .quiz__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(5 6 15 / 0.6);
    backdrop-filter: blur(8px);
    animation: fade-in 0.4s ease;
  }

  .quiz__dialog {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    align-items: center;
    gap: clamp(20px, 3vw, 40px);
    width: min(1100px, calc(100vw - 24px));
    max-height: calc(100vh - 24px);
    overflow-y: auto;
    padding: clamp(22px, 3vw, 40px);
    border-radius: 8px;
    box-shadow: 0 50px 100px rgb(0 0 0 / 0.5);
    transform: translate(-50%, -50%);
  }

  .quiz__close {
    position: absolute;
    top: 18px;
    right: 18px;
    z-index: 2;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 50%;
    background: var(--peach);
    color: var(--navy);
    font-size: 22px;
  }

  .quiz__progress {
    display: inline-block;
    margin: 0 0 16px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(var(--peach-rgb) / 0.4);
    color: var(--peach);
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .quiz__title {
    margin: 0 0 28px;
    font: 500 clamp(38px, 4.4vw, 64px) / 0.92 var(--font-serif);
    letter-spacing: -0.015em;
  }

  .quiz__title em {
    font: italic 400 1.05em/1 var(--font-serif);
    letter-spacing: 0;
    color: var(--peach);
  }

  .quiz__steps {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
</style>
