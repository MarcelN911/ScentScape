---
import {
  catalogMetaOf,
  catalogNotesOf,
  catalogPriceOf,
} from '../../scripts/catalog/catalog-entry.js';
import { accentOf } from '../../scripts/catalog/theme.js';
import { imageUrl } from '../../scripts/utils/image.js';

/** @typedef {{ product: object }} Props */
const { product } = Astro.props;
---

<article class="print-item" style={`--accent:${accentOf(product)}`}>
  <div class="print-item__image">
    <img src={imageUrl(product.images[0], 400)} alt={product.name} />
  </div>
  <div class="print-item__text">
    <p class="print-item__meta">{catalogMetaOf(product)}</p>
    <h3 class="print-item__name">{product.name}</h3>
    <p class="print-item__notes">{catalogNotesOf(product, 6)}</p>
    <p class="print-item__price">
      {catalogPriceOf(product)} <span>COP</span>
    </p>
  </div>
</article>

<style>
  .print-item {
    display: grid;
    grid-template-columns: 1.3in minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: 14px;
    border: 1px solid rgb(176 138 90 / 0.5);
    break-inside: avoid;
  }

  .print-item__image {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.5in;
    background: radial-gradient(
      circle at 50% 45%,
      color-mix(in oklch, var(--accent) 22%, #fff) 0%,
      #fff 72%
    );
  }

  .print-item__image img {
    height: 88%;
    max-width: 85%;
    object-fit: contain;
  }

  .print-item__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .print-item__meta {
    margin: 0;
    font: 600 9px/1.3 var(--font-sans);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--wine);
  }

  .print-item__name {
    margin: 0;
    font: 500 19px/1.1 var(--font-serif);
  }

  .print-item__notes {
    margin: 0;
    font: 400 12px/1.45 var(--font-sans);
    color: #4a4a5a;
  }

  .print-item__price {
    margin: 4px 0 0;
    font: 500 17px/1 var(--font-serif);
  }

  .print-item__price span {
    font: 600 10px/1 var(--font-sans);
    letter-spacing: 1px;
    color: #4a4a5a;
  }
</style>
