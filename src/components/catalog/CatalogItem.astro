---
import {
  catalogMetaOf,
  catalogNotesOf,
  catalogPriceOf,
} from '../../scripts/catalog/catalog-entry.js';
import { accentOf } from '../../scripts/catalog/theme.js';
import { imageUrl } from '../../scripts/utils/image.js';

/** @typedef {{ product: object }} Props */
const { product } = Astro.props;
---

<a class="catalog-item" href={`/producto/${product.slug}/`} style={`--accent:${accentOf(product)}`}>
  <div class="catalog-item__image">
    <img src={imageUrl(product.images[0], 500)} alt={product.name} loading="lazy" />
  </div>
  <p class="catalog-item__meta">{catalogMetaOf(product)}</p>
  <h3 class="catalog-item__name">{product.name}</h3>
  <p class="catalog-item__notes">{catalogNotesOf(product, 5)}</p>
  <div class="catalog-item__foot">
    <span class="catalog-item__price">{catalogPriceOf(product)}</span>
    <span class="catalog-item__more">Ver →</span>
  </div>
</a>

<style>
  .catalog-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px;
    background: var(--navy);
    color: var(--white);
  }

  .catalog-item:hover {
    background: var(--navy-raised);
    color: var(--white);
  }

  .catalog-item__image {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 200px;
    border-radius: 4px;
    background: radial-gradient(
      circle at 50% 45%,
      color-mix(in oklch, var(--accent) 55%, var(--navy)) 0%,
      transparent 70%
    );
  }

  .catalog-item__image img {
    height: 88%;
    max-width: 80%;
    object-fit: contain;
    filter: drop-shadow(0 20px 26px rgb(0 0 0 / 0.5));
  }

  .catalog-item__meta {
    margin: 6px 0 0;
    font: 600 10px/1.3 var(--font-sans);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--peach);
  }

  .catalog-item__name {
    margin: 0;
    font: 500 22px/1.1 var(--font-serif);
  }

  .catalog-item__notes {
    margin: 0;
    font: 400 13px/1.5 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.65);
  }

  .catalog-item__foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    margin-top: auto;
    padding-top: 8px;
  }

  .catalog-item__price {
    font: 500 20px/1 var(--font-serif);
    color: var(--sand);
  }

  .catalog-item__more {
    font: 600 12px/1 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.6);
  }
</style>
