---
import { REVIEW_ROTATIONS } from '../../data/home.js';
import { starsOf } from '../../scripts/catalog/reviews.js';
import { initialOf } from '../../scripts/utils/text.js';

/** @typedef {{ review: object, index: number }} Props */
const { review, index } = Astro.props;
const DIRECTIONS = [-1, 0, 1];
const style = `--rotate:${REVIEW_ROTATIONS[index % REVIEW_ROTATIONS.length]}deg`;
---

<div data-review-fly={DIRECTIONS[index % 3]}>
  <div>
    <article class:list={['review-note', { 'review-note--peach': index % 3 === 1 }]} style={style}>
      <div class="review-note__top">
        <span class="review-note__stars" aria-label={`${review.rating} de 5`}>
          {starsOf(review.rating)}
        </span>
        <span class="review-note__quote" aria-hidden="true">
          “
        </span>
      </div>
      <p class="review-note__text">{review.text}</p>
      <div class="review-note__author">
        <span class="review-note__initial">{initialOf(review.name)}</span>
        <span class="review-note__who">
          <span class="review-note__name">{review.name}</span>
          {review.city && <span class="review-note__city">{review.city}</span>}
        </span>
      </div>
    </article>
  </div>
</div>

<style>
  .review-note {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 250px;
    padding: 26px;
    border-radius: 28px;
    background: var(--sand);
    box-shadow: 0 24px 50px rgb(0 0 0 / 0.3);
    color: var(--navy);
    transform: rotate(var(--rotate));
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1.4);
  }

  .review-note--peach {
    background: var(--peach);
  }

  .review-note:hover {
    transform: rotate(0deg) translateY(-10px) scale(1.02);
  }

  .review-note__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .review-note__stars {
    letter-spacing: 2px;
    color: var(--wine);
  }

  .review-note__quote {
    font: 800 40px/0 var(--font-serif);
    color: var(--gold);
  }

  .review-note__text {
    margin: 0;
    font: 600 19px/1.35 var(--font-sans);
    letter-spacing: -0.01em;
  }

  .review-note__author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }

  .review-note__initial {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--peach);
    font: 800 16px/1 var(--font-sans);
  }

  .review-note__who {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .review-note__name {
    font: 700 13px/1 var(--font-sans);
  }

  .review-note__city {
    font: 500 12px/1 var(--font-sans);
    opacity: 0.6;
  }
</style>
