---
/** Kleine Gift Card, schräg gelegt (Karte "Gift card") */
---

<div class="gift-art">
  <div class="gift-art__card">
    <span class="gift-art__line"></span>
    <div class="gift-art__content">
      <div class="gift-art__top">
        <img src="/assets/img/scentscape-logo.png" alt="" height="26" />
        <span>Gift card</span>
      </div>
      <span class="gift-art__amount">$200.000</span>
    </div>
  </div>
</div>

<style>
  .gift-art {
    position: absolute;
    right: -8%;
    top: 8%;
    width: 78%;
    max-width: 440px;
  }

  .gift-art__card {
    position: relative;
    aspect-ratio: 1.586 / 1;
    overflow: hidden;
    border-radius: 18px;
    background: radial-gradient(ellipse at 28% 18%, #8a1230 0%, var(--wine) 55%, #3a0110 100%);
    box-shadow: 0 40px 70px rgb(0 0 0 / 0.55);
    color: var(--sand);
    transform: rotate(-9deg);
  }

  .gift-art__line {
    position: absolute;
    inset: 10px;
    border: 1px solid rgb(var(--sand-rgb) / 0.5);
    border-radius: 12px;
    outline: 1px solid rgb(var(--sand-rgb) / 0.2);
    outline-offset: -5px;
  }

  .gift-art__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 26px 28px;
  }

  .gift-art__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font: 600 9px/1 var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .gift-art__top img {
    width: auto;
    height: 26px;
  }

  .gift-art__amount {
    font: 500 44px/1 var(--font-serif);
    color: var(--white);
  }
</style>
