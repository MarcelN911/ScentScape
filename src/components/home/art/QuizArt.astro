---
/** Ringe mit schwebender Flasche (Karte "Test olfativo") */
/** @typedef {{ image: string }} Props */
const { image } = Astro.props;
---

<div class="quiz-art">
  <span class="quiz-art__ring quiz-art__ring--outer"></span>
  <span class="quiz-art__ring quiz-art__ring--middle"></span>
  <span class="quiz-art__ring quiz-art__ring--inner"></span>
  <img class="quiz-art__bottle anim-float" src={image} alt="" loading="lazy" />
</div>

<style>
  .quiz-art {
    position: absolute;
    right: -6%;
    top: -8%;
    width: 62%;
    aspect-ratio: 1;
  }

  .quiz-art__ring {
    position: absolute;
    border-radius: 50%;
  }

  .quiz-art__ring--outer {
    inset: 0;
    border: 1px solid rgb(var(--peach-rgb) / 0.22);
  }

  .quiz-art__ring--middle {
    inset: 14%;
    border: 1px solid rgb(var(--peach-rgb) / 0.3);
  }

  .quiz-art__ring--inner {
    inset: 28%;
    border: 1px solid rgb(var(--peach-rgb) / 0.4);
    background: radial-gradient(circle, rgb(var(--peach-rgb) / 0.18), transparent 70%);
  }

  .quiz-art__bottle {
    position: absolute;
    left: 28%;
    top: 16%;
    width: 44%;
    height: 68%;
    object-fit: contain;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.6));
  }
</style>
