---
/** Durchschnittsnote und eine echte Bewertung (Karte "Reseñas") */
import { starsOf } from '../../../scripts/catalog/reviews.js';
import { formatRating } from '../../../scripts/utils/format.js';

/** @typedef {{ average: number, review?: { text: string, name: string } }} Props */
const { average, review } = Astro.props;
---

<div class="reviews-art">
  <div class="reviews-art__score">
    <span class="reviews-art__number">{formatRating(average)}</span>
    <span class="reviews-art__stars">{starsOf(average)}</span>
  </div>
  {review && (
    <>
      <p class="reviews-art__quote">“{review.text}”</p>
      <span class="reviews-art__name">{review.name} · Compra verificada</span>
    </>
  )}
</div>

<style>
  .reviews-art {
    position: absolute;
    inset: clamp(22px, 2.6vw, 34px) clamp(22px, 2.6vw, 34px) auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .reviews-art__score {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .reviews-art__number {
    font: 500 clamp(64px, 6vw, 92px) / 0.9 var(--font-serif);
    letter-spacing: -0.02em;
    color: var(--sand);
  }

  .reviews-art__stars {
    font-size: 18px;
    letter-spacing: 4px;
    color: var(--gold);
  }

  .reviews-art__quote {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font: italic 400 21px/1.35 var(--font-serif);
    color: rgb(var(--white-rgb) / 0.9);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .reviews-art__name {
    font: 600 12px/1 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.55);
  }
</style>
