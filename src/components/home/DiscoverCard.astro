---
/**
 * Karte im Bereich "Descubre". Das Bild kommt über den Slot "art".
 * @typedef {{ card: { number: string, eyebrow: string, title: string, text: string, cta: string, href: string, action?: string, background: string, layout: { basis: number, height: number, row: number, parallax: number } } }} Props
 */
const { card } = Astro.props;
const { layout } = card;
---

<div class="discover-card" data-discover-card={layout.row} style={`--basis:${layout.basis}px`}>
  <div class="discover-card__tip" data-discover-tip>
    <a
      class="discover-card__body hatch"
      href={card.href}
      data-action={card.action}
      data-cursor="Ver"
      style={`--height:${layout.height}px;--card-bg:${card.background}`}
    >
      <div class="discover-card__art" data-discover-parallax={layout.parallax}>
        <slot name="art" />
      </div>
      <div class="discover-card__text">
        <span class="discover-card__eyebrow">
          <span>{card.number}</span>
          {card.eyebrow}
        </span>
        <h3 class="discover-card__title">{card.title}</h3>
        <p class="discover-card__copy">{card.text}</p>
        <span class="discover-card__cta">
          {card.cta}
          <span>→</span>
        </span>
      </div>
    </a>
  </div>
</div>

<style>
  .discover-card {
    flex: 1 1 var(--basis);
    min-width: 0;
  }

  .discover-card__tip {
    transform-origin: 50% 100%;
  }

  .discover-card__body {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: var(--height);
    padding: clamp(22px, 2.6vw, 34px);
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid rgb(var(--peach-rgb) / 0.18);
    background-color: transparent;
    color: var(--white);
    isolation: isolate;
    transition:
      transform 0.6s var(--ease),
      border-color 0.4s;
  }

  .discover-card__body::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--card-bg);
  }

  .discover-card__body:hover {
    border-color: rgb(var(--peach-rgb) / 0.55);
    color: var(--white);
    transform: translateY(-6px);
  }

  .discover-card__art {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .discover-card__text {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 440px;
  }

  .discover-card__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--peach);
  }

  .discover-card__eyebrow span {
    font: italic 400 20px/1 var(--font-serif);
    letter-spacing: 0;
  }

  .discover-card__title {
    margin: 0;
    font: 500 clamp(30px, 3vw, 46px) / 0.98 var(--font-serif);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .discover-card__copy {
    margin: 0 0 6px;
    font: 400 15px/1.55 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.75);
    text-wrap: pretty;
  }

  .discover-card__cta {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 10px;
    height: 46px;
    padding: 0 8px 0 20px;
    border-radius: var(--radius-pill);
    background: var(--peach);
    color: var(--navy);
    font: 700 13px/1 var(--font-sans);
  }

  .discover-card__cta span {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--peach);
    font-size: 14px;
  }
</style>
