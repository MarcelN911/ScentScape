---
/*
 * Rechte Seite von "Familias olfativas": Flasche und Beschreibung der aktiven Familie,
 * darunter Satz und Link. Welche Familie aktiv ist, setzt scripts/features/home/families.js.
 * Desktop: Flasche und Text nebeneinander. Hochformat: große Flasche, alles darunter zentriert.
 */
import { FAMILIES } from '../../data/families.js';
import { imageUrl } from '../../scripts/utils/image.js';
---

<div class="families__showcase">
  <div class="families__top">
    <div class="families__bottles">
      {FAMILIES.map((family, index) => (
        <img
          class:list={['families__bottle', { 'is-active': index === 0, 'is-after': index > 0 }]}
          src={imageUrl(family.image, 700)}
          alt={family.bottle}
          loading="lazy"
          data-family-bottle
        />
      ))}
    </div>
    <div class="families__descs">
      {FAMILIES.map((family, index) => (
        <div
          class:list={['families__desc', { 'is-active': index === 0, 'is-after': index > 0 }]}
          data-family-desc
        >
          <p class="families__desc-title">
            <span></span>
            {family.id}
          </p>
          <p class="families__desc-text">{family.description}</p>
        </div>
      ))}
    </div>
  </div>
  <div class="families__copy">
    <p class="families__line" data-families-line>
      {FAMILIES[0].line}
    </p>
    <a class="families__link" href="/productos/" data-families-link>
      Explorar&nbsp;<span data-families-title>{FAMILIES[0].id}</span>&nbsp;→
    </a>
  </div>
</div>

<style>
  .families__showcase {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    height: min(62vh, 600px);
  }

  .families__top {
    position: absolute;
    inset: 0 0 120px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(120px, 200px);
    align-items: center;
    gap: clamp(14px, 2.4vw, 32px);
  }

  .families__bottles {
    position: relative;
    height: 100%;
    min-width: 0;
  }

  .families__bottle {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 40px 50px rgb(0 0 0 / 0.5));
    opacity: 0;
    transform: translateY(-60px) rotate(-6deg) scale(0.9);
    transition:
      opacity 0.8s ease,
      transform 1.1s var(--ease-soft);
  }

  .families__bottle.is-after {
    transform: translateY(80px) rotate(6deg) scale(0.9);
  }

  .families__bottle.is-active {
    opacity: 1;
    transform: none;
  }

  .families__descs {
    position: relative;
    min-height: 190px;
  }

  .families__desc {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    opacity: 0;
    transform: translateY(calc(-50% - 24px));
    pointer-events: none;
    transition:
      opacity 0.7s ease,
      transform 0.9s var(--ease-soft);
  }

  .families__desc.is-after {
    transform: translateY(calc(-50% + 24px));
  }

  .families__desc.is-active {
    opacity: 1;
    transform: translateY(-50%);
    pointer-events: auto;
  }

  .families__desc-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    color: var(--peach);
    font: 600 10px/1 var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .families__desc-title span {
    width: 22px;
    height: 1px;
    background: var(--peach);
  }

  .families__desc-text {
    margin: 0;
    color: rgb(var(--cream-rgb) / 0.86);
    font: 400 14px/1.6 var(--font-sans);
    text-wrap: pretty;
  }

  .families__copy {
    position: relative;
    max-width: 380px;
    text-align: center;
  }

  .families__line {
    margin: 0 0 16px;
    color: rgb(var(--cream-rgb) / 0.85);
    font: italic 400 22px/1.4 var(--font-serif);
  }

  .families__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border: 1px solid rgb(var(--peach-rgb) / 0.45);
    border-radius: var(--radius-pill);
    color: var(--sand);
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .families__link:hover {
    background: var(--peach);
    color: var(--navy);
  }

  /*
   * Hochformat (Handy, Tablet hochkant): Flasche groß in der Mitte, darunter Beschreibung,
   * Satz und Link, alles zentriert. Die Beschreibung hat eine feste Höhe für 4 Zeilen,
   * damit beim Wechsel der Familie nichts springt.
   */
  @media (max-width: 1079px) and (orientation: portrait), (max-width: 899px) {
    .families__showcase {
      gap: 2.4svh;
      height: auto;
      min-height: 0;
    }

    .families__top {
      position: relative;
      inset: auto;
      display: flex;
      flex: 1;
      flex-direction: column;
      align-items: center;
      gap: 2svh;
      width: 100%;
      min-height: 0;
    }

    .families__bottles {
      flex: 1;
      width: 100%;
      min-height: 0;
    }

    .families__bottle {
      filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.55));
    }

    .families__descs {
      width: min(100%, 360px);
      height: calc(14px * 1.6 * 4 + 24px);
      min-height: 0;
    }

    .families__desc {
      text-align: center;
    }

    .families__desc-title {
      justify-content: center;
    }

    .families__line {
      margin-bottom: 12px;
      font-size: 18px;
    }
  }

  /* Tablet hochkant: größere Schrift */
  @media (min-width: 600px) and (max-width: 1079px) and (orientation: portrait) {
    .families__descs {
      width: min(100%, 520px);
      height: calc(17px * 1.6 * 4 + 24px);
    }

    .families__desc-text {
      font-size: 17px;
    }

    .families__line {
      font-size: 24px;
    }

    .families__copy {
      max-width: 520px;
    }
  }

  /* Sehr niedrige Handys: der Satz fällt weg, damit Flasche und Text Platz haben */
  @media (max-width: 599px) and (max-height: 680px) {
    .families__line {
      display: none;
    }
  }
</style>
