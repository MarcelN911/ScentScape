---
/*
 * Rückseite der Gift Card auf der Startseite, im Stil der Gift-Card-Seite:
 * Magnetstreifen, Rahmen, Nachricht, Code und Gültigkeit. Farben wie die Vorderseite (--card-bg …).
 */
---

<div class="card-back">
  <span class="card-back__light"></span>
  <span class="card-back__stripe"></span>
  <span class="card-back__frame"></span>
  <div class="card-back__content">
    <p class="card-back__message">“Un detalle para que elijas tu aroma favorito.”</p>
    <div class="card-back__row">
      <span class="card-back__code">
        <small>Código</small>
        <span>SC-GIFT-••••</span>
      </span>
      <span class="card-back__valid">Válida 12 meses</span>
    </div>
  </div>
</div>

<style>
  .card-back {
    position: absolute;
    inset: 0;
  }

  .card-back > span {
    position: absolute;
    pointer-events: none;
  }

  .card-back__light {
    inset: 0;
    background: radial-gradient(110% 80% at 0% 0%, rgb(var(--cream-rgb) / 0.12), transparent 55%);
  }

  .card-back__stripe {
    left: 0;
    right: 0;
    top: 15%;
    height: 16%;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.35));
  }

  .card-back__frame {
    inset: 12px;
    border: 1px solid var(--card-border);
    border-radius: 14px;
    transition: border-color 0.6s;
  }

  .card-back__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    padding: 38% clamp(22px, 6.5%, 38px) clamp(22px, 6.5%, 38px);
  }

  .card-back__message {
    margin: 0;
    font: italic 400 clamp(16px, 1.6vw, 22px) / 1.35 var(--font-serif);
    text-wrap: pretty;
  }

  .card-back__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
  }

  .card-back__code {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .card-back__code small {
    font: 600 8px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .card-back__code span {
    color: var(--card-accent);
    font: 500 13px var(--font-sans);
    letter-spacing: 3px;
  }

  .card-back__valid {
    font: 500 9px var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.7;
  }
</style>
