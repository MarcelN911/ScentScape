---
/** @typedef {{ item: { question: string, answer: string, link?: { label: string, href: string, action?: string } }, open: boolean }} Props */
const { item, open } = Astro.props;
---

<div class:list={['faq-item', { 'is-open': open }]} data-accordion-item>
  <button class="faq-item__head" type="button" data-accordion-toggle aria-expanded={String(open)}>
    <span class="faq-item__question">{item.question}</span>
    <span class="faq-item__icon" aria-hidden="true">
      +
    </span>
  </button>
  <div class="faq-item__body">
    <div class="faq-item__inner">
      <p class="faq-item__answer">{item.answer}</p>
      {item.link && (
        <a class="faq-item__link" href={item.link.href} data-action={item.link.action}>
          {item.link.label} →
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .faq-item {
    border-bottom: 1px solid rgb(var(--peach-rgb) / 0.18);
  }

  .faq-item__head {
    display: flex;
    align-items: center;
    gap: 18px;
    width: 100%;
    padding: 24px 0;
    border: 0;
    background: none;
    text-align: left;
  }

  .faq-item__question {
    flex: 1;
    font: 500 clamp(19px, 1.6vw, 23px) / 1.3 var(--font-serif);
  }

  .faq-item__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgb(var(--peach-rgb) / 0.4);
    color: var(--peach);
    font: 400 20px/1 var(--font-sans);
    transition: all 0.4s var(--ease);
  }

  .faq-item.is-open .faq-item__icon {
    border-color: var(--peach);
    background: var(--peach);
    color: var(--navy);
    transform: rotate(45deg);
  }

  .faq-item__body {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.5s var(--ease),
      opacity 0.4s ease;
  }

  .faq-item.is-open .faq-item__body {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .faq-item__inner {
    overflow: hidden;
  }

  .faq-item__answer {
    margin: 0;
    padding-right: 50px;
    font: 400 16px/1.7 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.78);
    text-wrap: pretty;
  }

  .faq-item__link {
    display: inline-flex;
    margin-top: 16px;
    font: 700 13px/1 var(--font-sans);
    letter-spacing: 0.5px;
  }

  .faq-item__inner > :last-child {
    margin-bottom: 26px;
  }
</style>
