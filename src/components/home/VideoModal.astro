---
import { INSTAGRAM_URL } from '../../scripts/config.js';
import Icon from '../ui/Icon.astro';

const HANDLE = 'Scentscapeparfums_';
---

<div class="video-modal" data-video-modal hidden role="dialog" aria-modal="true" aria-label="Video">
  <button class="video-modal__close" type="button" data-video-close aria-label="Cerrar">
    ×
  </button>
  <button
    class="video-modal__nav video-modal__nav--prev"
    type="button"
    data-video-step="-1"
    aria-label="Anterior"
  >
    ‹
  </button>
  <button
    class="video-modal__nav video-modal__nav--next"
    type="button"
    data-video-step="1"
    aria-label="Siguiente"
  >
    ›
  </button>
  <div class="video-modal__box">
    <div class="video-modal__media">
      <video data-video-player controls loop playsinline></video>
    </div>
    <div class="video-modal__side">
      <div class="video-modal__head">
        <span class="video-modal__avatar">
          <img src="/assets/img/scentscape-logo.png" alt="" />
        </span>
        <span class="video-modal__handle">
          {HANDLE}
          <svg width="13" height="13" viewBox="0 0 40 40" aria-label="Verificado">
            <path
              fill="#0095f6"
              d="M19.998 3.094 14.638 0l-2.972 5.15H5.432v6.354L0 14.64 3.094 20 0 25.359l5.432 3.137v5.905h5.975L14.638 40l5.36-3.094L25.358 40l3.232-5.6h6.162v-6.01L40 25.359 36.905 20 40 14.641l-5.248-3.03v-6.46h-6.419L25.358 0l-5.36 3.094Z"
            ></path>
            <path fill="#FFFCF2" d="m17.2 27.4-6.1-6.1 2.3-2.3 3.8 3.8 9.3-9.3 2.3 2.3z"></path>
          </svg>
        </span>
        <span>·</span>
        <a class="video-modal__follow" href={INSTAGRAM_URL} target="_blank" rel="noopener">
          Seguir
        </a>
        <span class="video-modal__dots">···</span>
      </div>
      <div class="video-modal__body">
        <div class="video-modal__post">
          <span class="video-modal__avatar video-modal__avatar--plain">
            <img src="/assets/img/scentscape-logo.png" alt="" />
          </span>
          <div class="video-modal__caption">
            <span>
              <strong>{HANDLE}</strong> <span data-video-caption></span>{' '}
              <span class="video-modal__tags">#scentscape #perfumeria #colombia</span>
            </span>
            <span class="video-modal__ago" data-video-ago></span>
          </div>
        </div>
        <div class="video-modal__empty">
          <strong>Aún no hay comentarios.</strong>
          <span>Inicia la conversación.</span>
        </div>
      </div>
      <div class="video-modal__actions">
        <div class="video-modal__icons">
          <button
            type="button"
            class="video-modal__like"
            data-video-like
            aria-label="Me gusta"
            aria-pressed="false"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" stroke-width="2">
              <path d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3.3 5 6.8 5c2.1 0 3.5 1.2 4.2 2.4h2C13.7 6.2 15.1 5 17.2 5c3.5 0 5.6 3.6 4.3 6.8C19.5 16.4 12 21 12 21z"></path>
            </svg>
          </button>
          <Icon name="comment" size={24} strokeWidth={2} />
          <Icon name="share" size={24} strokeWidth={2} />
          <Icon name="bookmark" size={24} strokeWidth={2} class="video-modal__save" />
        </div>
        <span class="video-modal__likes">
          <span data-video-likes></span> Me gusta
        </span>
        <span class="video-modal__time" data-video-ago></span>
      </div>
      <div class="video-modal__comment">
        <span>☺</span>
        <span class="video-modal__placeholder">Agrega un comentario…</span>
        <span class="video-modal__publish">Publicar</span>
      </div>
    </div>
  </div>
</div>

<style>
  .video-modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: grid;
    place-items: center;
    padding: clamp(12px, 3vw, 40px);
    background: rgb(0 0 0 / 0.72);
    animation: fade-in 0.3s var(--ease);
    --ig-text: #f5f5f5;
    --ig-muted: #a8a8a8;
    --ig-line: #262626;
    --ig-font: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
  }

  .video-modal__close {
    position: absolute;
    top: 14px;
    right: 18px;
    width: 44px;
    height: 44px;
    border: 0;
    background: none;
    font: 300 34px/1 var(--font-sans);
  }

  .video-modal__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    color: #111;
    font: 700 16px/1 sans-serif;
    transform: translateY(-50%);
  }

  .video-modal__nav--prev {
    left: clamp(6px, 2vw, 28px);
  }

  .video-modal__nav--next {
    right: clamp(6px, 2vw, 28px);
  }

  .video-modal__box {
    display: flex;
    flex-direction: column;
    width: min(440px, 100%);
    max-height: 92vh;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid var(--ig-line);
    background: #000;
    font-family: var(--ig-font);
    color: var(--ig-text);
  }

  .video-modal__media {
    width: 100%;
    max-height: 58vh;
    aspect-ratio: 9 / 16;
    background: #000;
  }

  .video-modal__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-modal__side {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }

  .video-modal__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--ig-line);
    font: 600 14px/1 var(--ig-font);
  }

  .video-modal__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    padding: 2px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 30% 107%,
      #fdf497 0%,
      #fd5949 45%,
      #d6249f 60%,
      #285aeb 90%
    );
  }

  .video-modal__avatar img {
    width: 100%;
    height: 100%;
    padding: 4px;
    border-radius: 50%;
    border: 2px solid #000;
    background: var(--navy);
    object-fit: contain;
  }

  .video-modal__avatar--plain {
    padding: 0;
    background: var(--navy);
  }

  .video-modal__follow {
    margin-left: auto;
    color: #0095f6;
  }

  .video-modal__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 14px;
    min-height: 0;
    overflow: auto;
    padding: 16px;
  }

  .video-modal__caption {
    margin: 0;
    font: 400 14px/1.4 var(--ig-font);
  }

  .video-modal__caption strong {
    font-weight: 600;
  }

  .video-modal__tags {
    color: #e0f1ff;
  }

  .video-modal__handle {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .video-modal__dots {
    margin-left: auto;
    font: 700 18px/1 sans-serif;
    letter-spacing: 1px;
  }

  .video-modal__post {
    display: flex;
    gap: 12px;
  }

  .video-modal__caption {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .video-modal__ago,
  .video-modal__time {
    color: var(--ig-muted);
    font-size: 12px;
  }

  .video-modal__time {
    font-size: 10px;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  .video-modal__empty {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 30px 0;
    text-align: center;
    color: var(--ig-muted);
    font: 400 14px/1.3 var(--ig-font);
  }

  .video-modal__empty strong {
    color: var(--ig-text);
    font: 700 22px/1.2 var(--ig-font);
  }

  .video-modal__actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 6px 16px 12px;
    border-top: 1px solid var(--ig-line);
  }

  .video-modal__icons {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 6px 0;
  }

  :global(.video-modal__save) {
    margin-left: auto;
  }

  .video-modal__like {
    display: grid;
    padding: 0;
    border: 0;
    background: none;
  }

  .video-modal__like svg {
    fill: none;
    stroke: var(--ig-text);
  }

  .video-modal__like[aria-pressed='true'] svg {
    fill: #ff3040;
    stroke: #ff3040;
  }

  .video-modal__likes {
    font: 600 14px/1 var(--ig-font);
  }

  .video-modal__comment {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-top: 1px solid var(--ig-line);
    font: 400 14px/1 var(--ig-font);
  }

  .video-modal__comment > span:first-child {
    font-size: 22px;
  }

  .video-modal__placeholder {
    flex: 1;
    color: var(--ig-muted);
  }

  .video-modal__publish {
    color: #0095f6;
    font-weight: 600;
    opacity: 0.5;
  }

  @media (min-width: 820px) {
    .video-modal__box {
      flex-direction: row;
      width: auto;
      max-width: calc(100vw - 120px);
      height: min(90vh, 860px);
      border-radius: 6px;
    }

    .video-modal__media {
      flex: none;
      width: auto;
      height: 100%;
      max-height: none;
    }

    .video-modal__side {
      flex: none;
      width: clamp(320px, 30vw, 420px);
    }
  }
</style>
