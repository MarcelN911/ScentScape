---
/** @typedef {{ video: { src: string, title: string }, index: number }} Props */
const { video, index } = Astro.props;
---

<button
  class="video-thumb"
  type="button"
  data-video-thumb={index}
  aria-label={video.title}
  title={video.title}
>
  <video src={`${video.src}#t=0.6`} muted playsinline preload="metadata"></video>
</button>

<style>
  .video-thumb {
    flex: none;
    width: 58px;
    height: 58px;
    padding: 3px;
    border-radius: 50%;
    border: 2px solid rgb(var(--peach-rgb) / 0.22);
    background: none;
    opacity: 0.6;
    transition: all 0.4s var(--ease);
  }

  .video-thumb.is-active {
    border-color: var(--peach);
    opacity: 1;
    transform: scale(1.06);
  }

  .video-thumb video {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    pointer-events: none;
    transform: scale(1.12);
  }
</style>
