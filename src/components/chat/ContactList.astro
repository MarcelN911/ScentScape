---
/** WhatsApp, Instagram und Ort untereinander (neben dem Handy). */
import {
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  PHONE_DISPLAY,
  WHATSAPP_NUMBER,
} from '../../scripts/config.js';

/** @typedef {{ size?: 'md' | 'lg', bordered?: boolean }} Props */
const { size = 'md', bordered = true } = Astro.props;
---

<div class:list={['contact-list', `contact-list--${size}`, { 'contact-list--bordered': bordered }]}>
  <div>
    <span>WhatsApp</span>
    <a href={`https://wa.me/${WHATSAPP_NUMBER}`}>{PHONE_DISPLAY}</a>
  </div>
  <div>
    <span>Instagram</span>
    <a href={INSTAGRAM_URL}>{INSTAGRAM_HANDLE}</a>
  </div>
  <div>
    <span>Ubicación</span>
    <strong>Medellín, Colombia</strong>
  </div>
</div>

<style>
  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .contact-list--bordered {
    padding-top: 26px;
    border-top: 1px solid rgb(var(--peach-rgb) / 0.2);
  }

  .contact-list div {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .contact-list span {
    color: var(--peach);
    font: 400 10px var(--font-sans);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .contact-list a,
  .contact-list strong {
    color: var(--cream);
    font: 400 20px/1.3 var(--font-serif);
    word-break: break-word;
  }

  .contact-list--lg a,
  .contact-list--lg strong {
    font-size: 22px;
    line-height: 1.2;
  }

  .contact-list a:hover {
    color: var(--sand);
  }
</style>
