---
/** @typedef {{ bottle: object, image: string }} Props */
const { bottle, image } = Astro.props;
const style = [
  `right:${bottle.right}`,
  `top:${bottle.top}`,
  `width:${bottle.width}`,
  `opacity:${bottle.opacity}`,
  `filter:blur(${bottle.blur}px)`,
  `--depth-x:${bottle.depth[0]}px`,
  `--depth-y:${bottle.depth[1]}px`,
  `--tilt:${bottle.rotate}deg`,
].join(';');
---

<img class="floating-bottle" src={image} alt="" style={style} />

<style>
  .floating-bottle {
    position: absolute;
    max-width: 300px;
    transform: translate(calc(var(--mx, 0) * var(--depth-x)), calc(var(--my, 0) * var(--depth-y)))
      rotate(var(--tilt));
    transition: transform 1.2s var(--ease);
  }
</style>
