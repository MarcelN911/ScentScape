---
/**
 * Hülle um eine Karte/Zeile mit allen Daten, die Filter und Sortierung brauchen.
 * @typedef {{ product: object, index: number }} Props
 */
const { product, index } = Astro.props;
---

<div
  class="shop-item"
  data-shop-item
  data-key={product.slug}
  data-order={index}
  data-family={product.family ?? ''}
  data-gender={product.gender}
  data-price={product.price}
  data-name={product.name}
  data-search={product.searchText}
>
  <slot />
</div>

<style>
  .shop-item {
    min-width: 0;
  }
</style>
