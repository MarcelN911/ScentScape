---
import { capitalize } from '../../scripts/utils/text.js';
import NoteMark from '../ui/NoteMark.astro';

/** @typedef {{ note: string }} Props */
const { note } = Astro.props;
---

<button class="ribbon-note" type="button" data-ribbon-note={note}>
  <NoteMark name={note} size={36} />
  {capitalize(note)}
</button>

<style>
  .ribbon-note {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 18px 0 6px;
    border-radius: var(--radius-pill);
    border: 1px solid rgb(var(--peach-rgb) / 0.2);
    background: rgb(var(--white-rgb) / 0.03);
    color: var(--white);
    font: 600 14px/1 var(--font-sans);
    transition: all 0.3s;
  }

  .ribbon-note.is-active {
    border-color: var(--peach);
    background: var(--peach);
    color: var(--navy);
  }
</style>
