---
/** @typedef {{ label: string, active?: boolean }} Props */
const { label, active = false } = Astro.props;
---

<button
  class:list={['gender-tab', { 'is-active': active }]}
  type="button"
  data-filter-gender={label}
>
  {label}
  <span class="gender-tab__line"></span>
</button>

<style>
  .gender-tab {
    position: relative;
    padding: 12px 0;
    border: 0;
    background: none;
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgb(var(--white-rgb) / 0.5);
    transition: color 0.3s;
  }

  .gender-tab.is-active {
    color: var(--white);
  }

  .gender-tab__line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    height: 2px;
    border-radius: 1px;
    background: var(--peach);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.45s var(--ease);
  }

  .is-active .gender-tab__line {
    transform: scaleX(1);
  }
</style>
