---
/** Zeile in der Indexansicht. Beim Hovern zeigt die Vorschau rechts dieses Produkt. */
import { scentColor } from '../../data/scent.js';
import { formatCOP } from '../../scripts/utils/format.js';

/** @typedef {{ entry: ReturnType<typeof import('../../scripts/catalog/shop-entry.js').shopEntryOf> }} Props */
const { entry } = Astro.props;
const notes =
  (entry.ingredients.length ? entry.ingredients : entry.families).join(' · ') || entry.label;
const accent = scentColor(entry.families[0]);
---

<a class="row" href={entry.href} data-index-row={entry.id} style={`--accent:${accent}`}>
  <span class="row__bar" aria-hidden="true"></span>
  <span class="row__image">
    <img src={entry.image} alt={entry.name} loading="lazy" />
  </span>
  <span class="row__info">
    <span class="row__meta">
      <span class="row__number">
        N° <span data-row-number></span>
      </span>
      <span class="row__dash"></span>
      {entry.label}
      {entry.badge && <span class="row__badge">{entry.badge}</span>}
    </span>
    <span class="row__name">{entry.name}</span>
    <span class="row__notes">{notes}</span>
  </span>
  <span class="row__price">
    {entry.sizes.length > 1 && <span class="row__sizes">Desde · {entry.sizes.length} tamaños</span>}
    <span class="row__amount">{formatCOP(entry.price)}</span>
  </span>
  <span class="row__arrow">→</span>
</a>

<style>
  .row {
    --delay: 0ms;
    position: relative;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto 28px;
    align-items: center;
    gap: 20px;
    padding: 10px 18px 10px 10px;
    overflow: hidden;
    border: 1px solid rgb(var(--peach-rgb) / 0.1);
    border-radius: 22px;
    background: rgb(var(--navy-deep-rgb) / 0.45);
    color: var(--cream);
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.8s var(--delay),
      transform 0.8s var(--ease) var(--delay),
      background 0.5s,
      border-color 0.5s;
  }

  .row.is-visible {
    opacity: 1;
    transform: none;
  }

  .row:hover {
    color: var(--cream);
  }

  .row.is-active {
    border-color: rgb(var(--peach-rgb) / 0.5);
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--accent) 14%, transparent),
      rgb(var(--navy-card-rgb) / 0.75)
    );
  }

  .row__bar {
    position: absolute;
    left: 0;
    top: 18%;
    bottom: 18%;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--peach);
    transform: scaleY(0);
    transition: transform 0.5s var(--ease);
  }

  .row.is-active .row__bar {
    transform: scaleY(1);
  }

  .row__image {
    position: relative;
    width: 72px;
    height: 88px;
    overflow: hidden;
    border-radius: 14px;
    background: var(--navy-deep);
  }

  .row__image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .row:hover .row__image img {
    transform: scale(1.12);
  }

  .row__info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .row__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgb(var(--cream-rgb) / 0.6);
    font: 500 9px var(--font-sans);
    letter-spacing: 2.5px;
    text-transform: uppercase;
  }

  .row__number {
    color: var(--peach);
    font: italic 400 12px var(--font-serif);
    letter-spacing: 0;
  }

  .row__dash {
    width: 14px;
    height: 1px;
    background: rgb(var(--peach-rgb) / 0.5);
  }

  .row__badge {
    padding: 3px 7px;
    border-radius: 8px;
    background: var(--peach);
    color: var(--navy);
    font: 600 7px var(--font-sans);
    letter-spacing: 1.5px;
  }

  .row__name {
    overflow: hidden;
    font: 400 clamp(20px, 1.7vw, 26px) / 1.05 var(--font-serif);
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.4s;
  }

  .row.is-active .row__name {
    color: var(--sand);
    font-style: italic;
  }

  .row__notes {
    overflow: hidden;
    color: rgb(var(--cream-rgb) / 0.6);
    font: 300 12px var(--font-sans);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .row__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .row__sizes {
    color: rgb(var(--cream-rgb) / 0.55);
    font: 500 8px var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .row__amount {
    color: var(--sand);
    font: italic 400 18px var(--font-serif);
    font-variant-numeric: lining-nums;
    white-space: nowrap;
  }

  .row__arrow {
    color: var(--peach);
    font: 400 16px var(--font-sans);
    opacity: 0.25;
    transform: translateX(-8px);
    transition:
      transform 0.5s var(--ease),
      opacity 0.4s;
  }

  .row.is-active .row__arrow {
    opacity: 1;
    transform: none;
  }
</style>
