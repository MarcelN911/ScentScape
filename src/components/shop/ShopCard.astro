---
/** Produktkarte im Raster. Reihenfolge, Nummer und Einblenden steuert scripts/features/shop. */
import { scentColor } from '../../data/scent.js';
import FamilyChips from '../ui/FamilyChips.astro';
import Icon from '../ui/Icon.astro';
import ShopCardInfo from './ShopCardInfo.astro';

/** @typedef {{ entry: ReturnType<typeof import('../../scripts/catalog/shop-entry.js').shopEntryOf> }} Props */
const { entry } = Astro.props;
const family = entry.families[0];
---

<a class="shop-card" href={entry.href} data-shop-card={entry.id} data-fly-source>
  <div class="shop-card__frame">
    <div class="shop-card__clip">
      <img src={entry.image} alt={entry.name} loading="lazy" draggable="false" />
      <span class="shop-card__shade"></span>
      {family && (
        <span class="shop-card__tag" style={`--dot:${scentColor(family)}`}>
          {family}
        </span>
      )}
    </div>
    <span class="shop-card__line" aria-hidden="true"></span>
    <span class="shop-card__number" data-card-number></span>
    <div class="shop-card__top">
      <FamilyChips families={entry.families} class="shop-card__chips" />
      <button
        class="shop-card__heart"
        type="button"
        aria-label="Favorito"
        data-action="toggle-wish"
        data-wish-id={entry.id}
      >
        <Icon name="heart" size={13} strokeWidth={1.6} />
      </button>
    </div>
    <ShopCardInfo entry={entry} />
  </div>
</a>

<style>
  .shop-card {
    --delay: 0ms;
    display: block;
    color: var(--cream);
    perspective: 1100px;
    opacity: 0;
    transform: translateY(60px);
    transition:
      opacity 0.9s var(--delay),
      transform 1.1s var(--ease) var(--delay);
  }

  .shop-card.is-visible {
    opacity: 1;
    transform: none;
  }

  .shop-card:hover {
    color: var(--cream);
  }

  .shop-card__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 24px;
    background: var(--navy-raised);
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.35);
    transition:
      transform 0.6s var(--ease-soft),
      box-shadow 0.6s;
  }

  .shop-card:hover .shop-card__frame {
    box-shadow:
      0 46px 80px rgb(0 0 0 / 0.55),
      0 0 0 1px rgb(var(--peach-rgb) / 0.55);
    transform: translateY(-8px);
  }

  .shop-card__clip {
    position: absolute;
    inset: 0;
    clip-path: inset(100% 0% 0% 0% round 22px);
    transition: clip-path 1.3s var(--ease-curtain) var(--delay);
  }

  .shop-card.is-visible .shop-card__clip {
    clip-path: inset(0% 0% 0% 0% round 22px);
  }

  .shop-card__clip img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    transform: scale(1.25);
    transition: transform 1.3s var(--ease);
  }

  .shop-card.is-visible .shop-card__clip img {
    transform: scale(1.02);
  }

  .shop-card.is-visible:hover .shop-card__clip img {
    transform: scale(1.1);
  }

  .shop-card__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(var(--navy-deep-rgb) / 0.28) 0%,
      rgb(var(--navy-deep-rgb) / 0) 26%,
      rgb(var(--navy-deep-rgb) / 0) 52%,
      rgb(var(--navy-deep-rgb) / 0.82) 100%
    );
    pointer-events: none;
  }

  .shop-card__line {
    position: absolute;
    inset: 10px;
    border: 1px solid rgb(var(--sand-rgb) / 0.28);
    border-radius: 16px;
    pointer-events: none;
  }

  .shop-card__number {
    position: absolute;
    top: 24px;
    left: 24px;
    color: var(--sand);
    font: italic 400 22px/1 var(--font-serif);
  }

  .shop-card__top {
    position: absolute;
    top: 22px;
    right: 22px;
    left: 70px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 6px;
  }

  .shop-card__heart {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid rgb(var(--peach-rgb) / 0.4);
    border-radius: 15px;
    background: rgb(var(--navy-rgb) / 0.55);
    backdrop-filter: blur(10px);
    color: var(--sand);
    transition: transform 0.45s cubic-bezier(0.3, 1.8, 0.5, 1);
  }

  .shop-card__heart:hover {
    transform: scale(1.15);
  }

  .shop-card__heart[aria-pressed='true'] :global(svg) {
    fill: var(--peach);
  }

  /* Handy und Tablet hochkant: Text unter das Bild (ShopCardInfo), auf dem Bild nur Nummer und Herz. */
  .shop-card__tag {
    display: none;
  }

  @media (max-width: 899px) {
    /* Karte füllt die ganze Höhe ihrer Rasterzeile: so sind Karten nebeneinander gleich hoch. */
    .shop-card {
      height: 100%;
    }

    /* Die ganze Karte (Bild + Text) hat einen Hintergrund und einen feinen Rahmen. */
    .shop-card__frame {
      display: flex;
      flex-direction: column;
      height: 100%;
      aspect-ratio: auto;
      border: 1px solid rgb(var(--sand-rgb) / 0.16);
      border-radius: 18px;
      background: var(--navy-raised);
      box-shadow: 0 18px 36px rgb(0 0 0 / 0.3);
    }

    /* Bild oben ohne eigene Rundung: die Ecken schneidet der Rahmen ab (overflow: hidden). */
    .shop-card__clip {
      position: relative;
      flex: none;
      aspect-ratio: 4 / 5;
      clip-path: inset(100% 0% 0% 0%);
    }

    .shop-card.is-visible .shop-card__clip {
      clip-path: inset(0);
    }

    .shop-card__line,
    .shop-card__top :global(.shop-card__chips) {
      display: none;
    }

    /* Duftfamilie als kleines Glas-Etikett unten links auf dem Foto */
    .shop-card__tag {
      position: absolute;
      left: 10px;
      bottom: 10px;
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 5px 9px;
      border-radius: 10px;
      background: rgb(var(--navy-rgb) / 0.6);
      backdrop-filter: blur(8px);
      color: var(--cream);
      font: 500 8px/1 var(--font-sans);
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .shop-card__tag::before {
      content: '';
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--dot);
      box-shadow: 0 0 6px var(--dot);
    }

    .shop-card__number {
      top: 12px;
      left: 14px;
      font-size: 18px;
    }

    .shop-card__top {
      top: 10px;
      right: 10px;
      left: auto;
    }
  }
</style>
