---
/** Produktkarte im Raster. Reihenfolge, Nummer und Einblenden steuert scripts/features/shop. */
import { formatCOP } from '../../scripts/utils/format.js';
import FamilyChips from '../ui/FamilyChips.astro';
import Icon from '../ui/Icon.astro';

/** @typedef {{ entry: ReturnType<typeof import('../../scripts/catalog/shop-entry.js').shopEntryOf> }} Props */
const { entry } = Astro.props;
const cheapest =
  entry.sizes.find((size) => (size.sale ?? size.price) === entry.price) ?? entry.sizes[0];
const notes =
  (entry.ingredients.length ? entry.ingredients : entry.families).join(' · ') || entry.label;
---

<a class="shop-card" href={entry.href} data-shop-card={entry.id} data-fly-source>
  <div class="shop-card__frame">
    <div class="shop-card__clip">
      <img src={entry.image} alt={entry.name} loading="lazy" draggable="false" />
      <span class="shop-card__shade"></span>
    </div>
    <span class="shop-card__line" aria-hidden="true"></span>
    <span class="shop-card__number" data-card-number></span>
    <div class="shop-card__top">
      <FamilyChips families={entry.families} class="shop-card__chips" />
      <button
        class="shop-card__heart"
        type="button"
        aria-label="Favorito"
        data-action="toggle-wish"
        data-wish-id={entry.id}
      >
        <Icon name="heart" size={13} strokeWidth={1.6} />
      </button>
    </div>
    <div class="shop-card__bottom">
      <div class="shop-card__text">
        <div class="shop-card__reveal">
          <div>
            <p class="shop-card__notes-label">Notas</p>
            <p class="shop-card__notes">{notes}</p>
          </div>
        </div>
        {entry.brand && <p class="shop-card__brand">{entry.brand}</p>}
        <h3 class="shop-card__name">{entry.name}</h3>
        <p class="shop-card__price">
          {entry.sizes.length > 1 ? 'Desde ' : ''}
          {formatCOP(entry.price)}
          {cheapest.sale && <span>{formatCOP(cheapest.price)}</span>}
        </p>
      </div>
      <span class="shop-card__arrow" aria-hidden="true">
        →
      </span>
    </div>
  </div>
</a>

<style>
  .shop-card {
    --delay: 0ms;
    display: block;
    color: var(--cream);
    perspective: 1100px;
    opacity: 0;
    transform: translateY(60px);
    transition:
      opacity 0.9s var(--delay),
      transform 1.1s var(--ease) var(--delay);
  }

  .shop-card.is-visible {
    opacity: 1;
    transform: none;
  }

  .shop-card:hover {
    color: var(--cream);
  }

  .shop-card__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 24px;
    background: var(--navy-raised);
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.35);
    transition:
      transform 0.6s var(--ease-soft),
      box-shadow 0.6s;
  }

  .shop-card:hover .shop-card__frame {
    box-shadow:
      0 46px 80px rgb(0 0 0 / 0.55),
      0 0 0 1px rgb(var(--peach-rgb) / 0.55);
    transform: translateY(-8px);
  }

  .shop-card__clip {
    position: absolute;
    inset: 0;
    clip-path: inset(100% 0% 0% 0% round 22px);
    transition: clip-path 1.3s var(--ease-curtain) var(--delay);
  }

  .shop-card.is-visible .shop-card__clip {
    clip-path: inset(0% 0% 0% 0% round 22px);
  }

  .shop-card__clip img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    transform: scale(1.25);
    transition: transform 1.3s var(--ease);
  }

  .shop-card.is-visible .shop-card__clip img {
    transform: scale(1.02);
  }

  .shop-card.is-visible:hover .shop-card__clip img {
    transform: scale(1.1);
  }

  .shop-card__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(var(--navy-deep-rgb) / 0.28) 0%,
      rgb(var(--navy-deep-rgb) / 0) 26%,
      rgb(var(--navy-deep-rgb) / 0) 52%,
      rgb(var(--navy-deep-rgb) / 0.82) 100%
    );
    pointer-events: none;
  }

  .shop-card__line {
    position: absolute;
    inset: 10px;
    border: 1px solid rgb(var(--sand-rgb) / 0.28);
    border-radius: 16px;
    pointer-events: none;
  }

  .shop-card__number {
    position: absolute;
    top: 24px;
    left: 24px;
    color: var(--sand);
    font: italic 400 22px/1 var(--font-serif);
  }

  .shop-card__top {
    position: absolute;
    top: 22px;
    right: 22px;
    left: 70px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 6px;
  }

  .shop-card__heart {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid rgb(var(--peach-rgb) / 0.4);
    border-radius: 15px;
    background: rgb(var(--navy-rgb) / 0.55);
    backdrop-filter: blur(10px);
    color: var(--sand);
    transition: transform 0.45s cubic-bezier(0.3, 1.8, 0.5, 1);
  }

  .shop-card__heart:hover {
    transform: scale(1.15);
  }

  .shop-card__heart[aria-pressed='true'] :global(svg) {
    fill: var(--peach);
  }

  .shop-card__bottom {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 22px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
  }

  .shop-card__text {
    min-width: 0;
  }

  .shop-card__reveal {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.6s var(--ease);
  }

  .shop-card__reveal > div {
    min-height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.45s 0.12s,
      transform 0.6s var(--ease) 0.08s;
  }

  .shop-card:hover .shop-card__reveal {
    grid-template-rows: 1fr;
  }

  .shop-card:hover .shop-card__reveal > div {
    opacity: 1;
    transform: none;
  }

  .shop-card__notes-label {
    margin: 0 0 6px;
    color: var(--peach);
    font: 600 9px/1 var(--font-sans);
    letter-spacing: 2.5px;
    text-transform: uppercase;
  }

  .shop-card__notes {
    margin: 0 0 14px;
    font: italic 400 16px/1.3 var(--font-serif);
  }

  .shop-card__brand {
    margin: 0 0 6px;
    color: var(--peach);
    font: 600 10px/1.2 var(--font-sans);
    letter-spacing: 2.5px;
    text-transform: uppercase;
  }

  .shop-card__name {
    display: -webkit-box;
    margin: 0 0 10px;
    overflow: hidden;
    font: 500 clamp(22px, 1.8vw, 28px) / 1.08 var(--font-serif);
    letter-spacing: -0.01em;
    text-transform: capitalize;
    text-wrap: balance;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .shop-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin: 0;
    color: var(--sand);
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 1.5px;
  }

  .shop-card__price span {
    color: rgb(var(--cream-rgb) / 0.5);
    font: 300 10px var(--font-sans);
    letter-spacing: 0;
    text-decoration: line-through;
  }

  .shop-card__arrow {
    display: grid;
    flex: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--peach);
    color: var(--navy);
    font: 500 20px/1 var(--font-sans);
    transition: transform 0.4s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  .shop-card:hover .shop-card__arrow {
    transform: translateX(4px);
  }
</style>
