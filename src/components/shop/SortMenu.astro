---
/*
 * Knopf "Orden" mit aufklappbarer Liste der Sortierungen.
 * Eigenes Dropdown statt <select>: die Liste eines <select> zeichnet der Browser selbst,
 * sie lässt sich kaum gestalten. "popover" legt die Liste über alles (auch über overflow: hidden)
 * und schließt sie bei Klick daneben oder Escape. Bedienung: scripts/features/shop/sort.js
 */
import { SORT_OPTIONS } from '../../data/shop.js';
import MenuOption from '../ui/MenuOption.astro';
---

<button
  class="sort"
  type="button"
  popovertarget="shop-sort-menu"
  aria-haspopup="listbox"
  data-sort-toggle
>
  Orden
  <span class="sort__value" data-sort-value>
    {SORT_OPTIONS[0].label}
  </span>
  <svg
    width="10"
    height="10"
    viewBox="0 0 10 10"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    aria-hidden="true"
  >
    <path d="M2 3.5l3 3 3-3"></path>
  </svg>
</button>
<div class="sort__panel" id="shop-sort-menu" popover role="listbox" aria-label="Ordenar">
  {SORT_OPTIONS.map((option, index) => (
    <MenuOption selected={index === 0} data-sort-option={option.value}>
      {option.label}
    </MenuOption>
  ))}
</div>

<style>
  /* Knopf "Orden": sieht aus wie die Such-Pille daneben */
  .sort {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 18px;
    border: 1px solid rgb(var(--peach-rgb) / 0.3);
    border-radius: 24px;
    background: var(--navy-deep);
    color: var(--peach);
    font: 400 10px var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.3s;
  }

  .sort:hover,
  .sort.is-open {
    border-color: rgb(var(--peach-rgb) / 0.6);
  }

  .sort__value {
    margin-left: 8px;
    color: var(--cream);
    font: 400 13px var(--font-sans);
    letter-spacing: 0;
    text-transform: none;
  }

  .sort svg {
    transition: transform 0.4s;
  }

  .sort.is-open svg {
    transform: rotate(180deg);
  }

  /* Aufgeklappte Liste, gleicher Look wie das Servicios-Menü im Header. Lage setzt sort.js */
  .sort__panel {
    position: fixed;
    inset: auto;
    width: 220px;
    margin: 0;
    padding: 6px;
    border: 1px solid rgb(var(--peach-rgb) / 0.25);
    border-radius: 20px;
    background: rgb(var(--navy-deep-rgb) / 0.96);
    backdrop-filter: blur(16px);
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.5);
    color: var(--cream);
    opacity: 1;
    transform: none;
    transition:
      opacity 0.25s,
      transform 0.35s var(--ease);
  }

  /* Startzustand beim Öffnen: leicht versetzt und durchsichtig, dann gleitet die Liste herein */
  @starting-style {
    .sort__panel:popover-open {
      opacity: 0;
      transform: translateY(8px);
    }
  }
</style>
