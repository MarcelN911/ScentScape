---
import { metaLineOf, sizesTextOf, themeOf } from '../../scripts/catalog/theme.js';
import { formatCOP, padNumber } from '../../scripts/utils/format.js';
import { imageUrl } from '../../scripts/utils/image.js';
import AddSizeButton from './AddSizeButton.astro';
import CardNotes from './CardNotes.astro';
import ProductStage from './ProductStage.astro';
import WishButton from './WishButton.astro';

/** @typedef {{ product: object, index: number }} Props */
const { product, index } = Astro.props;
const image = imageUrl(product.images[0], 600);
const price = `${product.sizes.length > 1 ? 'desde ' : ''}${formatCOP(product.price)}`;
---

<article
  class:list={['card', 'stage-host', { 'card--photo': product.hasCoverPhoto }]}
  data-cursor="Ver"
>
  {product.hasCoverPhoto ? (
    <img class="card__photo" src={image} alt={product.name} loading="lazy" draggable="false" />
  ) : (
    <ProductStage image={image} alt={product.name} theme={themeOf(product)} />
  )}
  <a class="card__link" href={`/producto/${product.slug}/`} aria-label={product.name}></a>
  <div class="card__top">
    <span class="card__num" data-item-number>
      {padNumber(index + 1)}
    </span>
    <div class="card__top-end">
      {product.badge && <span class="tag tag--accent">{product.badge}</span>}
      <WishButton productId={product.id} />
    </div>
  </div>
  <CardNotes product={product} />
  <div class="card__bottom">
    <p class="meta card__meta">{metaLineOf(product)}</p>
    <h3 class="card__name">{product.name}</h3>
    <div class="card__swap">
      <div class="card__price">
        <span class="card__amount">{price}</span>
        <span class="card__sizes-text">{sizesTextOf(product)}</span>
      </div>
      <div class="card__sizes">
        {product.sizes.map((size) => (
          <AddSizeButton product={product} size={size} />
        ))}
      </div>
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    height: 450px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid rgb(var(--peach-rgb) / 0.12);
    background: var(--navy-raised);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.2);
    transition:
      transform 0.6s var(--ease),
      box-shadow 0.6s,
      border-color 0.6s;
  }

  .card:hover {
    transform: translateY(-10px);
    border-color: var(--peach);
    box-shadow: 0 40px 70px rgb(0 0 0 / 0.45);
  }

  .card--photo {
    height: auto;
    aspect-ratio: 4 / 5;
  }

  .card__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 1.1s var(--ease),
      filter 0.8s;
  }

  .card:hover .card__photo {
    transform: scale(1.08);
    filter: saturate(1.08);
  }

  .card__link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .card__top {
    position: absolute;
    top: 18px;
    left: 18px;
    right: 18px;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .card__num {
    padding: 7px 10px;
    border-radius: var(--radius-pill);
    background: var(--glass-light);
    backdrop-filter: blur(10px);
    font: 700 11px/1 var(--font-sans);
    letter-spacing: 1px;
  }

  .card__top-end {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .card__bottom {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    z-index: 3;
    pointer-events: none;
  }

  .card__meta {
    margin-bottom: 6px;
    color: rgb(var(--white-rgb) / 0.7);
  }

  .card__name {
    margin: 0 0 12px;
    font: 500 22px/1.05 var(--font-serif);
    letter-spacing: -0.02em;
  }

  .card__swap {
    position: relative;
    height: 36px;
    overflow: hidden;
  }

  .card__price,
  .card__sizes {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.45s var(--ease);
  }

  .card__price {
    justify-content: space-between;
  }

  .card__amount {
    font: 700 16px/1 var(--font-sans);
  }

  .card__sizes-text {
    font: 500 12px/1 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.55);
  }

  .card__sizes {
    gap: 6px;
    opacity: 0;
    transform: translateY(110%);
    pointer-events: auto;
  }

  .card:hover .card__price {
    opacity: 0;
    transform: translateY(-110%);
  }

  .card:hover .card__sizes {
    opacity: 1;
    transform: none;
  }

  @media (hover: none) {
    .card__price {
      opacity: 0;
    }

    .card__sizes {
      opacity: 1;
      transform: none;
    }
  }
</style>
