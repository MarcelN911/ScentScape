---
import { ORBIT_POSITIONS } from '../../data/product.js';
import { capitalize } from '../../scripts/utils/text.js';
import NoteMark from '../ui/NoteMark.astro';

/** @typedef {{ notes: string[], color: string }} Props */
const { notes, color } = Astro.props;
const placed = notes.slice(0, ORBIT_POSITIONS.length).map((note, index) => ({
  note,
  style: `left:${ORBIT_POSITIONS[index][0]}%;top:${ORBIT_POSITIONS[index][1]}%;--orbit-delay:${200 + index * 90}ms`,
}));
---

{placed.map(({ note, style }) => (
  <div class="orbit-note" style={style}>
    <span class="orbit-note__mark">
      <NoteMark name={note} color={color} size={96} />
    </span>
    <span class="orbit-note__label">{capitalize(note)}</span>
  </div>
))}

<style>
  .orbit-note {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.6);
    transition:
      opacity 0.7s ease,
      transform 0.9s var(--ease);
  }

  :global(.is-active) > .orbit-note,
  :global(.is-active) .orbit-note {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    transition-delay: var(--orbit-delay);
  }

  .orbit-note__mark {
    width: clamp(62px, 7vw, 96px);
    height: clamp(62px, 7vw, 96px);
    border-radius: 50%;
    border: 3px solid rgb(var(--sand-rgb) / 0.55);
    box-shadow: 0 16px 30px rgb(0 0 0 / 0.4);
  }

  .orbit-note__mark :global(.note-mark) {
    width: 100%;
    height: 100%;
  }

  .orbit-note__label {
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: rgb(var(--navy-deep-rgb) / 0.6);
    backdrop-filter: blur(8px);
    font: italic 400 17px/1 var(--font-serif);
    white-space: nowrap;
  }
</style>
