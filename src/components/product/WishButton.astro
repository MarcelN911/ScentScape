---
import Icon from '../ui/Icon.astro';

/** @typedef {{ productId: string, class?: string }} Props */
const { productId, class: className } = Astro.props;
---

<button
  class:list={['wish', className]}
  type="button"
  data-action="toggle-wish"
  data-wish-id={productId}
  aria-label="Guardar"
  aria-pressed="false"
>
  <Icon name="heart" size={15} />
</button>

<style>
  .wish {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: var(--glass-light);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--peach);
  }

  .wish[aria-pressed='true'] :global(svg) {
    fill: currentColor;
  }
</style>
