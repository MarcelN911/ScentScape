---
import { TRUST_ITEMS } from '../../data/product.js';
---

<a class="trust marquee" href="/original/" aria-label="Original garantizado">
  <span class="marquee__track trust__track">
    {[0, 1].map((copy) => (
      <span class="marquee__group trust__group" aria-hidden={copy === 1 ? 'true' : undefined}>
        {TRUST_ITEMS.map((item) => (
          <>
            <span>{item}</span>
            <span class="trust__star">✦</span>
          </>
        ))}
      </span>
    ))}
  </span>
</a>

<style>
  .trust {
    --marquee-gap: 22px;
    --marquee-duration: 26s;
    position: relative;
    display: block;
    margin: 4px 0 28px;
    padding: 13px 0;
    border-block: 1px solid rgb(var(--peach-rgb) / 0.22);
    color: var(--sand);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .trust:hover {
    color: var(--white);
  }

  .trust__group {
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .trust__star {
    color: rgb(var(--peach-rgb) / 0.45);
  }
</style>
