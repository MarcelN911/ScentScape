---
import { capitalize } from '../../scripts/utils/text.js';
import NoteMark from '../ui/NoteMark.astro';

/**
 * @typedef {object} Props
 * @property {{ label: string, time: string }} tier
 * @property {string[]} notes
 * @property {number} index
 * @property {string} color
 */
const { tier, notes, index, color } = Astro.props;
---

<div data-reveal="up" style={`--reveal-delay:${index * 120}ms`}>
  <button
    class:list={['tier', { 'is-active': index === 0 }]}
    type="button"
    data-pyramid-tier
    aria-pressed={String(index === 0)}
  >
    <span class="tier__head">
      <span class="tier__label">{tier.label}</span>
      <span class="tier__time">{tier.time}</span>
    </span>
    <span class="tier__notes">
      {notes.map((note, position) => (
        <span class="tier__note" style={`--note-delay:${position * 50}ms`}>
          <NoteMark name={note} color={color} size={64} class="tier__mark" />
          {capitalize(note)}
        </span>
      ))}
    </span>
  </button>
</div>

<style>
  .tier {
    display: block;
    width: 100%;
    height: 100%;
    padding: 26px;
    border-radius: 28px;
    border: 1px solid rgb(var(--white-rgb) / 0.08);
    background: rgb(var(--navy-deep-rgb) / 0.32);
    color: var(--white);
    text-align: left;
    opacity: 0.6;
    transition: all 0.6s var(--ease);
  }

  .tier.is-active {
    border-color: color-mix(in oklch, var(--accent) 60%, #fff);
    background: color-mix(in oklch, var(--accent) 38%, var(--navy));
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.3);
    opacity: 1;
    transform: translateY(-8px);
  }

  .tier__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 22px;
  }

  .tier__label {
    font: 500 24px/1 var(--font-serif);
    letter-spacing: -0.02em;
  }

  .tier__time {
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--peach);
  }

  .tier__notes {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 14px;
  }

  .tier__note {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 76px;
    font: 600 12px/1.25 var(--font-sans);
    text-align: center;
    color: rgb(var(--white-rgb) / 0.85);
  }

  .tier__note :global(.tier__mark) {
    border: 2px solid rgb(var(--sand-rgb) / 0.2);
    transform: scale(0.88);
    transition:
      transform 0.6s var(--ease) var(--note-delay),
      border-color 0.4s;
  }

  .tier.is-active :global(.tier__mark) {
    border-color: var(--sand);
    transform: scale(1);
  }
</style>
