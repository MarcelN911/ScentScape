---
import { accentOf, topNotesOf } from '../../scripts/catalog/theme.js';
import { capitalize } from '../../scripts/utils/text.js';
import NoteMark from '../ui/NoteMark.astro';

/** @typedef {{ product: object }} Props */
const { product } = Astro.props;
const notes = topNotesOf(product);
const color = accentOf(product) === '#61031b' ? '#f0be91' : accentOf(product);
---

<div class="card-notes" aria-hidden="true">
  {notes.map((note, index) => (
    <span
      class="card-notes__item"
      title={capitalize(note)}
      style={`--note-delay:${150 + index * 80}ms`}
    >
      <NoteMark name={note} color={color} size={40} />
    </span>
  ))}
</div>

<style>
  .card-notes {
    position: absolute;
    top: 66px;
    right: 18px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card-notes__item {
    border-radius: 50%;
    border: 2px solid rgb(var(--sand-rgb) / 0.7);
    box-shadow: 0 8px 16px rgb(0 0 0 / 0.35);
    opacity: 0;
    transform: translateX(18px) scale(0.6);
    transition: all 0.55s var(--ease) 0ms;
  }

  :global(.card:hover) .card-notes__item {
    opacity: 1;
    transform: none;
    transition-delay: var(--note-delay);
  }
</style>
