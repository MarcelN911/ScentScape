---
/** Karte in "También te puede gustar". Hover zeigt Noten und "Descubrir →". */
import { priceFromText } from '../../scripts/catalog/sizes.js';
import { cartItemJson } from '../../scripts/cart/cart-item.js';
import { padNumber } from '../../scripts/utils/format.js';
import { imageUrl } from '../../scripts/utils/image.js';
import FamilyChips from '../ui/FamilyChips.astro';

/** @typedef {{ product: object, index: number }} Props */
const { product, index } = Astro.props;
const price = priceFromText(product).replace('desde', 'Desde');
---

<a
  class="rel-card"
  href={`/producto/${product.slug}/`}
  data-fly-source
  data-rel-card
  style={`--d:${index * 90}ms`}
>
  <img src={imageUrl(product.images[0], 700)} alt={product.name} loading="lazy" />
  <span class="rel-card__shade" aria-hidden="true"></span>
  <span class="rel-card__line" aria-hidden="true"></span>
  <span class="rel-card__num">{padNumber(index + 1)}</span>
  <FamilyChips families={product.scentFamilies} class="rel-card__chips" />
  <div class="rel-card__bottom">
    <div class="rel-card__text">
      <div class="rel-card__reveal">
        <div>
          <p class="rel-card__label">Notas</p>
          <p class="rel-card__notes">{product.ingredients.slice(0, 3).join(' · ')}</p>
        </div>
      </div>
      <h3 class="rel-card__name">{product.name}</h3>
      <p class="rel-card__price">
        <span>{price} COP</span>
        <span class="rel-card__cta">Descubrir →</span>
      </p>
    </div>
    <button
      class="rel-card__add"
      type="button"
      aria-label="Añadir al carrito"
      data-action="add-to-cart"
      data-cart-item={cartItemJson(product)}
    >
      +
    </button>
  </div>
</a>

<style>
  .rel-card {
    position: relative;
    flex: none;
    width: clamp(260px, 24vw, 340px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid rgb(var(--peach-rgb) / 0.35);
    border-radius: 24px;
    background: #1d2244;
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.4);
    color: var(--cream);
    scroll-snap-align: start;
    opacity: 0;
    transform: translateY(90px);
    transition:
      opacity 0.9s var(--d),
      transform 1s var(--ease) var(--d),
      box-shadow 0.6s;
  }

  :global(.is-shown) .rel-card {
    opacity: 1;
    transform: none;
  }

  :global(.is-shown) .rel-card:hover {
    box-shadow: 0 50px 90px rgb(0 0 0 / 0.6);
    transform: translateY(-10px);
    transition-delay: 0s;
  }

  .rel-card:hover {
    color: var(--cream);
  }

  .rel-card > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    transform: scale(1.02);
    transition: transform 1.4s var(--ease);
  }

  .rel-card:hover > img {
    transform: scale(1.08);
  }

  .rel-card__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(var(--navy-deep-rgb) / 0.28) 0%,
      rgb(var(--navy-deep-rgb) / 0) 26%,
      rgb(var(--navy-deep-rgb) / 0) 52%,
      rgb(var(--navy-deep-rgb) / 0.82) 100%
    );
    pointer-events: none;
  }

  .rel-card__line {
    position: absolute;
    inset: 10px;
    border: 1px solid rgb(var(--sand-rgb) / 0.28);
    border-radius: 16px;
    pointer-events: none;
  }

  .rel-card__num {
    position: absolute;
    top: 24px;
    left: 24px;
    color: var(--sand);
    font: italic 400 22px/1 var(--font-serif);
  }

  :global(.rel-card__chips) {
    position: absolute;
    top: 22px;
    right: 22px;
    left: 70px;
  }

  .rel-card__bottom {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 22px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
  }

  .rel-card__text {
    min-width: 0;
  }

  .rel-card__reveal {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.6s var(--ease);
  }

  .rel-card__reveal > div {
    min-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.4s 0.1s;
  }

  .rel-card:hover .rel-card__reveal {
    grid-template-rows: 1fr;
  }

  .rel-card:hover .rel-card__reveal > div {
    opacity: 1;
  }

  .rel-card__label {
    margin: 0 0 6px;
    color: var(--peach);
    font: 600 9px/1 var(--font-sans);
    letter-spacing: 2.5px;
    text-transform: uppercase;
  }

  .rel-card__notes {
    margin: 0 0 14px;
    font: italic 400 16px/1.3 var(--font-serif);
  }

  .rel-card__name {
    margin: 0 0 8px;
    font: 500 clamp(22px, 1.8vw, 28px) / 1 var(--font-serif);
    letter-spacing: -0.01em;
    text-transform: capitalize;
  }

  .rel-card__price {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--sand);
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 1.5px;
  }

  .rel-card__price span:first-child {
    white-space: nowrap;
  }

  .rel-card__cta {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    white-space: nowrap;
    transform: translateX(-8px);
    transition:
      max-width 0.5s var(--ease),
      opacity 0.4s,
      transform 0.5s var(--ease);
  }

  .rel-card:hover .rel-card__cta {
    max-width: 120px;
    opacity: 1;
    transform: none;
  }

  .rel-card__add {
    flex: none;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 50%;
    background: var(--peach);
    color: var(--navy);
    font: 700 24px/1 var(--font-sans);
    transition: transform 0.3s;
  }

  .rel-card__add:hover {
    transform: rotate(90deg) scale(1.08);
  }

  /*
   * Handy: kleinere Karten, damit 2½ nebeneinander zu sehen sind
   * (Breite = Bildschirm minus Rand 20px und zwei Abstände à 12px, geteilt durch 2,5).
   * Weniger auf dem Bild: keine Familien, kleinere Schrift und kleinerer "+"-Knopf.
   */
  @media (max-width: 899px) {
    .rel-card {
      width: calc((100vw - 44px) / 2.5);
      border-radius: 16px;
    }

    .rel-card__line,
    .rel-card :global(.rel-card__chips) {
      display: none;
    }

    .rel-card__num {
      top: 10px;
      left: 12px;
      font-size: 15px;
    }

    .rel-card__bottom {
      left: 10px;
      right: 10px;
      bottom: 10px;
      gap: 6px;
    }

    .rel-card__name {
      margin-bottom: 5px;
      overflow: hidden;
      font-size: 14px;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .rel-card__price {
      font-size: 9px;
      letter-spacing: 0.5px;
    }

    .rel-card__add {
      width: 28px;
      height: 28px;
      font-size: 17px;
    }
  }
</style>
