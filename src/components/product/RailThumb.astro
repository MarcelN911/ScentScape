---
/** Vorschaubild in der Leiste unter der Galerie. @typedef {{ thumb: object, index: number }} Props */
const { thumb, index } = Astro.props;
---

<button class:list={thumb.classes} type="button" aria-label={thumb.label} data-stage-thumb={index}>
  <img src={thumb.src} alt="" loading="lazy" />
  {thumb.ring && (
    <span class="rail__ring">
      <span />
    </span>
  )}
</button>

<style>
  .rail__thumb {
    position: relative;
    flex: none;
    width: 50px;
    height: 62px;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgb(var(--peach-rgb) / 0.3);
    border-radius: 14px;
    background: var(--navy-card);
    opacity: 0.55;
    transition:
      width 0.5s var(--ease),
      opacity 0.35s,
      box-shadow 0.35s;
  }

  .rail__thumb:hover {
    opacity: 1;
  }

  .rail__thumb.is-active {
    width: 72px;
    opacity: 1;
    box-shadow:
      0 0 0 2px var(--peach),
      0 0 18px rgb(var(--peach-rgb) / 0.35);
  }

  .rail__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rail__ring {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(var(--navy-deep-rgb) / 0.45);
  }

  .rail__ring span {
    width: 60%;
    aspect-ratio: 1;
    border: 1px solid var(--sand);
    border-radius: 50%;
    box-shadow: 0 0 10px rgb(var(--peach-rgb) / 0.6);
  }

  @media (min-width: 520px) {
    .rail__thumb {
      width: 62px;
      height: 76px;
    }

    .rail__thumb.is-active {
      width: 92px;
    }
  }
</style>
