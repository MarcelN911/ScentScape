---
import { cartItemJson } from '../../scripts/cart/cart-item.js';
import { previewJson } from '../../scripts/catalog/preview.js';
import { metaLineOf, sizesTextOf } from '../../scripts/catalog/theme.js';
import { formatCOP, padNumber } from '../../scripts/utils/format.js';
import { imageUrl } from '../../scripts/utils/image.js';

/** @typedef {{ product: object, index: number }} Props */
const { product, index } = Astro.props;
---

<div class="row" data-list-preview={previewJson(product)}>
  <a class="row__link" href={`/producto/${product.slug}/`} aria-label={product.name}></a>
  <span class="row__num" data-item-number>
    {padNumber(index + 1)}
  </span>
  <span class:list={['row__thumb', { 'row__thumb--cover': product.hasCoverPhoto }]}>
    <img src={imageUrl(product.images[0], 300)} alt="" loading="lazy" draggable="false" />
  </span>
  <span class="row__text">
    <span class="row__name">{product.name}</span>
    <span class="row__meta">{metaLineOf(product)}</span>
  </span>
  <span class="row__sizes">{sizesTextOf(product)}</span>
  <span class="row__price">{formatCOP(product.price)}</span>
  <button
    class="icon-btn icon-btn--solid row__add"
    type="button"
    data-action="add-to-cart"
    data-cart-item={cartItemJson(product)}
    aria-label="Añadir"
  >
    +
  </button>
</div>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto 44px;
    align-items: center;
    gap: 14px;
    padding: 10px;
    border-radius: 24px;
    border: 1px solid rgb(var(--peach-rgb) / 0.1);
    background: rgb(var(--white-rgb) / 0.02);
    transition:
      background 0.45s,
      border-color 0.45s,
      transform 0.6s var(--ease);
  }

  .row:hover {
    border-color: rgb(var(--peach-rgb) / 0.45);
    background: linear-gradient(90deg, rgb(var(--peach-rgb) / 0.14), rgb(var(--peach-rgb) / 0.04));
    transform: translateX(6px);
  }

  .row__link {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .row__num,
  .row__sizes {
    display: none;
  }

  .row__num {
    font: 700 12px/1 var(--font-sans);
    letter-spacing: 1px;
    color: rgb(var(--white-rgb) / 0.4);
    transition: color 0.4s;
  }

  .row:hover .row__num,
  .row:hover .row__meta {
    color: var(--peach);
  }

  .row__thumb {
    display: block;
    width: 72px;
    height: 72px;
    overflow: hidden;
    border-radius: 18px;
    background: var(--navy-raised);
    box-shadow: 0 10px 24px rgb(0 0 0 / 0.3);
  }

  .row__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.8s var(--ease);
  }

  .row__thumb--cover img {
    object-fit: cover;
  }

  .row:hover .row__thumb img {
    transform: scale(1.12);
  }

  .row__text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .row__name {
    overflow: hidden;
    font: 500 clamp(20px, 2.2vw, 30px) / 1.05 var(--font-serif);
    letter-spacing: -0.025em;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .row__meta {
    font: 600 11px/1 var(--font-sans);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgb(var(--white-rgb) / 0.55);
    transition: color 0.4s;
  }

  .row__sizes {
    font: 500 13px/1 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.55);
    white-space: nowrap;
  }

  .row__price {
    font: 700 17px/1 var(--font-sans);
    text-align: right;
    white-space: nowrap;
  }

  .row__add {
    position: relative;
    z-index: 2;
    font: 700 22px/1 var(--font-sans);
  }

  @media (min-width: 820px) {
    .row {
      grid-template-columns: 44px 96px minmax(0, 1fr) 120px 110px 46px;
      gap: 22px;
      padding: 12px 18px 12px 14px;
    }

    .row__num,
    .row__sizes {
      display: block;
    }

    .row__thumb {
      width: 96px;
      height: 96px;
    }
  }
</style>
