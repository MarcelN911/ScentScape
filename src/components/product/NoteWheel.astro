---
/*
 * Noten im Kreis um die Flasche (zweites Bild der Galerie).
 * Die ersten 6 Noten liegen auf einer Ellipse, jede mit Foto und Name.
 */
import { familyOfIngredient, scentColor } from '../../data/scent.js';

/** @typedef {{ notes: string[], images: Record<string, string> }} Props */
const { notes, images } = Astro.props;
const shown = notes.slice(0, 6);
const RX = 37;
const placed = shown.map((note, index) => {
  const angle = -Math.PI / 2 + (index * 2 * Math.PI) / shown.length;
  return {
    note,
    image: images[note],
    color: scentColor(familyOfIngredient(note)),
    x: (50 + RX * Math.cos(angle)).toFixed(2),
    y: (50 + RX * 0.87 * Math.sin(angle)).toFixed(2),
    delay: 250 + index * 110,
  };
});
---

<div class="note-wheel" data-note-wheel aria-hidden="true">
  <span class="note-wheel__shade"></span>
  <span class="note-wheel__ring">
    <span></span>
    <span></span>
  </span>
  {placed.map((item) => (
    <div
      class="note-wheel__note"
      style={`left:${item.x}%;top:${item.y}%;--color:${item.color};--delay:${item.delay}ms`}
    >
      <span class="note-wheel__avatar">
        {item.image && <img src={item.image} alt="" loading="lazy" />}
      </span>
      <span class="note-wheel__label">{item.note}</span>
    </div>
  ))}
</div>

<style>
  .note-wheel {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s;
  }

  .note-wheel__shade {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 42% 40% at 50% 50%,
      rgb(var(--navy-deep-rgb) / 0) 40%,
      rgb(var(--navy-deep-rgb) / 0.55) 100%
    );
  }

  .note-wheel__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 74%;
    aspect-ratio: 1;
    border: 1px solid rgb(var(--sand-rgb) / 0.6);
    border-radius: 50%;
    box-shadow:
      0 0 40px rgb(var(--peach-rgb) / 0.18),
      inset 0 0 40px rgb(var(--peach-rgb) / 0.12);
    transform: translate(-50%, -50%) rotate(-70deg) scale(0.85);
    transition: transform 1.4s var(--ease);
  }

  .note-wheel__ring span:first-child {
    position: absolute;
    inset: 7%;
    border: 1px dashed rgb(var(--sand-rgb) / 0.3);
    border-radius: 50%;
  }

  .note-wheel__ring span:last-child {
    position: absolute;
    left: 50%;
    top: -4px;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border-radius: 50%;
    background: var(--peach);
    box-shadow: 0 0 12px 3px rgb(var(--peach-rgb) / 0.7);
  }

  .note-wheel__note {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.3);
    transition:
      transform 0.8s cubic-bezier(0.3, 1.4, 0.5, 1),
      opacity 0.5s;
  }

  .note-wheel__avatar {
    position: relative;
    width: 76px;
    height: 76px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--color);
    box-shadow:
      0 0 0 2px rgb(var(--navy-deep-rgb) / 0.9),
      0 0 0 3px var(--color),
      0 0 22px var(--color);
  }

  .note-wheel__avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .note-wheel__label {
    padding: 5px 14px;
    border-radius: 14px;
    background: rgb(var(--navy-deep-rgb) / 0.65);
    backdrop-filter: blur(8px);
    color: var(--cream);
    font: italic 400 20px/1.1 var(--font-serif);
    white-space: nowrap;
  }

  :global(.is-wheel) .note-wheel {
    opacity: 1;
  }

  :global(.is-wheel) .note-wheel__ring {
    transform: translate(-50%, -50%) rotate(0deg) scale(1);
  }

  :global(.is-wheel) .note-wheel__note {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    transition-delay: var(--delay);
  }

  @media (max-width: 520px) {
    .note-wheel__avatar {
      width: 54px;
      height: 54px;
    }

    .note-wheel__label {
      font-size: 16px;
    }
  }
</style>
