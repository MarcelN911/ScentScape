---
import { cartItemJson } from '../../scripts/cart/cart-item.js';

/** @typedef {{ product: object, size: { ml: number, label: string } }} Props */
const { product, size } = Astro.props;
---

<button
  class="add-size"
  type="button"
  data-action="add-to-cart"
  data-cart-item={cartItemJson(product, size)}
>
  + {size.label}
</button>

<style>
  .add-size {
    height: 34px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--peach);
    color: var(--navy);
    font: 700 12px/1 var(--font-sans);
    white-space: nowrap;
    transition: background-color 0.25s ease;
  }

  .add-size:hover {
    background: var(--white);
  }
</style>
