---
import { starsOf } from '../../scripts/catalog/reviews.js';
import { formatMonth } from '../../scripts/utils/format.js';
import { initialOf } from '../../scripts/utils/text.js';

/** @typedef {{ review: object, index: number }} Props */
const { review, index } = Astro.props;
const place = [review.city, 'Compra verificada'].filter(Boolean).join(' · ');
---

<article class="review" data-reveal="up" style={`--reveal-delay:${(index % 3) * 100}ms`}>
  <div class="review__top">
    <span class="review__stars" aria-label={`${review.rating} de 5`}>
      {starsOf(review.rating)}
    </span>
    <span class="review__date">{formatMonth(review.date)}</span>
  </div>
  <p class="review__text">“{review.text}”</p>
  <div class="review__author">
    <span class="review__initial">{initialOf(review.name)}</span>
    <span class="review__who">
      <span class="review__name">{review.name}</span>
      <span class="review__place">{place}</span>
    </span>
  </div>
</article>

<style>
  .review {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 26px;
    border-radius: 26px;
    border: 1px solid rgb(var(--peach-rgb) / 0.15);
    background: rgb(var(--white-rgb) / 0.035);
  }

  .review__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .review__stars {
    letter-spacing: 2px;
    color: var(--gold);
  }

  .review__date,
  .review__place {
    font: 500 12px/1 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.5);
  }

  .review__text {
    margin: 0;
    font: italic 400 21px/1.4 var(--font-serif);
    text-wrap: pretty;
  }

  .review__author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }

  .review__initial {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--peach);
    color: var(--navy);
    font: 800 15px/1 var(--font-sans);
  }

  .review__who {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .review__name {
    font: 700 13px/1 var(--font-sans);
  }
</style>
