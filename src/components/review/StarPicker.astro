---
import { RATING_LABELS } from '../../data/reviews.js';

const STARS = [1, 2, 3, 4, 5];
---

<div class="stars" data-star-picker>
  <div class="stars__row" role="radiogroup" aria-labelledby="review-rating-label">
    {STARS.map((value) => (
      <button
        class="stars__star"
        type="button"
        role="radio"
        aria-checked="false"
        aria-label={`${value} de 5`}
        data-star={value}
      >
        ★
      </button>
    ))}
  </div>
  <span class="stars__text" data-star-text>
    {RATING_LABELS[0]}
  </span>
  <input type="hidden" name="rating" value="0" />
</div>

<style>
  .stars {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .stars__row {
    display: flex;
    gap: 4px;
  }

  .stars__star {
    padding: 0;
    border: 0;
    background: none;
    color: rgb(var(--peach-rgb) / 0.25);
    font-size: 38px;
    line-height: 1;
    transition:
      color 0.2s,
      transform 0.2s;
  }

  .stars__star.is-lit {
    color: var(--gold);
  }

  .stars__star:hover {
    transform: scale(1.15);
  }

  .stars__text {
    font: italic 400 20px/1 var(--font-serif);
    color: var(--sand);
  }
</style>
