---
/*
 * Fenster zur Aktion als Gutschein-Ticket: oben der Abschnitt mit Wert und Bild (Pfirsich/Gold),
 * eine Perforation mit runden Kerben, unten das Formular (PromoTicketBody.astro).
 * Nach dem Eintragen steht der Code im Abschnitt. Füllen und Absenden: scripts/promo/modal.js
 */
import PromoTicketBody from './PromoTicketBody.astro';
---

<dialog
  class="ticket"
  data-promo-modal
  aria-labelledby="promo-value"
  transition:persist="promo-modal"
>
  <div class="ticket__stub">
    <div class="ticket__top">
      <span class="ticket__brand">ScentScape · Bienvenida</span>
      <button class="ticket__close" type="button" data-promo-close aria-label="Cerrar">
        ✕
      </button>
    </div>
    <div class="ticket__content">
      <div>
        <p class="ticket__value">
          <span id="promo-value" data-promo-value></span>
          <span class="ticket__label" data-promo-label></span>
        </p>
        <p class="ticket__conditions" data-promo-conditions></p>
      </div>
      <img class="ticket__photo" data-promo-image alt="" hidden />
    </div>

    <div class="ticket__code" data-promo-code-row hidden>
      <span>Tu código</span>
      <strong data-promo-code></strong>
      <button type="button" data-promo-copy>
        Copiar
      </button>
    </div>
  </div>

  <PromoTicketBody />
</dialog>

<style>
  /* Das Fenster selbst ist unsichtbar, sichtbar sind Abschnitt und Formularteil */
  .ticket {
    --notch: 15px;
    width: min(400px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    /* Sehr kleine Bildschirme: das Fenster scrollt in sich, die Seite dahinter ist gesperrt */
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 0;
    background: none;
    color: var(--cream);
    filter: drop-shadow(0 18px 40px rgb(0 0 0 / 0.3));
  }

  .ticket[open] {
    animation: ticket-in 0.6s var(--ease);
  }

  .ticket::backdrop {
    background: rgb(8 10 22 / 0.72);
    backdrop-filter: blur(5px);
  }

  @keyframes ticket-in {
    from {
      opacity: 0;
      transform: translateY(30px) rotate(-1.5deg);
    }
  }

  /* Oberer Abschnitt: runde Kerben unten links und rechts (Maske) */
  .ticket__stub {
    position: relative;
    padding: 22px 26px 26px;
    border-radius: 22px 22px 0 0;
    background:
      radial-gradient(120% 90% at 85% 0%, rgb(255 255 255 / 0.35), transparent 60%),
      linear-gradient(135deg, var(--peach), var(--sand));
    color: var(--navy);
    mask:
      radial-gradient(circle var(--notch) at 0 100%, #0000 98%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle var(--notch) at 100% 100%, #0000 98%, #000) right / 51% 100% no-repeat;
  }

  /* Feine Rahmenlinie innen, wie auf einem gedruckten Gutschein */
  .ticket__stub::before {
    content: '';
    position: absolute;
    inset: 8px 8px 0;
    border: 1px solid rgb(var(--navy-rgb) / 0.18);
    border-bottom: 0;
    border-radius: 16px 16px 0 0;
    pointer-events: none;
  }

  .ticket__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .ticket__brand {
    font: 600 9px var(--font-sans);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .ticket__close {
    position: relative;
    width: 34px;
    height: 34px;
    margin-right: -6px;
    border: 1px solid rgb(var(--navy-rgb) / 0.3);
    border-radius: 50%;
    background: none;
    color: var(--navy);
    font-size: 13px;
  }

  /* Wert links, Bild der Aktion rechts (falls es eines gibt) */
  .ticket__content {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 14px;
  }

  /* Bild wie ein Foto mit hellem Rand, leicht schräg auf den Gutschein gelegt */
  .ticket__photo {
    flex: none;
    width: clamp(84px, 28vw, 128px);
    aspect-ratio: 2 / 3;
    margin: 6px 4px 0 0;
    border: 4px solid #fff8ec;
    border-radius: 10px;
    object-fit: cover;
    box-shadow: 0 14px 26px rgb(var(--navy-rgb) / 0.35);
    transform: rotate(4deg);
  }

  .ticket[open] .ticket__photo {
    animation: photo-in 0.8s var(--ease) 0.15s backwards;
  }

  @keyframes photo-in {
    from {
      opacity: 0;
      transform: translateY(16px) rotate(12deg);
    }
  }

  .ticket__value {
    display: flex;
    flex-direction: column;
    margin: 10px 0 0;
  }

  .ticket__value span:first-child {
    font: 400 clamp(72px, 24vw, 112px) / 0.9 var(--font-serif);
    letter-spacing: -2px;
  }

  .ticket__label {
    font: italic 400 24px var(--font-serif);
    white-space: nowrap;
  }

  .ticket__conditions {
    margin: 12px 0 0;
    color: rgb(var(--navy-rgb) / 0.7);
    font: 500 11px/1.5 var(--font-sans);
  }

  /* Der Code erscheint nach dem Eintragen, als würde er auf den Gutschein gedruckt */
  .ticket__code {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2px 12px;
    margin-top: 16px;
    padding: 12px 14px;
    border: 1px dashed rgb(var(--navy-rgb) / 0.45);
    border-radius: 14px;
    animation: code-in 0.7s var(--ease);
  }

  .ticket__code[hidden] {
    display: none;
  }

  @keyframes code-in {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .ticket__code span {
    grid-column: 1 / -1;
    font: 600 9px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .ticket__code strong {
    font: 400 26px var(--font-serif);
    letter-spacing: 3px;
  }

  .ticket__code button {
    height: 32px;
    padding: 0 14px;
    border: 0;
    border-radius: 16px;
    background: var(--navy);
    color: var(--sand);
    font: 600 9px var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
  }
</style>

<script>
  import { onFirstPage } from '../../scripts/core/lifecycle.js';
  import { initPromoModal } from '../../scripts/promo/modal.js';

  onFirstPage(initPromoModal);
</script>
