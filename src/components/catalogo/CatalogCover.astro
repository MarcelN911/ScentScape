---
/*
 * Deckblatt des Catálogo Digital nach der PDF-Vorlage (Bild cover.jpg: "Catálogo", Logo, Flakon).
 * In der freien dunklen Fläche über dem Logo stehen Kollektion, Anzahl und für wen er ist.
 * Alle Größen in cqw, deshalb passt es als kleine Vorschau genauso wie als ganze PDF-Seite.
 */
import { CATALOG_YEAR } from '../../data/catalog.js';

/** @typedef {{ collection: string, count: number, client?: string }} Props */
const { collection, count, client = 'ti' } = Astro.props;
---

<div class="cover">
  <div class="cover__info">
    <span class="cover__line">
      <span data-cover-collection>{collection}</span> · <span data-cover-count>{count}</span>{' '}
      fragancias · {CATALOG_YEAR}
    </span>
    <span class="cover__client">
      Preparado para <em data-cover-client>{client}</em>
    </span>
  </div>
</div>

<style>
  .cover {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.414;
    overflow: hidden;
    container-type: inline-size;
    border-radius: 4px;
    background: #0b0b0b url('/assets/img/catalogo/cover.jpg') center / cover no-repeat;
    color: #e8c39e;
  }

  .cover__info {
    position: absolute;
    top: 22cqw;
    left: 10cqw;
    right: 10cqw;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.4cqw;
    text-align: center;
  }

  .cover__line {
    font: 500 2.2cqw / 1 var(--font-sans);
    letter-spacing: 0.5cqw;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .cover__client {
    max-width: 100%;
    overflow: hidden;
    font: italic 400 4.6cqw / 1.2 var(--font-serif);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .cover__client em {
    color: #f3d9bd;
  }
</style>
