---
/** @typedef {{ color: { name: string, background: string }, index: number }} Props */
const { color, index } = Astro.props;
---

<button
  class="swatch"
  type="button"
  data-choice="color"
  data-value={index}
  aria-pressed={String(index === 0)}
  aria-label={color.name}
  title={color.name}
>
  <span style={`background:${color.background}`}></span>
</button>

<style>
  .swatch {
    width: 44px;
    height: 44px;
    padding: 4px;
    border-radius: 50%;
    border: 1.5px solid rgb(var(--peach-rgb) / 0.2);
    background: none;
    transition: all 0.3s var(--ease);
  }

  .swatch[aria-pressed='true'] {
    border-color: var(--peach);
    transform: scale(1.08);
  }

  .swatch span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.15);
  }
</style>
