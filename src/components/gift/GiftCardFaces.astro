---
import { GIFT_AMOUNTS, GIFT_COLORS, GIFT_DEFAULTS } from '../../data/gift-card.js';
import { formatCOP } from '../../scripts/utils/format.js';

const color = GIFT_COLORS[0];
const style = `--gc-bg:${color.background};--gc-ink:${color.ink};--gc-foil:${color.foil};--gc-logo:${color.logo}`;
---

<div class="gc-stage" data-gift-stage data-cursor="Girar">
  <div class="gc" data-gift-card style={style}>
    <div class="gc__face">
      <div class="gc__pattern"></div>
      <div class="gc__frame"></div>
      <div class="gc__light"></div>
      <div class="gc__sheen"></div>
      <div class="gc__content">
        <div class="gc__row">
          <img class="gc__logo" src="/assets/img/scentscape-logo.png" alt="ScentScape Parfums" />
          <span class="gc__label">Gift card</span>
        </div>
        <div class="gc__amount-row">
          <span class="gc__amount" data-gift-amount>
            {formatCOP(GIFT_AMOUNTS[1])}
          </span>
          <span class="gc__cop">COP</span>
        </div>
        <div class="gc__names">
          <span class="gc__name">
            <span class="gc__small">Para</span>
            <span data-gift-to>{GIFT_DEFAULTS.to}</span>
          </span>
          <span class="gc__name gc__name--end">
            <span class="gc__small">De</span>
            <span data-gift-from>{GIFT_DEFAULTS.from}</span>
          </span>
        </div>
      </div>
    </div>
    <div class="gc__face gc__face--back">
      <div class="gc__pattern gc__pattern--back"></div>
      <div class="gc__frame"></div>
      <div class="gc__content gc__content--back">
        <span class="gc__label">Un mensaje para ti</span>
        <p class="gc__message">
          “<span data-gift-message>{GIFT_DEFAULTS.message}</span>”
        </p>
        <span class="gc__small">scentscape.com.co</span>
      </div>
    </div>
  </div>
</div>

<style>
  .gc-stage {
    width: 100%;
    max-width: 580px;
    perspective: 1400px;
    cursor: pointer;
    animation: float-soft 6s ease-in-out infinite;
  }

  .gc {
    position: relative;
    width: 100%;
    aspect-ratio: 1.586 / 1;
    transform: rotateX(var(--ry, 0deg)) rotateY(calc(var(--rx, 0deg) + var(--flip, 0deg)));
    transform-style: preserve-3d;
    transition: transform 0.9s var(--ease);
  }

  .gc.is-tracking {
    transition: transform 0.15s ease-out;
  }

  .gc.is-flipped {
    --flip: 180deg;
  }

  .gc__face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 22px;
    background: var(--gc-bg);
    box-shadow: 0 50px 90px rgb(0 0 0 / 0.55);
    color: var(--gc-ink);
    backface-visibility: hidden;
    transition:
      background 0.6s ease,
      color 0.6s ease;
  }

  .gc__face--back {
    transform: rotateY(180deg);
  }

  .gc__pattern {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      135deg,
      rgb(255 255 255 / 0.06) 0 1px,
      transparent 1px 5px
    );
  }

  .gc__pattern--back {
    background-image: repeating-linear-gradient(
      45deg,
      rgb(255 255 255 / 0.05) 0 1px,
      transparent 1px 6px
    );
  }

  .gc__frame {
    position: absolute;
    inset: 12px;
    border: 1px solid var(--gc-ink);
    border-radius: 14px;
    outline: 1px solid var(--gc-ink);
    outline-offset: -6px;
    opacity: 0.55;
  }

  .gc__light {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at var(--mx, 30%) var(--my, 20%),
      rgb(255 255 255 / 0.32),
      transparent 45%
    );
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .gc__sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 35%,
      rgb(255 255 255 / 0.22) 48%,
      transparent 60%
    );
    background-size: 250% 100%;
    animation: sheen 5s ease-in-out infinite;
    pointer-events: none;
  }

  .gc__content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: clamp(24px, 3.4vw, 40px);
  }

  .gc__content--back {
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: clamp(28px, 4vw, 52px);
    text-align: center;
  }

  .gc__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  .gc__logo {
    width: auto;
    height: clamp(26px, 3vw, 38px);
    filter: var(--gc-logo);
    transition: filter 0.6s;
  }

  .gc__label {
    font: 600 10px/1 var(--font-sans);
    letter-spacing: 3.5px;
    text-transform: uppercase;
  }

  .gc__amount-row {
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }

  .gc__amount {
    display: inline-block;
    background-image: var(--gc-foil);
    background-size: 220% 100%;
    background-clip: text;
    color: transparent;
    font: 400 clamp(44px, 6vw, 82px) / 1 var(--font-serif);
    letter-spacing: -0.01em;
    animation:
      sheen 5s ease-in-out infinite,
      fade-in 0.5s var(--ease) both;
  }

  .gc__cop {
    margin-top: 0.9em;
    font: 600 12px/1 var(--font-sans);
    letter-spacing: 2.5px;
  }

  .gc__names {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font: italic 400 clamp(18px, 2vw, 26px) / 1.1 var(--font-serif);
  }

  .gc__name {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .gc__name > :last-child {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .gc__name--end {
    align-items: flex-end;
  }

  .gc__small {
    font: 600 9px/1 var(--font-sans);
    font-style: normal;
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .gc__message {
    max-width: 420px;
    margin: 0;
    font: italic 400 clamp(20px, 2.3vw, 30px) / 1.35 var(--font-serif);
    text-wrap: pretty;
  }
</style>
