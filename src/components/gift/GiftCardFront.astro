---
import ColorLayers from './ColorLayers.astro';
import Odometer from './Odometer.astro';

/** @typedef {{ color: number, amount: string, to: string, from: string }} Props */
const { color, amount, to, from } = Astro.props;
---

<div class="face">
  <ColorLayers color={color} />
  <span class="face__light"></span>
  <span class="face__rings"></span>
  <span class="face__sweep" data-gift-sweep></span>
  <span class="face__glare"></span>
  <span class="face__frame"></span>
  <div class="face__content">
    <div class="face__top">
      <img src="/assets/img/scentscape-logo.png" alt="ScentScape" />
      <span class="face__kind">
        <i></i>Gift Card
      </span>
    </div>
    <div class="face__middle">
      <span class="face__chip" aria-hidden="true"></span>
      <div class="face__amount" aria-label={`${amount} COP`} data-gift-amount-wrap>
        <span class="face__digits" data-gift-amount>
          <Odometer text={amount} />
        </span>
        <span class="face__cop">COP</span>
      </div>
    </div>
    <div class="face__bottom">
      <span>
        <small>Para</small>
        <em data-gift-to>{to}</em>
      </span>
      <span class="face__from">
        <small>De</small>
        <em data-gift-from>{from}</em>
      </span>
    </div>
  </div>
</div>

<style>
  .face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 22px;
    color: var(--ink);
    box-shadow:
      0 50px 100px rgb(0 0 0 / 0.55),
      0 0 0 1px rgb(var(--cream-rgb) / 0.06);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: color 0.6s;
  }

  .face > span {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .face__light {
    background:
      radial-gradient(120% 80% at 100% 0%, rgb(var(--cream-rgb) / 0.14), transparent 55%),
      radial-gradient(90% 70% at 0% 100%, rgb(0 0 0 / 0.35), transparent 60%);
  }

  .face__rings {
    opacity: 0.5;
    background: repeating-radial-gradient(
      circle at 115% -15%,
      transparent 0 22px,
      var(--line) 22px 23px
    );
    mask-image: linear-gradient(200deg, #000, transparent 65%);
  }

  .face .face__sweep {
    top: -30%;
    bottom: -30%;
    left: 0;
    width: 40%;
    z-index: 4;
    background: linear-gradient(100deg, transparent, rgb(255 244 228 / 0.28) 50%, transparent);
    transform: translateX(-160%) skewX(-18deg);
  }

  .face__glare {
    z-index: 4;
    background: radial-gradient(
      circle at var(--gx, 50%) var(--gy, 50%),
      rgb(255 250 240 / var(--ga, 0)),
      transparent 45%
    );
    transition: background 0.2s;
  }

  .face .face__frame {
    inset: 12px;
    z-index: 5;
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: border-color 0.6s;
  }

  .face__content {
    position: absolute;
    inset: 0;
    z-index: 6;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(22px, 6.5%, 38px);
  }

  .face__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .face__top img {
    height: clamp(20px, 5cqw, 28px);
    width: auto;
    filter: var(--logo);
    transition: filter 0.6s;
  }

  .face__kind {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 600 9px var(--font-sans);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .face__kind i {
    width: 18px;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  .face__middle {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 2.4cqw, 14px);
  }

  .face__chip {
    position: relative;
    width: clamp(34px, 8.5%, 46px);
    aspect-ratio: 1.35;
    overflow: hidden;
    border-radius: 7px;
    background: linear-gradient(135deg, var(--sand-light), #c9a06e 45%, #f0d2aa 70%, #b88d58);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
  }

  .face__chip::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        transparent 32%,
        rgb(0 0 0 / 0.18) 32% 34%,
        transparent 34% 66%,
        rgb(0 0 0 / 0.18) 66% 68%,
        transparent 68%
      ),
      linear-gradient(0deg, transparent 46%, rgb(0 0 0 / 0.18) 46% 54%, transparent 54%);
  }

  .face__amount {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .face__digits {
    display: flex;
    color: var(--amount);
    font: 400 clamp(26px, calc(12cqw * var(--amount-k, 1)), 68px) / 1 var(--font-serif);
    font-variant-numeric: lining-nums tabular-nums;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.18);
    transition: color 0.6s;
  }

  .face__cop {
    margin-top: 0.5em;
    font: 600 9px var(--font-sans);
    letter-spacing: 3px;
    opacity: 0.8;
  }

  .face__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }

  .face__bottom > span {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .face .face__from {
    align-items: flex-end;
  }

  .face__bottom small {
    font: 600 8px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .face__bottom em {
    overflow: hidden;
    padding-bottom: 0.1em;
    font: italic 400 clamp(18px, 4.2cqw, 24px) / 1.3 var(--font-serif);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
