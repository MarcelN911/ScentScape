---
import ColorLayers from './ColorLayers.astro';

/** @typedef {{ color: number, message: string, code: string, valid: string, faded?: boolean }} Props */
const { color, message, code, valid, faded = false } = Astro.props;
---

<div class="back">
  <ColorLayers color={color} />
  <span class="back__stripe"></span>
  <span class="back__frame"></span>
  <div class="back__content">
    <p class:list={['back__message', { 'is-faded': faded }]} data-gift-message>
      “{message}”
    </p>
    <div class="back__row">
      <span class="back__code">
        <small>Código</small>
        <span>{code}</span>
      </span>
      <span class="back__valid">{valid}</span>
    </div>
  </div>
</div>

<style>
  .back {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 22px;
    color: var(--ink);
    box-shadow:
      0 50px 100px rgb(0 0 0 / 0.55),
      0 0 0 1px rgb(var(--cream-rgb) / 0.06);
    transform: rotateY(180deg);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: color 0.6s;
  }

  .back__stripe {
    position: absolute;
    left: 0;
    right: 0;
    top: 15%;
    z-index: 3;
    height: 15%;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0.35));
  }

  .back__frame {
    position: absolute;
    inset: 12px;
    z-index: 5;
    border: 1px solid var(--line);
    border-radius: 14px;
    pointer-events: none;
  }

  .back__content {
    position: absolute;
    inset: 0;
    z-index: 6;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    padding: 38% clamp(22px, 6.5%, 38px) clamp(22px, 6.5%, 38px);
  }

  .back__message {
    margin: 0;
    overflow-wrap: anywhere;
    font: italic 400 clamp(16px, 3.9cqw, 22px) / 1.35 var(--font-serif);
    text-wrap: pretty;
  }

  .back__message.is-faded {
    opacity: 0.5;
  }

  .back__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
  }

  .back__code {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .back__code small {
    font: 600 8px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .back__code span {
    font: 500 13px var(--font-sans);
    letter-spacing: 3px;
  }

  .back__valid {
    font: 500 9px var(--font-sans);
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: 0.7;
  }
</style>
