---
/* Fragen der Seite "Te asesoramos". Ein Klick stellt die Frage im Handy-Chat (scripts/features/chat/questions.js). */
import { FAQ_QUESTIONS } from '../../data/faq.js';
import { padNumber } from '../../scripts/utils/format.js';
---

<p class="faq-label reveal-late" style="--late:1.1s">
  Preguntas frecuentes · toca una
</p>
<div class="faq-list reveal-late" style="--late:1.2s">
  {FAQ_QUESTIONS.map((item, index) => (
    <button class="faq-list__q" type="button" data-chat-question={index}>
      <span class="faq-list__n">{padNumber(index + 1)}</span>
      <span class="faq-list__text">
        <small>{item.category}</small>
        {item.question}
      </span>
      <span class="faq-list__arrow" aria-hidden="true">
        →
      </span>
    </button>
  ))}
</div>

<style>
  .faq-label {
    margin: 0 0 -14px;
    color: var(--peach);
    font: 400 10px var(--font-sans);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgb(var(--peach-rgb) / 0.22);
  }

  .faq-list__q {
    display: flex;
    align-items: center;
    gap: 20px;
    width: 100%;
    padding: 26px 0;
    border: 0;
    border-bottom: 1px solid rgb(var(--peach-rgb) / 0.22);
    background: none;
    color: var(--cream);
    text-align: left;
    transition:
      color 0.4s,
      padding 0.4s;
  }

  .faq-list__q:hover {
    padding-left: 14px;
    color: var(--sand);
  }

  .faq-list__q:disabled {
    cursor: wait;
  }

  .faq-list__q:global(.is-asked) {
    color: var(--sand);
    font-style: italic;
  }

  .faq-list__n {
    min-width: 22px;
    color: var(--peach);
    font: 400 10px var(--font-sans);
    letter-spacing: 2px;
  }

  .faq-list__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    font: 400 clamp(21px, 1.6vw, 26px) / 1.3 var(--font-serif);
  }

  .faq-list__text small {
    color: rgb(var(--cream-rgb) / 0.5);
    font: 400 9px var(--font-sans);
    font-style: normal;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .faq-list__arrow {
    flex: none;
    color: var(--peach);
    font: 300 16px var(--font-sans);
  }
</style>
