---
/** @typedef {{ channel: { label: string, value: string, text: string, cta?: string, href?: string, icon?: string, compact?: boolean }, index: number }} Props */
const { channel, index } = Astro.props;
const external = channel.href?.startsWith('http');
---

<article
  class="contact-card frame frame--soft"
  data-reveal="up"
  style={`--reveal-delay:${index * 100}ms`}
>
  <p class="eyebrow">{channel.label}</p>
  <p class:list={['contact-card__value', { 'contact-card__value--compact': channel.compact }]}>
    {channel.value}
  </p>
  <p class="contact-card__text">{channel.text}</p>
  {channel.href && (
    <a
      class="contact-card__link"
      href={channel.href}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener' : undefined}
    >
      {channel.icon && <img src={channel.icon} alt="" width="16" height="16" />}
      {channel.cta} →
    </a>
  )}
</article>

<style>
  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(24px, 3vw, 36px);
    border-radius: 0;
  }

  .contact-card__value {
    margin: 0;
    font: 500 clamp(24px, 2.4vw, 32px) / 1.1 var(--font-serif);
    overflow-wrap: anywhere;
  }

  .contact-card__value--compact {
    font-size: clamp(18px, 1.5vw, 22px);
  }

  .contact-card__text {
    margin: 0;
    font: 400 15px/1.6 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.72);
  }

  .contact-card__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    font: 700 13px/1 var(--font-sans);
  }
</style>
