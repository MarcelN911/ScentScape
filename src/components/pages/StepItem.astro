---
/** @typedef {{ step: { title: string, text: string }, number: string }} Props */
const { step, number } = Astro.props;
---

<article class="step-item">
  <span class="step-item__number">{number}</span>
  <h3 class="step-item__title">{step.title}</h3>
  <p class="step-item__text">{step.text}</p>
</article>

<style>
  .step-item {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 26px;
    border-top: 1px solid rgb(var(--peach-rgb) / 0.4);
  }

  .step-item__number {
    font: italic 400 46px/1 var(--font-serif);
    color: var(--peach);
  }

  .step-item__title {
    margin: 0;
    font: 500 26px/1.1 var(--font-serif);
  }

  .step-item__text {
    margin: 0;
    font: 400 15px/1.65 var(--font-sans);
    color: rgb(var(--white-rgb) / 0.75);
    text-wrap: pretty;
  }
</style>
