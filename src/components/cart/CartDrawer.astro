---
import Drawer from '../ui/Drawer.astro';
import Icon from '../ui/Icon.astro';
import CartLineTemplate from './CartLineTemplate.astro';
import CartTotals from './CartTotals.astro';
---

<Drawer name="cart" label="Tu bolsa" eyebrow="ScentScape · Bolsa">
  <Fragment slot="title">
    Tu <em>bolsa</em>
  </Fragment>
  <div class="cart__view">
    <div class="cart__shipping">
      <span class="cart__ship-text" data-ship-text></span>
      <span class="cart__ship-track">
        <span class="cart__ship-bar" data-ship-bar></span>
      </span>
    </div>
    <div class="drawer__list">
      <div class="drawer__empty" data-cart-empty>
        <Icon name="bag" size={44} strokeWidth={1.2} />
        <p>Tu bolsa está vacía</p>
        <a href="/productos/">Ver productos →</a>
      </div>
      <div data-cart-lines></div>
    </div>
    <CartTotals />
  </div>
  <CartLineTemplate />
</Drawer>

<style>
  .cart__view {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }

  .cart__shipping {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0 28px 16px;
  }

  .cart__ship-text {
    color: rgb(var(--cream-rgb) / 0.7);
    font: 400 12px var(--font-sans);
  }

  .cart__ship-text.is-free {
    color: var(--sand);
  }

  .cart__ship-track {
    display: block;
    height: 3px;
    overflow: hidden;
    border-radius: 2px;
    background: rgb(var(--peach-rgb) / 0.15);
  }

  .cart__ship-bar {
    display: block;
    width: var(--ship-progress, 0%);
    height: 100%;
    background: linear-gradient(90deg, var(--peach), var(--sand));
    transition: width 0.8s var(--ease);
  }
</style>

<script>
  import { onFirstPage } from '../../scripts/core/lifecycle.js';
  import { initCartUi } from '../../scripts/cart/ui/index.js';
  import '../../scripts/cart/add-to-cart.js';

  onFirstPage(initCartUi);
</script>
