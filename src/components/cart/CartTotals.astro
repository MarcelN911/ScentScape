---
/*
 * Summen unten in der Bolsa. Rabattcode, Gift Card und Lieferdaten kommen auf der Seite /checkout/.
 * Werte füllt scripts/cart/ui/totals.js.
 */
---

<div class="totals">
  <div class="totals__row">
    <span>Subtotal</span>
    <span data-cart-subtotal></span>
  </div>
  <div class="totals__row totals__row--accent" data-sale-row hidden>
    <span>Ofertas</span>
    <span data-sale-value></span>
  </div>
  <div class="totals__row totals__row--accent" data-discount-row hidden>
    <span data-discount-label></span>
    <span data-discount-value></span>
  </div>
  <div class="totals__row">
    <span>Envío</span>
    <span data-ship-value></span>
  </div>
  <div class="totals__sum">
    <span class="totals__label">Total</span>
    <span class="totals__total">
      <span data-cart-total>$0</span> <small>COP</small>
    </span>
  </div>
  <a class="totals__cta" href="/checkout/" data-cart-cta>
    Finalizar compra <span aria-hidden="true">→</span>
  </a>
  <span class="totals__note">Códigos de descuento y gift cards en el siguiente paso.</span>
</div>

<style>
  .totals {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px 28px 24px;
    border-top: 1px solid rgb(var(--peach-rgb) / 0.18);
    background: rgb(var(--navy-rgb) / 0.4);
  }

  .totals__row {
    display: flex;
    justify-content: space-between;
    color: rgb(var(--cream-rgb) / 0.75);
    font: 400 13px var(--font-sans);
  }

  .totals__row--accent {
    color: var(--sand);
  }

  .totals__sum {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 6px;
  }

  .totals__label {
    color: rgb(var(--cream-rgb) / 0.6);
    font: 400 10px var(--font-sans);
    letter-spacing: 4px;
    text-transform: uppercase;
  }

  .totals__total {
    color: var(--sand);
    font: 400 30px var(--font-serif);
  }

  .totals__total small {
    color: rgb(var(--cream-rgb) / 0.6);
    font: 500 10px var(--font-sans);
    letter-spacing: 2px;
  }

  .totals__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 56px;
    border-radius: 28px;
    background: var(--peach);
    color: var(--navy);
    font: 500 11px var(--font-sans);
    letter-spacing: 3px;
    text-transform: uppercase;
    transition: gap 0.4s;
  }

  .totals__cta:hover {
    gap: 20px;
    color: var(--navy);
  }

  .totals__cta[aria-disabled='true'] {
    background: rgb(var(--peach-rgb) / 0.3);
    pointer-events: none;
  }

  .totals__note {
    color: rgb(var(--cream-rgb) / 0.5);
    font: 300 12px var(--font-sans);
    text-align: center;
  }
</style>
