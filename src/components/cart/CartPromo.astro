<div class="promo" data-promo>
  <form class="promo__form" data-promo-form>
    <input
      class="promo__input"
      placeholder="Código de descuento"
      aria-label="Código de descuento"
      autocomplete="off"
      data-promo-input
    />
    <button class="btn btn--dark promo__apply" type="submit" data-promo-apply>
      Aplicar
    </button>
  </form>
  <div class="promo__applied" data-promo-applied hidden>
    <span class="promo__star">✺</span>
    <span class="promo__label" data-promo-label></span>
    <button class="promo__remove" type="button" data-promo-remove aria-label="Quitar código">
      ×
    </button>
  </div>
  <p class="promo__feedback" data-promo-feedback></p>
</div>

<style>
  .promo {
    margin-bottom: 10px;
  }

  .promo__form {
    display: flex;
    gap: 8px;
    padding: 6px 6px 6px 18px;
    border-radius: var(--radius-pill);
    background: rgb(var(--white-rgb) / 0.55);
    border: 1.5px solid rgb(var(--navy-rgb) / 0.12);
  }

  .promo__form[hidden],
  .promo__applied[hidden] {
    display: none;
  }

  .promo__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    outline: none;
    color: var(--navy);
    font: 600 14px/1 var(--font-sans);
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .promo__input::placeholder {
    color: rgb(var(--navy-rgb) / 0.55);
    text-transform: none;
  }

  .promo__apply {
    --btn-height: 42px;
    padding-inline: 20px;
    font-size: 13px;
  }

  .promo__applied {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 10px 10px 18px;
    border-radius: var(--radius-pill);
    background: var(--navy);
    color: var(--sand);
    animation: fade-in 0.3s ease;
  }

  .promo__star {
    font: italic 400 18px/1 var(--font-serif);
  }

  .promo__label {
    flex: 1;
    min-width: 0;
    font: 700 13px/1.2 var(--font-sans);
    letter-spacing: 0.5px;
  }

  .promo__remove {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid rgb(var(--sand-rgb) / 0.35);
    background: none;
    color: var(--sand);
    font: 600 14px/1 var(--font-sans);
  }

  .promo__feedback {
    margin: 6px 0 0 18px;
    font: 600 12px/1.3 var(--font-sans);
    color: var(--wine);
  }

  .promo__feedback:empty {
    display: none;
  }
