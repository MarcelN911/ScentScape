---
/** @typedef {{ mode: { key: string, title: string, text: string, tag: string, tagColor: string } }} Props */
const { mode } = Astro.props;
const tagText = mode.tagColor === '#151932' ? 'var(--sand)' : 'var(--white)';
---

<button class="pay-mode" type="button" data-pay-mode={mode.key} aria-pressed="false">
  <span class="pay-mode__radio">
    <span class="pay-mode__dot"></span>
  </span>
  <span class="pay-mode__text">
    <span class="pay-mode__title">{mode.title}</span>
    <span class="pay-mode__sub">{mode.text}</span>
  </span>
  <span class="pay-mode__tag" style={`background:${mode.tagColor};color:${tagText}`}>
    {mode.tag}
  </span>
</button>

<style>
  .pay-mode {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 14px;
    border-radius: 16px;
    border: 1.5px solid rgb(var(--navy-rgb) / 0.15);
    background: transparent;
    color: var(--navy);
    text-align: left;
    transition: all 0.25s ease;
  }

  .pay-mode[aria-pressed='true'] {
    border-color: var(--navy);
    background: var(--white);
  }

  .pay-mode__radio {
    display: grid;
    flex: none;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid rgb(var(--navy-rgb) / 0.35);
  }

  [aria-pressed='true'] .pay-mode__radio {
    border-color: var(--navy);
  }

  .pay-mode__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--navy);
    transform: scale(0);
    transition: transform 0.25s var(--ease);
  }

  [aria-pressed='true'] .pay-mode__dot {
    transform: scale(1);
  }

  .pay-mode__text {
    flex: 1;
    min-width: 0;
  }

  .pay-mode__title {
    display: block;
    font: 700 14px/1.2 var(--font-sans);
  }

  .pay-mode__sub {
    display: block;
    margin-top: 4px;
    font: 500 12px/1.4 var(--font-sans);
    opacity: 0.72;
  }

  .pay-mode__tag {
    flex: none;
    padding: 6px 9px;
    border-radius: var(--radius-pill);
    font: 800 10px/1 var(--font-sans);
    letter-spacing: 0.5px;
  }
</style>
